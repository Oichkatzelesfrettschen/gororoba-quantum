# Claude Code local session state
.claude/

# Python caches and build artifacts
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
build/
dist/

# Credentials never belong in the tree; the qiskit store lives in ~/.qiskit
qiskit-ibm.json
*.key
*apikey*

# Primary-source PDFs and notes are tracked under docs/.

# Retained proof receipts override workstation-wide *.log ignores.
!docs/evidence/folding_proofs/assumptions.log
!docs/evidence/folding_proofs/homotopy_import_deprecation.log
!docs/evidence/folding_proofs/kernel-check.log
!docs/evidence/folding_proofs/rocq_replay.log
!docs/evidence/simulation-notebook-audit/kaggle_logs/*.log
!results/kaggle/*/output/*.log

# Personal reading copies with external-only redistribution status.
/docs/local_source_cache/

# Workstation-specific guides: this host's hardware, drivers and measured
# limits. docs/notes/kaggle/substrates.md carries the shared routing.
/docs/local/
