b[16] = measure q[6]
barrier q
wait(5) q[0]
X90 q[0]
wait(2) q[0]
X90 q[0]
wait(100) q[0]
wait(5) q[4]
X90 q[4]
wait(2) q[4]
X90 q[4]
wait(100) q[4]
wait(5) q[5]
X90 q[5]
wait(2) q[5]
X90 q[5]
wait(100) q[5]
wait(5) q[6]
X90 q[6]
wait(2) q[6]
X90 q[6]
wait(100) q[6]

barrier q
b[0:9] = measure q
