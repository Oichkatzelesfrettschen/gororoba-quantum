barrier q
wait(1) q[0]
wait(1) q[1]
X90 q[2]
X90 q[3]
wait(1) q[4]
X90 q[5]
wait(1) q[6]
X90 q[7]
barrier q
wait(1) q[0]
wait(1) q[1]
mX90 q[2]
mX90 q[3]
wait(1) q[4]
mX90 q[5]
wait(1) q[6]
mX90 q[7]
barrier q
Y90 q[0]
Y90 q[1]
wait(1) q[2]
wait(1) q[3]
Y90 q[4]
wait(1) q[5]
Y90 q[6]
wait(1) q[7]
barrier q
wait(400) q
barrier q
mY90 q[0]
mY90 q[1]
wait(1) q[2]
wait(1) q[3]
mY90 q[4]
wait(1) q[5]
mY90 q[6]
wait(1) q[7]
barrier q
b = measure q
