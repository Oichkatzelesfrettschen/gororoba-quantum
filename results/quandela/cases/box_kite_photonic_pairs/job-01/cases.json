 "preregistered": {
  "definitions": {
   "constructive pair": "a two-photon block on a kite edge: |perm M| = 2, det M = 0, label coincidence (perm M / 4)^2 = 1/4 for indistinguishable photons against 1/8 for distinguishable ones",
   "suppressed pair": "a two-photon block on a strut or an (l, l^8) pair: perm M = 0, |det M| = 2, label coincidence 0 for indistinguishable photons against 1/8 for distinguishable ones"
  },
  "observable": "per job, the two-click samples (min_detected_photons 2, threshold detectors) by mode pair; the label coincidence is the fraction of two-click samples with one click on each label mode",
  "ideal": "pair_ideal lists P(a, b) for indistinguishable and distinguishable photons; a source of indistinguishability V mixes them as V P_ind + (1 - V) P_dist before threshold conditioning, so an edge block reads (1 + V)/8 and a strut or non-kite block (1 - V)/8 on the label pair",
  "calibration": "the hom job, a balanced splitter on the same two sources, reads P(1, 1) = (1 - V)/2 and fixes V for every pair block of the series",
  "hardware_report": "the edge minus strut label-coincidence difference against V/4 from the hom job, the sign of perm M as the classifier of each block, and every mode-pair frequency against pair_ideal at the fitted V, with Wilson 95% intervals",
  "falsifier": "a strut or non-kite block whose label coincidence exceeds the edge blocks' at the fitted V, or an edge minus strut difference outside V/4 by more than 4.5 standard errors"
 }
}
