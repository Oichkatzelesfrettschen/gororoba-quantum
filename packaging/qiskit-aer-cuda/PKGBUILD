# shellcheck shell=bash
# Maintainer: gororoba-quantum maintainers
pkgname=python-qiskit-aer-cuda
pkgver=0.17.2
pkgrel=1
pkgdesc='Native Qiskit Aer CUDA density-matrix support for NVIDIA Ada GPUs'
arch=('x86_64')
url='https://github.com/Qiskit/qiskit-aer'
license=('Apache-2.0')
depends=(
  'cuda>=13.4' 'cuda<14'
  'gcc-libs' 'openblas'
  'spdlog>=1.17' 'spdlog<1.18' 'fmt>=12.2' 'fmt<13'
  'python>=3.14' 'python<3.15'
  'python-dateutil' 'python-numpy' 'python-psutil' 'python-qiskit'
  'python-scipy' 'python-sympy'
)
makedepends=(
  'cmake' 'ninja' 'python-installer' 'uv'
)
provides=("python-qiskit-aer=$pkgver")
conflicts=('python-qiskit-aer')
# GCC link-time optimization and CUDA device link-time optimization use
# different pipelines. The native Aer build uses its ordinary CUDA pipeline.
options=('!lto' '!debug')
_json_version=3.10.2
source=(
  "qiskit-aer-$pkgver.tar.gz::https://github.com/Qiskit/qiskit-aer/archive/refs/tags/$pkgver.tar.gz"
  "nlohmann-json-$_json_version.tar.gz::https://github.com/nlohmann/json/archive/refs/tags/v$_json_version.tar.gz"
  'check_native_aer.py'
  'setuptools-license-expression.patch'
  'aer-native-toolchain.patch'
  'aer-cccl-type-traits.patch'
  'aer-unused-parameter-annotations.patch'
  'aer-compiler-diagnostics.patch'
  'scikit-build-cmake-cli.patch'
  'build-requirements.txt'
  'https://files.pythonhosted.org/packages/ab/e5/aa1e81b21aea0ce0ba435311837a37d4cb936e7461f9fecac08580073ba9/build-1.6.0-py3-none-any.whl'
  'https://files.pythonhosted.org/packages/12/b3/231ffd4ab1fc9d679809f356cebee130ac7daa00d6d6f3206dd4fd137e9e/distro-1.9.0-py3-none-any.whl'
  'https://files.pythonhosted.org/packages/63/34/ba1c580383c9eada3711951fef0795c80b829a078d72188184bcab9dd527/packaging-26.3-py3-none-any.whl'
  'https://files.pythonhosted.org/packages/33/fd/8762f7ee3e4e4be6d1d846cffb4916dd9bb02b2f800d3603718a0efe494c/pybind11-3.1.0-py3-none-any.whl'
  'https://files.pythonhosted.org/packages/85/11/044d1ae1b4ec0d7af88ee5bc91e081be1022533032b906a7bdabdbb60977/pyproject_hooks-1.3.3-py3-none-any.whl'
  'https://files.pythonhosted.org/packages/47/ef/53c5d9293d1d11ed4e682fdd7f32c776b79ee30f83757395db0d4d0f0276/scikit_build-0.19.1-py3-none-any.whl'
  'https://files.pythonhosted.org/packages/95/9c/c510029fc6ef33a6275cd2c5d3cecd6613dfd6aa401d57c54f1c18852ccf/setuptools-84.0.0-py3-none-any.whl'
  'https://files.pythonhosted.org/packages/2e/29/69cfbb602cd91690c55d38ba9fe53e6a7e76a6fa647bf38f19c138d25449/wheel-0.48.0-py3-none-any.whl'
