From: gororoba-quantum maintainers
Subject: [PATCH] Annotate unused parameters with [[maybe_unused]] for fatal warning policy

Resolves 226 -Werror=unused-parameter diagnostics under GCC 16 and NVCC 13.4
with fatal warning policy (-Wall -Wextra -Werror, --Werror all-warnings).
---
--- a/qiskit_aer/backends/wrappers/aer_controller_binding.hpp
+++ b/qiskit_aer/backends/wrappers/aer_controller_binding.hpp
@@ -57,12 +57,12 @@
 };
 
 template <typename T>
-py::tuple write_value(size_t index, const optional<T> &v) {
+py::tuple write_value(size_t index [[maybe_unused]], const optional<T> &v) {
   return py::make_tuple(v.has_value(), v.value());
 }
 
 template <typename T>
-T write_value(size_t index, const T &v) {
+T write_value(size_t index [[maybe_unused]], const T &v) {
   return v;
 }
 
