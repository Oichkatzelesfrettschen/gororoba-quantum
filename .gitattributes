# Preserve primary-source PDF bytes and keep binary streams out of text diffs.
docs/pdf/*.pdf binary
# Preserve whitespace in raw compiler and kernel-check receipts.
docs/evidence/folding_proofs/*.log -whitespace
# Preserve whitespace in retained exact-version source responses.
docs/evidence/source_rights/*.html -text -whitespace
docs/evidence/source_rights/*.json -text

# Preserve licensed upstream archives as original binary evidence.
docs/source_archives/*.tar.gz binary
docs/source_archives/*.crate binary

# Preserve the imported Ramsey viewer build byte for byte, CRLF included.
results/live/2026-10-13T201757.782152Z/ramsey-xy-trajectory-viewer/data/*.csv -text
results/live/2026-10-13T201757.782152Z/ramsey-xy-trajectory-viewer/data/*.md -text
# Preserve the verbatim bytes of captured upstream Kaggle CLI documentation.
docs/notes/kaggle/cli/*.md -text -whitespace
# Preserve the verbatim bytes of the retained Reality Ripple kernel outputs.
docs/evidence/simulation-notebook-audit/reality_ripple/** -text -whitespace
docs/evidence/simulation-notebook-audit/kaggle_sources/*.txt -text -whitespace
# Preserve sanitizer output hashes, including captured diagnostic whitespace.
docs/evidence/quantum-task-artifact-retention/**/captures/*.txt -text -whitespace
docs/evidence/quantum-task-artifact-retention/**/inventory.json -text
# Generated operator matrices and payloads have a byte-exact replay gate.
docs/evidence/quantum-experiment-conformance/cases/** linguist-generated=true
docs/evidence/quantum-experiment-conformance/local-toolchain.json linguist-generated=true
docs/evidence/quantum-experiment-conformance/runner-cases/** linguist-generated=true
docs/evidence/quantum-experiment-conformance/runner-toolchain.json linguist-generated=true
