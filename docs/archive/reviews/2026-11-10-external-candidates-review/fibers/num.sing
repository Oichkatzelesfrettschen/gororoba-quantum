proc num(string rel, int n, string nm) {
  ring r=32009,(y(1..n)),dp; execute("ideal K="+read(rel)+";"); ideal sK=std(K);
  "RESULT "+nm+" dim "+string(dim(sK))+" deg "+string(mult(sK)); "RESULT "+nm+" numerator2"; print(hilb(sK,2));
}
