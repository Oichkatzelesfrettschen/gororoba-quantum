// Arc family near_e-1_j2_a2_b1_c1_d1_n5: w = W s^2, zeta = Z s^1, rho/sigma coordinates pq (R s^1, S s^1), E = -1 + E1 s^2; order n = 5.
< "docs/evidence/a5-exceptional-fibers/working/build/inputs/p32029-r9115/e8-nm.sing";
matrix Gn[1][21]; int j; for (j=1;j<=21;j++) { Gn[1,j]=jet(G[j],5); }
ring Q=32029,(W,R,S,Z,E,V,s),dp;
number I=9115;
ideal rel=std(ideal(s^6));
number half=1/2; number quarter=1/4;
poly w=W*s^2; poly rho=half*(R*s^1+S*s^1); poly sig=half*(R*s^1-S*s^1); poly zeta=Z*s^1;
poly m=1+w; poly mm=reduce(m*m,rel);
poly minv=1; poly pw=1; int i;
for (i=1;i<=5;i++) { pw=reduce(-pw*w,rel); minv=minv+pw; }
poly u=w+half*w*w; poly qinv=1; pw=1;
for (i=1;i<=5;i++) { pw=reduce(-pw*u,rel); qinv=qinv+pw; }
qinv=half*qinv;
"inverse checks:", reduce(m*minv-1,rel), reduce((mm+1)*qinv-1,rel);
number ie0=1; ie0=ie0/(-1); poly Ev=-1+E*s^2; poly Vv=0; poly pwv=1; poly er=-E*s^2*ie0; int ii;
for (ii=0;ii<=5;ii++) { Vv=Vv+pwv; pwv=reduce(pwv*er,rel); } Vv=Vv*ie0;
poly nuT=(Ev+2+Vv)*quarter; poly omT=(Ev-Vv)*quarter;
poly m2m1q=W*s^2*(2+w);
