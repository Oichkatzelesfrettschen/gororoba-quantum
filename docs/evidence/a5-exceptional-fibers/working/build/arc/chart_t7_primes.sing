LIB "primdec.lib";
// Minimal associated primes of the t7 = 1 chart ideal S7 of the E8-bar -> VB strict transform at p = 32009.
// One prime equal to S7 (S7 is radical: chart_t7.log) proves S7 prime; more than one refutes it.
ring R=32009,(h,t1,t2,t3,t4,t5,t6,t7,t8),dp;
execute("ideal S="+read("strict_transform.txt")+";");
ideal S7=subst(S,t7,1);
ring Q=32009,(h,t1,t2,t3,t4,t5,t6,t8),dp;
ideal S7=imap(R,S7); S7=std(S7);
int t0=rtimer;
list P=minAssChar(S7);
"RESULT minAssChar count",size(P),"seconds",rtimer-t0;
int k; for (k=1;k<=size(P);k++) { ideal Pk=std(P[k]); "RESULT prime",k,"dim",dim(Pk),"equal to S7",size(reduce(Pk,S7))==0; }
quit;
