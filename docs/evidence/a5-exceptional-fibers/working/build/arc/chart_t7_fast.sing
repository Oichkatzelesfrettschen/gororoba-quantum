LIB "normal.lib";
// Chart t7 = 1 of the strict transform of the E8-bar -> VB blowup at p = 32009: normalization with export.
// chart_t7.log proved S7 prime (reduce(radical(S7), S7) = 0), so normal() runs with "isPrim" and skips the radical
// and the equidimensional decomposition; the ring must again have 12 variables and 284 relations.
ring R=32009,(h,t1,t2,t3,t4,t5,t6,t7,t8),dp;
execute("ideal S="+read("strict_transform.txt")+";");
ideal S7=subst(S,t7,1);
ring Q=32009,(h,t1,t2,t3,t4,t5,t6,t8),dp;
ideal S7=imap(R,S7); S7=std(S7);
"RESULT chart t7=1 dim",dim(S7),"size",size(S7);
int t0=rtimer;
list nr=normal(S7,"isPrim");
"RESULT normal list size",size(nr),"seconds",rtimer-t0;
int k; for (k=1;k<=size(nr[1]);k++) { def Rk=nr[1][k]; setring Rk; "RESULT ring",k,"vars",nvars(Rk),"relations",size(norid);
  write(":w chart_t7_ring_"+string(k)+".txt",string(basering)); write(":w chart_t7_norid_"+string(k)+".txt",norid);
  write(":w chart_t7_normap_"+string(k)+".txt",normap); setring Q; kill Rk; }
quit;
