LIB "normal.lib";
ring R=32009,(h,t1,t2,t3,t4,t5,t6,t7,t8),dp;
execute("ideal S="+read("strict_transform.txt")+";");
ideal S1=subst(S,t1,1);
ring Q=32009,(h,t2,t3,t4,t5,t6,t7,t8),dp;
ideal S1=imap(R,S1); S1=std(S1);
list nr=normal(S1);
"RESULT nor2"; nr[2];
def Rn=nr[1][1]; setring Rn;
"RESULT normap"; normap;
"RESULT dim",dim(std(norid)),"mult",mult(std(norid)),"nrel",size(norid);
write(":w norid.txt",string(norid)); write(":w normap.txt",string(normap));
quit;
