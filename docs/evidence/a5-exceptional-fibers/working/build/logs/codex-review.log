   375	        "tools": {"singular": basepoints.schur._singular_version(), "python_flint": basepoints.flint.__version__},
   376	        "producer_sha256": rees._sha256(Path(rees.__file__)),
   377	        "incidences": receipt_rows,
   378	    }
   379	    (directory / "receipt.json").write_text(json.dumps(receipt, indent=2, sort_keys=True) + "\n", encoding="utf-8")
   380	    return receipt
