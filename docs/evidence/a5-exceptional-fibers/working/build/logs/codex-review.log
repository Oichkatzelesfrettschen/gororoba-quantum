   357	def run(prime: int, root: int, slugs: tuple[str, ...], out_root: Path, *, do_compare: bool) -> dict[str, Any]:
   358	    split_prime_root(prime, root)
   359	    base = primary_checkout()
   360	    directory = out_root / f"p{prime}-r{root}"
   361	    directory.mkdir(parents=True, exist_ok=True)
   362	    work = partial(_worker, prime=prime, root=root, cache=out_root / "survivors", base=base, do_compare=do_compare)
   363	    rows = parallel.ordered_map(work, slugs, min_items=1)
   364	    receipt_rows = []
   365	    for row in rows:
   366	        (directory / f"{row['slug']}.sing").write_text(row["header"], encoding="utf-8")
   367	        receipt = {key: value for key, value in row.items() if key != "header"}
   368	        receipt["header_file"] = f"{row['slug']}.sing"
   369	        receipt["header_sha256"] = _sha256_text(row["header"])
   370	        receipt_rows.append(receipt)
   371	    receipt = {
