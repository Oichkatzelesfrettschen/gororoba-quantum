   167	def dense_family(points: list[list[int]], components: list[dict[str, Any]], prime: int,
   168	                 certified: dict[str, dict[str, Any]] | None = None) -> dict[str, Any]:  # fmt: skip
   169	    """Exact containment of supplied limit points in V(K).
   170	
   171	    components: [{"name", "dimension", "generators": [polynomial text in y(i)]}]. A point lies in a component when
   172	    every generator vanishes at it modulo the prime. ``support-equal`` needs, for every component, an entry in
   173	    ``certified`` giving a ``sampled_locus_dimension`` equal to the component dimension and a non-empty ``argument``
   174	    naming the artifact that certifies it; otherwise the verdict is ``support lower bound``. A point outside every
   175	    component refutes the input (status ``refuted``)."""
   176	    parsed = [[drv.parse_poly(g, prime) for g in comp["generators"]] for comp in components]
   177	
   178	    def vanishes(polys: list[dict[drv.Monomial, int]], point: list[int]) -> bool:
   179	        for poly in polys:
   180	            total = 0
   181	            for key, coef in poly.items():
   182	                term = coef
   183	                for name, exp in key:
   184	                    term = term * pow(point[int(name[2:-1]) - 1], exp, prime) % prime
   185	                total = (total + term) % prime
   186	            if total:
   187	                return False
   188	        return True
   189	
   190	    counts = [0] * len(components)
   191	    outside = 0
   192	    for point in points:
   193	        hits = [vanishes(polys, point) for polys in parsed]
   194	        for j, hit in enumerate(hits):
   195	            counts[j] += hit
   196	        outside += not any(hits)
   197	    if outside:
   198	        status = "refuted"
   199	    else:
   200	        certified = certified or {}
   201	        full = all(
   202	            comp["name"] in certified
   203	            and int(certified[comp["name"]].get("sampled_locus_dimension", -1)) == int(comp["dimension"])
   204	            and str(certified[comp["name"]].get("argument", "")).strip() != ""
   205	            for comp in components
   206	        )
   207	        status = "support-equal" if full else "support lower bound"
   208	    return {
   209	        "schema": SCHEMA,
   210	        "certificate": "dense-family",
   211	        "status": status,
   212	        "points": len(points),
   213	        "points_outside_V_K": outside,
   214	        "points_per_component": {c["name"]: counts[j] for j, c in enumerate(components)},
   215	        "prime": prime,
   216	    }
