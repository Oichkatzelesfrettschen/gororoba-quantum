   339	def split_prime_root(prime: int, root: int) -> None:
   340	    _require(prime % 4 == 1, f"{prime} is not 1 mod 4")
   341	    _require(root * root % prime == prime - 1, f"{root} is not a square root of -1 modulo {prime}")
   342	
   343	
   344	def find_split_prime(start: int, step: int = -1) -> tuple[int, int]:
   345	    """Return the first prime p = 1 mod 4 from start in direction step with the smaller square root of -1."""
   346	    p = start
   347	    while True:
   348	        if p % 4 == 1 and all(p % d for d in range(2, int(p**0.5) + 1)):
   349	            g = 2
   350	            while pow(g, (p - 1) // 2, p) != p - 1:
   351	                g += 1
   352	            r = pow(g, (p - 1) // 4, p)
   353	            return p, min(r, p - r)
   354	        p += step
