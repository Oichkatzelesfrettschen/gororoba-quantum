   883	def _self_test(record: dict[str, Any]) -> None:
   884	    rows = {row["incidence"]: row for row in record["incidences"]}
   885	    _require(len(rows) == 18, "nullity-16 incidence count changed")
   886	    for name, row in rows.items():
   887	        if name in PERMITTED_BLOCKED:
   888	            if row["status"] != "completed":
   889	                _require(row["status"] == "blocked_timeout", f"{name} blocked for a reason other than the timeout")
   890	                _require(row.get("blocked_stage") == PERMITTED_BLOCKED[name], f"{name} blocked at an unexpected stage")
   891	            else:
   892	                _require(bool(row["pass"]), f"{name} completed but failed")
   893	        else:
   894	            _require(row["status"] == "completed", f"{name} did not complete")
   895	            _require(bool(row["pass"]), f"{name} failed")
   896	    _require(record["summary"]["completed_count"] >= 8, "fewer than the eight fast rows completed")
   897	    _require(bool(record["mutation_control"]["detected"]), "the generator-deletion mutation survived")
   898	    _require(
   899	        bool(record["pass"]) == (record["summary"]["blocked_count"] == 0),
   900	        "the record pass flag disagrees with its blocked rows",
   901	    )
