   149	
   150	def _run_singular(script: str, stage: str, timeout_seconds: int = SINGULAR_TIMEOUT_SECONDS) -> SingularOutcome:
   151	    started = time.monotonic_ns()
   152	    if signal.getsignal(signal.SIGTERM) is signal.SIG_DFL:
   153	        signal.signal(signal.SIGTERM, _exit_on_term)
   154	    command = (
   155	        "/usr/bin/time",
   156	        "-v",
   157	        "systemd-run",
   158	        "--user",
   159	        "--scope",
   160	        "--quiet",
   161	        "-p",
   162	        f"MemoryMax={SINGULAR_MEMORY_LIMIT}",
   163	        "-p",
   164	        "MemorySwapMax=0",
   165	        "Singular",
   166	        "-q",
   167	        "--no-warn",
   168	    )
   169	    process = subprocess.Popen(  # noqa: S603
   170	        command,
   171	        stdin=subprocess.PIPE,
   172	        stdout=subprocess.PIPE,
   173	        stderr=subprocess.PIPE,
   174	        text=True,
   175	        start_new_session=True,
   176	    )
   177	    try:
   178	        stdout, stderr = process.communicate(script, timeout=timeout_seconds)
   179	    except subprocess.TimeoutExpired:
   180	        os.killpg(process.pid, signal.SIGKILL)
   181	        stdout, stderr = process.communicate()
   182	        return SingularOutcome(
   183	            "blocked_timeout",
   184	            stage,
   185	            {},
   186	            time.monotonic_ns() - started,
   187	            _peak_rss(stderr),
   188	            f"Singular exceeded the {timeout_seconds}-second timeout",
   189	        )
   190	    finally:
   191	        # start_new_session detaches Singular from the caller's signals, so every exit path kills its session.
   192	        if process.poll() is None:
   193	            os.killpg(process.pid, signal.SIGKILL)
   194	    elapsed = time.monotonic_ns() - started
   195	    results = _parse_singular(stdout, stderr, process.returncode)
   196	    if "singular_error" in results:
   197	        status = "blocked_resource" if process.returncode in (9, 137) else "blocked_error"
   198	        return SingularOutcome(status, stage, results, elapsed, _peak_rss(stderr), results["singular_error"])
   199	    return SingularOutcome("completed", stage, results, elapsed, _peak_rss(stderr), None)
