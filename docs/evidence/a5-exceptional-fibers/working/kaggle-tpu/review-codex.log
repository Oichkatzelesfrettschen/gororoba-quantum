   158	def run_singular(
   159	    script: str,
   160	    stage: str,
   161	    cwd: Path,
   162	    memory_gib: int = DEFAULT_MEMORY_GIB,
   163	    timeout: int = DEFAULT_TIMEOUT_SECONDS,
   164	) -> Outcome:
   165	    """Run one script in a MemoryMax-capped transient unit; systemd-run reports the unit's memory peak on stderr."""
   166	    cwd.mkdir(parents=True, exist_ok=True)
   167	    (cwd / f"{stage}.sing").write_text(script)
   168	    command = [
   169	        "systemd-run", "--user", "--wait", "--pipe", "--same-dir",
   170	        "-p", f"MemoryMax={memory_gib}G", "-p", "MemorySwapMax=0",
   171	        "-E", "MALLOC_ARENA_MAX=2",
   172	        "timeout", "-k", "10", str(timeout),
   173	        "Singular", "-q", "--no-warn", f"{stage}.sing",
   174	    ]  # fmt: skip
   175	    started = time.monotonic()
   176	    proc = subprocess.run(command, cwd=cwd, capture_output=True, text=True, check=False)  # noqa: S603
   177	    seconds = time.monotonic() - started
   178	    (cwd / f"{stage}.log").write_text(proc.stdout + "\n--- stderr ---\n" + proc.stderr)
   179	    results = {m.group(1): m.group(2).strip() for m in re.finditer(r"^RESULT (\S+) ?(.*)$", proc.stdout, re.M)}
   180	    errors = [ln for ln in (proc.stdout + proc.stderr).splitlines() if ln.startswith("?")]
   181	    error = "\n".join(errors) if errors else (f"exit status {proc.returncode}" if proc.returncode else None)
   182	    return Outcome(stage, seconds, _peak(proc.stderr), results, proc.returncode, error)
