    56	def meminfo(key):
    57	    for line in Path("/proc/meminfo").read_text().splitlines():
    58	        if line.startswith(key + ":"):
    59	            return int(line.split()[1])
    60	    return -1
    61	
    62	
    63	def rss(pid):
    64	    try:
    65	        for line in Path(f"/proc/{pid}/status").read_text().splitlines():
    66	            if line.startswith("VmRSS:"):
    67	                return int(line.split()[1])
    68	    except OSError:
    69	        return -1
    70	    return -1
