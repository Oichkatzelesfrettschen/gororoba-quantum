    73	def main():
    74	    started = time.time()
    75	    subprocess.run([sys.executable, "-m", "pip", "install", "--quiet", WHEEL], check=True)
    76	    candidates = [Path(sysconfig.get_paths()[k]) / "sage_wheels/bin/msolve" for k in ("purelib", "platlib")]
    77	    binary = next(p for p in candidates if p.exists())
    78	    binary.chmod(0o755)
    79	    (OUT / "input.ms").write_text(INPUT + "\n")
    80	    threads = os.cpu_count() or 4
    81	    command = [str(binary), "-v", "2", "-t", str(threads), "-e", "1", "-g", "2",
    82	               "-f", str(OUT / "input.ms"), "-o", str(OUT / "gb.out")]
    83	    log = open(OUT / "msolve.log", "w")
    84	    proc = subprocess.Popen(["timeout", str(SOLVER_SECONDS)] + command, stdout=log, stderr=subprocess.STDOUT)
    85	    samples = open(OUT / "samples.tsv", "w")
    86	    samples.write("elapsed_s\tsolver_rss_kib\tmem_available_kib\n")
    87	    stop = threading.Event()
    88	
    89	    def sample():
    90	        while not stop.is_set():
    91	            child = subprocess.run(["pgrep", "-P", str(proc.pid)], capture_output=True, text=True).stdout.split()
    92	            kib = max([rss(int(c)) for c in child] + [rss(proc.pid)])
    93	            samples.write(f"{time.time() - started:.0f}\t{kib}\t{meminfo('MemAvailable')}\n")
    94	            samples.flush()
    95	            stop.wait(30)
    96	
    97	    sampler = threading.Thread(target=sample, daemon=True)
    98	    sampler.start()
    99	    code = proc.wait()
   100	    stop.set()
   101	    sampler.join()
   102	    log.close()
   103	    gb = OUT / "gb.out"
