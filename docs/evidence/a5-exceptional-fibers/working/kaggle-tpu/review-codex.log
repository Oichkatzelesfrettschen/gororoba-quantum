   153	def _peak(stderr: str) -> int | None:
   154	    hit = re.search(r"Memory peak:\s*([\d.]+)([BKMGT])", stderr)
   155	    return int(float(hit.group(1)) * _UNITS[hit.group(2)]) if hit else None
   156	
