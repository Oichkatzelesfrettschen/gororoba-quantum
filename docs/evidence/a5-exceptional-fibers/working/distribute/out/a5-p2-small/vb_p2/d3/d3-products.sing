4431*t5*t6^2-8862*t2*t3*t7+4431*t2*t4*t7-4431*t1*t5*t7+4431*t1*t6*t7-4431*t3*t7*t8-13799*t4*t7*t8-13799*t6*t8^2-4431*t1*t3+4431*t1*t4-4431*t2*t5+4937*t4*t7-13799*t5*t8-4431*t6*t8-9368*t5+9368*t6,-2*t2*t4*t5*t7-2*t2*t3*t6*t7-4*t2*t5*t6*t8+4*t1*t3*t5+2*t2*t5^2+4*t1*t4*t6+4*t2*t5*t6+2*t2*t6^2-4*t1*t2*t7+4*t4*t5*t7+4*t3*t6*t7+4*t2^2*t8+8*t5*t6*t8-2*t1*t7*t8+2*t2*t8^2-4*t2^2-4*t5^2+8*t5*t6-4*t6^2+10*t1*t7-20*t2*t8-4*t8^2+10*t2+20*t8;
option(redSB); system("--ticks-per-sec",1000); int tm0=rtimer;
ideal sJ=std(J); int n=ncols(G); int i; int k; int f; int e; int c;
for(i=1;i<=n;i++){G[i]=reduce(G[i],sJ);}
ring Y=32029,(y(1..n)),dp;
execute("ideal K="+read("previous-relations.rel")+";");
ideal sK=std(K); ideal kb=kbase(sK,3); c=ncols(kb);
setring r; ideal P; poly q; intvec ev;
for(i=1;i<=c;i++){ setring Y; ev=leadexp(kb[i]); setring r; q=1;
  for(f=1;f<=n;f++){ for(e=1;e<=ev[f];e++){ q=reduce(q*G[f],sJ); } } P[i]=q; }
"RESULT generators",n; "RESULT targets",c; "RESULT products_ms",rtimer-tm0;
write(":w gens.txt",G); setring Y; write(":w targets.txt",kb); setring r;
int tm1=rtimer;
ideal Q=sJ; for(k=1;k<=nvars(basering);k++){for(i=1;i<=c;i++){Q=Q,var(k)*P[i];}}
ideal sQ=std(Q); "RESULT std_ms",rtimer-tm1,"size",size(sQ);
write(":w sq.txt",sQ);
int tm2=rtimer; ideal N=reduce(P,sQ); write(":w nf.txt",N); "RESULT reduce_ms",rtimer-tm2;
quit;
