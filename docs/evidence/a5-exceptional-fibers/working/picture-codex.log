     1	#!/bin/sh
     2	# Hold a running `timeout` process stopped so its alarm stays pending, and resume it at a new deadline or as soon
     3	# as its child exits. A stopped timeout cannot reap its child, which then stays a zombie that kill -0 still finds,
     4	# so the child's state comes from /proc. Exit 0 child ended, 2 new deadline reached.
     5	# Usage: extend-timeout.sh TIMEOUT_PID CHILD_PID DEADLINE_EPOCH
     6	set -eu
     7	tpid=$1; cpid=$2; deadline=$3; child=
     8	resume() { kill -CONT "$tpid" 2>/dev/null || :; [ -n "$child" ] && kill "$child" 2>/dev/null || :; }
     9	trap resume EXIT
    10	trap 'exit 130' INT TERM HUP
    11	kill -STOP "$tpid"
    12	while :; do
    13	  state=$(awk '{print $3}' "/proc/$cpid/stat" 2>/dev/null || echo X)
    14	  case "$state" in Z|X) echo "child $cpid ended; timeout resumed"; exit 0;; esac
    15	  if [ "$(date +%s)" -ge "$deadline" ]; then echo "deadline reached; timeout resumed and ends the child"; exit 2; fi
    16	  sleep 20 & child=$!; wait "$child"; child=
    17	done

