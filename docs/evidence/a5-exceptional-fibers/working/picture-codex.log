   224	**Concrete reusable scripts**
   225	
   226	For method A, load the existing header through the `ideal G=...;` line, changing `ds` to `dp`. Use five header lines for X, E8-bar, and W8, and three for Iso. Set `fiberDegree` and `previousRelationFile` before this body; use an empty string for the initial raw calculation.
   227	
   228	```singular
   229	LIB "matrix.lib";
   230	option(redSB);
   231	
   232	int generatorCount=ncols(G);
   233	int sourceVariableCount=nvars(basering);
   234	def sourceRing=basering;
   235	ideal sourceBasis=std(J);
   236	
   237	int generatorIndex;
   238	for(generatorIndex=1;generatorIndex<=generatorCount;generatorIndex++)
   239	{
   240	  G[generatorIndex]=reduce(G[generatorIndex],sourceBasis);
   241	}
   242	
   243	execute("ring targetRing=32009,(y(1.."+string(generatorCount)+")),dp;");
   244	ideal previousRelations;
   245	if(size(previousRelationFile)>0)
   246	{
   247	  execute("previousRelations="+read(previousRelationFile)+";");
   248	}
   249	ideal candidateMonomials=kbase(std(previousRelations),fiberDegree);
   250	int candidateCount=ncols(candidateMonomials);
   251	
   252	setring sourceRing;
   253	ideal products;
   254	int productIndex;
   255	int factorIndex;
   256	int factorPower;
   257	intvec exponentVector;
   258	poly currentProduct;
   259	
   260	for(productIndex=1;productIndex<=candidateCount;productIndex++)
   261	{
   262	  setring targetRing;
   263	  exponentVector=leadexp(candidateMonomials[productIndex]);
   264	  setring sourceRing;
   265	  currentProduct=1;
   266	  for(factorIndex=1;factorIndex<=generatorCount;factorIndex++)
   267	  {
   268	    for(factorPower=1;factorPower<=exponentVector[factorIndex];factorPower++)
   269	    {
   270	      currentProduct=reduce(currentProduct*G[factorIndex],sourceBasis);
   271	    }
   272	  }
   273	  products[productIndex]=currentProduct;
   274	}
   275	
   276	ideal denominatorBasis=std(sourceBasis+maxideal(1)*products);
   277	vector normalVector;
   278	poly variableProduct=1;
   279	for(factorIndex=1;factorIndex<=sourceVariableCount;factorIndex++)
   280	{
   281	  variableProduct=variableProduct*var(factorIndex);
   282	}
   283	for(productIndex=1;productIndex<=candidateCount;productIndex++)
   284	{
   285	  normalVector=normalVector
   286	    +reduce(products[productIndex],denominatorBasis)*gen(productIndex);
   287	}
   288	
   289	matrix rawCoefficients,coefficientMonomials;
   290	coef(normalVector,variableProduct,rawCoefficients,coefficientMonomials);
   291	matrix coefficients[candidateCount][ncols(rawCoefficients)];
   292	int coefficientRow;
   293	int coefficientColumn;
   294	for(coefficientRow=1;coefficientRow<=nrows(rawCoefficients);coefficientRow++)
   295	{
   296	  for(coefficientColumn=1;coefficientColumn<=ncols(rawCoefficients);coefficientColumn++)
   297	  {
   298	    coefficients[coefficientRow,coefficientColumn]
   299	      =rawCoefficients[coefficientRow,coefficientColumn];
   300	  }
   301	}
   302	int fiberRank=rank(coefficients);
   303	"RESULT degree",fiberDegree;
   304	"RESULT h",fiberRank;
   305	matrix relationVectors=syz(transpose(coefficients));
   306	
   307	setring targetRing;
   308	matrix targetRelations=imap(sourceRing,relationVectors);
   309	ideal newRelations;
   310	int relationIndex;
   311	poly relationPolynomial;
   312	for(relationIndex=1;relationIndex<=ncols(targetRelations);relationIndex++)
   313	{
   314	  relationPolynomial=0;
   315	  for(productIndex=1;productIndex<=candidateCount;productIndex++)
   316	  {
   317	    relationPolynomial=relationPolynomial
   318	      +targetRelations[productIndex,relationIndex]*candidateMonomials[productIndex];
   319	  }
   320	  newRelations[relationIndex]=relationPolynomial;
   321	}
   322	ideal cumulativeRelations=std(previousRelations+newRelations);
   323	write(":w fiber-degree-"+string(fiberDegree)+".rel",cumulativeRelations);
   324	quit;
   325	```
   326	
   327	The vector coefficient interface retains product-slot identities, including zero normal forms. The installed manual documents that interface and its coefficient/monomial matrices. [Singular coef manual:73–100](/usr/share/doc/singular/sing_224.htm:73)
