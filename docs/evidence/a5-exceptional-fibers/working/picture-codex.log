   329	For method B, append this body to the same global header:
   330	
   331	```singular
   332	LIB "elim.lib";
   333	LIB "primdec.lib";
   334	option(redSB);
   335	
   336	int sourceVariableCount=nvars(basering);
   337	int generatorCount=ncols(G);
   338	string sourceNames=varstr(basering);
   339	def sourceRing=basering;
   340	
   341	execute("ring reesRing=32009,("+sourceNames
   342	  +",y(1.."+string(generatorCount)+")),dp;");
   343	ideal sourceRelations=std(imap(sourceRing,J));
   344	ideal sourceGenerators=imap(sourceRing,G);
   345	
   346	int pivotIndex=1;
   347	poly pivotGenerator=sourceGenerators[pivotIndex];
   348	ideal pivotColon=quotient(sourceRelations,ideal(pivotGenerator));
   349	if(size(reduce(pivotColon,sourceRelations))!=0)
   350	{
   351	  ERROR("the chosen pivot is a zero divisor modulo J");
   352	}
   353	
   354	ideal equations=sourceRelations;
   355	ideal baseMaximal;
   356	ideal targetMaximal;
   357	int variableIndex;
   358	for(variableIndex=1;variableIndex<=sourceVariableCount;variableIndex++)
   359	{
   360	  baseMaximal=baseMaximal,var(variableIndex);
   361	}
   362	for(variableIndex=1;variableIndex<=generatorCount;variableIndex++)
   363	{
   364	  targetMaximal=targetMaximal,var(sourceVariableCount+variableIndex);
   365	  if(variableIndex!=pivotIndex)
   366	  {
   367	    equations=equations,
   368	      pivotGenerator*var(sourceVariableCount+variableIndex)
   369	      -sourceGenerators[variableIndex]*var(sourceVariableCount+pivotIndex);
   370	  }
   371	}
   372	
   373	ideal reesIdeal=sat(equations,ideal(pivotGenerator));
   374	ideal specialFiber=std(reesIdeal+baseMaximal);
   375	"RESULT fiber_projective_dimension",dim(specialFiber)-1;
   376	"RESULT fiber_degree",mult(specialFiber);
   377	"RESULT fiber_hilbert_numerator",hilb(specialFiber,1);
   378	write(":w special-fiber.sing",specialFiber);
   379	
   380	ideal projectiveFiber=sat(specialFiber,targetMaximal);
   381	write(":w projective-fiber.sing",projectiveFiber);
   382	list components=minAssChar(projectiveFiber,0);
   383	"RESULT component_count",size(components);
   384	for(variableIndex=1;variableIndex<=size(components);variableIndex++)
   385	{
   386	  ideal componentBasis=std(components[variableIndex]);
   387	  "RESULT component",variableIndex,dim(componentBasis)-1,mult(componentBasis);
   388	  write(":w component-"+string(variableIndex)+".sing",componentBasis);
   389	  kill componentBasis;
   390	}
   391	quit;
   392	```
