docs/local/a5-failed-runs/probes/rank_nf.py
     1 """Rank over F_p of the k-span of polynomials written by Singular `write` (one per comma-separated entry)."""
     2 import re
     3 import sys
     4 
     5 import flint
     6 
     7 p = int(sys.argv[2])
     8 txt = open(sys.argv[1]).read().replace("\n", "")
     9 polys = [s for s in txt.split(",") if s.strip()]
    10 term = re.compile(r"([+-]?)(\d*)\*?((?:[a-z]\w*(?:\^\d+)?\*?)*)")
    11 
    12 
    13 def parse(s):
    14     out = {}
    15     for m in re.finditer(r"([+-]?)([^+-]+)", s.replace("^-", "^m")):
    16         sign, body = m.groups()
    17         coef, mon = 1, []
    18         for f in body.split("*"):
    19             if f.isdigit():
    20                 coef *= int(f)
    21             elif f:
    22                 v, _, e = f.partition("^")
    23                 mon.append((v, int(e) if e else 1))
    24         out_key = tuple(sorted(mon))
    25         out[out_key] = (out.get(out_key, 0) + (-coef if sign == "-" else coef)) % p
    26     return out
    27 
    28 
    29 rows = [parse(s) for s in polys]
    30 cols = {}
    31 for r in rows:
    32     for k in r:
    33         cols.setdefault(k, len(cols))
    34 M = flint.nmod_mat(len(rows), len(cols), p)
    35 for i, r in enumerate(rows):
    36     for k, v in r.items():
    37         M[i, cols[k]] = v
    38 print("polys", len(rows), "monomials", len(cols), "rank", M.rank())

docs/local/a5-failed-runs/probes/relations_nf.py
     1 """Left kernel over F_p of the normal forms written by Singular: each kernel vector c gives the fiber relation sum c_b m_b.
     2 
     3 Usage: relations_nf.py NF_FILE P MONOMIAL_FILE OUT_FILE
     4 MONOMIAL_FILE lists the target monomials m_b (comma-separated, Singular syntax), in the order of the normal forms.
     5 OUT_FILE receives the relations as one comma-separated Singular ideal body.
     6 """
     7 
     8 import re
     9 import sys
    10 
    11 import flint
    12 
    13 nf_path, p, mon_path, out_path = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4]
    14 
    15 
    16 def parse(s):
    17     out = {}
    18     for m in re.finditer(r"([+-]?)([^+-]+)", s):
    19         sign, body = m.groups()
    20         coef, mon = 1, []
    21         for f in body.split("*"):
    22             if f.isdigit():
    23                 coef *= int(f)
    24             elif f:
    25                 v, _, e = f.partition("^")
    26                 mon.append((v, int(e) if e else 1))
    27         key = tuple(sorted(mon))
    28         out[key] = (out.get(key, 0) + (-coef if sign == "-" else coef)) % p
    29     return out
    30 
    31 
    32 rows = [parse(s) for s in open(nf_path).read().replace("\n", "").split(",")]
    33 mons = [s.strip() for s in open(mon_path).read().replace("\n", "").split(",")]
    34 if len(mons) != len(rows):
    35     raise ValueError(f"{len(rows)} normal forms but {len(mons)} monomials")
    36 cols = {}
    37 for r in rows:
    38     for k in r:
    39         cols.setdefault(k, len(cols))
    40 # Left kernel of R (rows x cols) is the right kernel of R^T.
    41 t = flint.nmod_mat(len(cols), len(rows), p)
    42 for i, r in enumerate(rows):
    43     for k, v in r.items():
    44         t[cols[k], i] = v
    45 kernel, nullity = t.nullspace()
    46 rels = []
    47 for j in range(nullity):
    48     terms = [f"{int(kernel[i, j])}*{mons[i]}" for i in range(len(rows)) if int(kernel[i, j])]
    49     rels.append("+".join(terms))
    50 open(out_path, "w").write(",\n".join(rels))
    51 print("normal_forms", len(rows), "rank", len(rows) - nullity, "relations", nullity)

