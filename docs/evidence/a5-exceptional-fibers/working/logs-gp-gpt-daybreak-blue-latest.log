   205	def _emit_one(slug: str, *, prime: int, root: int, cache: Path) -> dict[str, Any]:
   206	    spec = SPEC_BY_SLUG[slug]
   207	    if spec.route == "nakayama":
   208	        return _emit_nakayama(spec, prime=prime, root=root)
   209	    task = _task(spec.incidence)
   210	    data = basepoints._schur_coordinates(rees._base_task(task))
   211	    candidates = _candidates(task, data, cache)
   212	    script = rees._phase_one_script(root, task, data, tuple(candidates), prime=prime, embedding=False)
   213	    outcome = rees._run_singular(script, "fiber_input_phase_one", SINGULAR_TIMEOUT_SECONDS)
   214	    _require(outcome.status == "completed", f"{spec.incidence} phase one {outcome.status}: {outcome.diagnostic}")
   215	    return _finish(spec, outcome, prime, root, len(candidates))
