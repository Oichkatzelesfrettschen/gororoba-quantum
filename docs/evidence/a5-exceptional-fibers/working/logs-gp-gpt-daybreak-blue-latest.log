   183	def _finish(spec: Spec, outcome: Any, prime: int, root: int, candidate_count: int) -> dict[str, Any]:
   184	    results = outcome.results
   185	    reduced_j = [results[f"reduced_j_{i}"] for i in range(1, int(results["reduced_j_count"]) + 1)]
   186	    reduced_g = [results[f"reduced_g_{i}"] for i in range(1, int(results["reduced_g_count"]) + 1)]
   187	    variables = _variables(reduced_j + reduced_g)
   188	    selected = [int(results[f"selected_{i}"]) for i in range(1, int(results["selected_count"]) + 1)]
   189	    eliminated = [results[f"eliminated_{i}"] for i in range(1, int(results["eliminated_count"]) + 1)]
   190	    return {
   191	        "slug": spec.slug,
   192	        "incidence": spec.incidence,
   193	        "route": spec.route,
   194	        "header": header_text(prime, root, variables, reduced_j, reduced_g),
   195	        "variables": variables,
   196	        "candidate_count": candidate_count,
   197	        "selected_indices_one_based": selected,
   198	        "eliminated": eliminated,
   199	        "generator_count": len(reduced_g),
   200	        "wall_seconds": round(outcome.wall_nanoseconds / 1e9, 1),
   201	        "peak_rss_kib": outcome.peak_rss_kib,
   202	    }
