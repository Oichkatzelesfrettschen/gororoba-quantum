   168	def dense_family(points: list[list[int]], components: list[dict[str, Any]], prime: int) -> dict[str, Any]:
   169	    """Exact containment of supplied limit points in V(K).
   170	
   171	    components: [{"name", "dimension", "generators": [polynomial text in y(i)]}]. A point lies in a component when
   172	    every generator vanishes at it modulo the prime. Containment of finitely many points bounds the limit support from
   173	    below only, so the verdict is ``support lower bound``; ``support-equal`` needs a verified dimension of the sampled
   174	    locus in every component, which this function does not compute. A point outside every component refutes the
   175	    input (status ``refuted``)."""
   176	    parsed = [[drv.parse_poly(g, prime) for g in comp["generators"]] for comp in components]
   177	
   178	    def vanishes(polys: list[dict[drv.Monomial, int]], point: list[int]) -> bool:
   179	        for poly in polys:
   180	            total = 0
   181	            for key, coef in poly.items():
   182	                term = coef
   183	                for name, exp in key:
   184	                    term = term * pow(point[int(name[2:-1]) - 1], exp, prime) % prime
   185	                total = (total + term) % prime
   186	            if total:
   187	                return False
   188	        return True
