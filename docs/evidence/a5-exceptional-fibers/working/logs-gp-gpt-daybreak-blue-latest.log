   206	@dataclass(frozen=True)
   207	class Header:
   208	    text: str
   209	    ring: str
   210	    prime: int
   211	    root: str | None
   212	
   213	
   214	def read_header(path: Path, prime: int) -> Header:
   215	    text = path.read_text()
   216	    ring = re.search(r"^\s*ring\s+(\w+)\s*=\s*(\d+)\s*,\s*\([^)]*\)\s*,\s*dp\s*;", text, re.M)
   217	    _require(ring is not None, "header lacks a `ring NAME=p,(vars),dp;` line")
   218	    if not (ring is not None):
   219	        raise RuntimeError("missing parsed value: ring is not None")
   220	    _require(int(ring.group(2)) == prime, f"header prime {ring.group(2)} differs from --prime {prime}")
   221	    for name in ("J", "G"):
   222	        _require(re.search(rf"^\s*ideal\s+{name}\s*=", text, re.M) is not None, f"header lacks `ideal {name}=`")
   223	    root = re.search(r"number\s+I\s*=\s*([^;]+);", text)
   224	    return Header(text.rstrip("\n") + "\n", ring.group(1), prime, root.group(1).strip() if root else None)
   225	
   226	
   227	def products_block(header: Header, degree: int, previous: str | None) -> str:
   228	    """Singular code defining sJ, G (reduced), the target list kb and the products P in the header ring."""
   229	    ring = header.ring
   230	    previous_line = f'execute("ideal K="+read("{previous}")+";");' if degree >= 3 and previous else "ideal K=0;"
   231	    return f"""option(redSB); system("--ticks-per-sec",1000); int tm0=rtimer;
   232	ideal sJ=std(J); int n=ncols(G); int i; int k; int f; int e; int c;
   233	for(i=1;i<=n;i++){{G[i]=reduce(G[i],sJ);}}
   234	ring Y={header.prime},(y(1..n)),dp;
   235	{previous_line}
   236	ideal sK=std(K); ideal kb=kbase(sK,{degree}); c=ncols(kb);
   237	setring {ring}; ideal P; poly q; intvec ev;
   238	for(i=1;i<=c;i++){{ setring Y; ev=leadexp(kb[i]); setring {ring}; q=1;
   239	  for(f=1;f<=n;f++){{ for(e=1;e<=ev[f];e++){{ q=reduce(q*G[f],sJ); }} }} P[i]=q; }}
   240	"RESULT generators",n; "RESULT targets",c; "RESULT products_ms",rtimer-tm0;
   241	"""
   242	
   243	
   244	def stage_products(header: Header, degree: int, previous: str | None) -> str:
   245	    return (
   246	        header.text
   247	        + products_block(header, degree, previous)
