   199	        "schema": SCHEMA,
   200	        "certificate": "dense-family",
   201	        "status": status,
   202	        "points": len(points),
   203	        "points_outside_V_K": outside,
   204	        "points_per_component": {c["name"]: counts[j] for j, c in enumerate(components)},
   205	        "prime": prime,
   206	    }
