   281	def _phase_one_script(
   282	    root: int | None,
   283	    task: RowTask,
   284	    data: basepoints.PolynomialData,
   285	    candidate_indices: tuple[int, ...],
   286	) -> str:
   287	    # I/(mI+J) is annihilated by m, and reduction modulo the standard basis of J+mF is linear with kernel J+mF, so a
   288	    # candidate joins the Nakayama generators exactly when its normal-form coefficient row raises the prefix rank.
   289	    candidate_text = _coordinate_text(data, candidate_indices)
   290	    variable_product = "*".join(data.slice_names)
   291	    candidate_mapping = ",".join(map(str, candidate_indices))
   292	    coordinate_count = len(data.coordinates)
   293	    return "\n".join(
   294	        (
   295	            *_local_germ_lines(root, task, data),
   296	            'LIB "presolve.lib";',
   297	            'LIB "matrix.lib";',
   298	            f"ideal FullF={_coordinate_text(data)};",
   299	            f"ideal F={candidate_text};",
   300	            f"intvec CandidateOriginal={candidate_mapping};",
   301	            "ideal maximal=maxideal(1);ideal SJ=std(J+maximal*F);ideal CandidateForms=reduce(F,SJ);",
   302	            f"matrix CandidateCoefficients=coef(CandidateForms,{variable_product});",
   303	            'if(nrows(CandidateCoefficients)!=ncols(F)+1){ERROR("coefficient rows do not match the candidates");}',
   304	            "intvec CoefficientColumns=1..ncols(CandidateCoefficients);",
   305	            "ideal NormalForms,G;intvec Selected;int selectedCount=0;int prefixRank;",
   306	            "for(int i=1;i<=ncols(F);i++){intvec PrefixRows=2..i+1;"
   307	            "prefixRank=rank(submat(CandidateCoefficients,PrefixRows,CoefficientColumns));kill PrefixRows;"
   308	            "if(prefixRank>selectedCount){selectedCount++;NormalForms[selectedCount]=CandidateForms[i];"
   309	            "G[selectedCount]=F[i];Selected[selectedCount]=CandidateOriginal[i];}}",
   310	            "list EP=elimpart(J);map reducedMap=s,EP[5];",
   311	            "ideal ReducedJ=std(reducedMap(J));",
   312	            "ideal ReducedFullF=reduce(reducedMap(FullF),ReducedJ);",
   313	            "ideal ReducedMaximal=simplify(reduce(reducedMap(maximal),ReducedJ),2);",
   314	            "ideal ReducedG=simplify(reduce(reducedMap(G),ReducedJ),2);",
   315	            "ideal Prefix=ReducedJ+ReducedMaximal*ReducedFullF;int generatorOffset=size(Prefix);",
   316	            "ideal LiftBasis=Prefix+ReducedG;",
   317	            f"matrix LiftMatrix=lift(LiftBasis,ReducedFullF);matrix A[selectedCount][{coordinate_count}];",
   318	            f"for(int i=1;i<=selectedCount;i++){{for(int j=1;j<={coordinate_count};j++){{"
   319	            "A[i,j]=jet(LiftMatrix[generatorOffset+i,j],0);}}",
   320	            '"RESULT germ_dimension",dim(J);',
   321	            '"RESULT germ_component_count",componentCount;',
   322	            '"RESULT candidate_count",ncols(F);',
   323	            '"RESULT selected_count",selectedCount;',
   324	            'for(int i=1;i<=selectedCount;i++){"RESULT selected_"+string(i),Selected[i];}',
   325	            "int eliminatedCount=0;for(int i=1;i<=size(EP[2]);i++){if(EP[2][i]!=0){eliminatedCount++;"
   326	            '"RESULT eliminated_"+string(eliminatedCount),EP[2][i];}}',
   327	            '"RESULT eliminated_count",eliminatedCount;',
   328	            '"RESULT reduced_j_count",size(ReducedJ);',
   329	            'for(int i=1;i<=size(ReducedJ);i++){"RESULT reduced_j_"+string(i),ReducedJ[i];}',
   330	            '"RESULT reduced_g_count",size(ReducedG);',
   331	            'for(int i=1;i<=size(ReducedG);i++){"RESULT reduced_g_"+string(i),ReducedG[i];}',
   332	            '"RESULT embedding_rank",rank(A);',
   333	            f"for(int i=1;i<=selectedCount;i++){{for(int j=1;j<={coordinate_count};j++){{"
