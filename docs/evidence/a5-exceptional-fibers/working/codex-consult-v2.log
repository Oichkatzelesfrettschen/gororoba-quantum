     1	#!/bin/sh
     2	# Run one job under an address-space cap with a 30 s RSS and MemAvailable trace; writes NAME.exit when done.
     3	# Usage: remote-run.sh NAME AS_BYTES COMMAND [ARGS...]
     4	set -eu
     5	name=$1; as=$2; shift 2
     6	cd "$HOME/work"
     7	date -u +%s > "$name.started"
     8	prlimit --as="$as" "$@" > "$name.log" 2>&1 < /dev/null & pid=$!
     9	(
    10	  printf 'elapsed_s\trss_kib\tmem_available_kib\n'
    11	  start=$(cat "$name.started")
    12	  while kill -0 "$pid" 2>/dev/null; do
    13	    rss=$(awk '/^VmRSS:/ {print $2}' "/proc/$pid/status" 2>/dev/null || echo 0)
    14	    avail=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)
    15	    printf '%s\t%s\t%s\n' $(( $(date -u +%s) - start )) "${rss:-0}" "$avail"
    16	    sleep 30
    17	  done
    18	) > "$name.samples.tsv" &
    19	status=0; wait "$pid" || status=$?
    20	echo "$status" > "$name.exit"
