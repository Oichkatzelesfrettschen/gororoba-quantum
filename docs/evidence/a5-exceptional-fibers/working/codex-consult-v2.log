    20	WHEEL = "passagemath-singular==10.8.13"
    21	SOLVER_SECONDS = 41000
    22	OUT = Path("/kaggle/working")
    23	
    24	
    25	def meminfo(key):
    26	    for line in Path("/proc/meminfo").read_text().splitlines():
    27	        if line.startswith(key + ":"):
    28	            return int(line.split()[1])
    29	    return -1
    30	
    31	
    32	def rss(pid):
    33	    try:
    34	        for line in Path(f"/proc/{pid}/status").read_text().splitlines():
    35	            if line.startswith("VmRSS:"):
    36	                return int(line.split()[1])
    37	    except OSError:
    38	        return -1
    39	    return -1
    40	
    41	
    42	def capped(nbytes):
    43	    def apply():
    44	        resource.setrlimit(resource.RLIMIT_AS, (nbytes, nbytes))
    45	
    46	    return apply
    47	
    48	
    49	def main():
    50	    started = time.time()
    51	    subprocess.run([sys.executable, "-m", "pip", "install", "--quiet", WHEEL], check=True)
    52	    candidates = [Path(sysconfig.get_paths()[k]) / "sage_wheels/bin/Singular" for k in ("purelib", "platlib")]
    53	    binary = next(p for p in candidates if p.exists())
    54	    binary.chmod(0o755)
    55	    procs = {}
    56	    for job in JOBS:
    57	        work = OUT / job["name"]
    58	        work.mkdir(exist_ok=True)
    59	        (work / "input.sing").write_text(job["script"] + "\n")
    60	        log = open(work / "singular.log", "w")
    61	        procs[job["name"]] = subprocess.Popen(
    62	            ["timeout", str(SOLVER_SECONDS), str(binary), "-q", "--no-warn", "input.sing"],
    63	            stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, cwd=work,
    64	            preexec_fn=capped(job["as_bytes"]),
    65	        )
    66	    samples = open(OUT / "samples.tsv", "w")
    67	    samples.write("elapsed_s\t" + "\t".join(f"{n}_rss_kib" for n in procs) + "\tmem_available_kib\n")
    68	    stop = threading.Event()
    69	
    70	    def sample():
    71	        while not stop.is_set():
    72	            row = []
    73	            for proc in procs.values():
    74	                child = subprocess.run(["pgrep", "-P", str(proc.pid)], capture_output=True, text=True).stdout.split()
    75	                row.append(str(max([rss(int(c)) for c in child] + [rss(proc.pid)])))
    76	            samples.write(f"{time.time() - started:.0f}\t" + "\t".join(row) + f"\t{meminfo('MemAvailable')}\n")
    77	            samples.flush()
    78	            stop.wait(30)
    79	
    80	    sampler = threading.Thread(target=sample, daemon=True)
    81	    sampler.start()
    82	    jobs = {}
    83	    for name, proc in procs.items():
    84	        code = proc.wait()
    85	        lines = (OUT / name / "singular.log").read_text(errors="replace").splitlines()
    86	        jobs[name] = {
    87	            "return_code": code,
    88	            "ended_seconds": round(time.time() - started, 1),
    89	            "results": [line for line in lines if line.startswith(("RESULT", "PROGRESS"))],
    90	        }
    91	    stop.set()
    92	    sampler.join()
    93	    record = {
    94	        "label": LABEL,
    95	        "wheel": WHEEL,
    96	        "wall_seconds": round(time.time() - started, 1),
    97	        "peak_child_rss_kib": resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss,
    98	        "mem_total_kib": meminfo("MemTotal"),
    99	        "jobs": jobs,
   100	        "machine": platform.processor() or platform.machine(),
   101	        "python": sys.version.split()[0],
   102	    }
   103	    (OUT / "result.json").write_text(json.dumps(record, indent=1) + "\n")
   104	    print(json.dumps(record))
   105	
   106	
   107	main()

