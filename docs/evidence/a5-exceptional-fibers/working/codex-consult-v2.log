variables = ('t1','t2','t4','t5','t6','t7','t9')
prime = 32009

def parse(polynomial):
    terms = {}
    for term in re.finditer(r'([+-]?)(["'^+-]+)'"',polynomial):
        sign, body = term.groups()
        coefficient = -1 if sign == '-' else 1
        exponents = [0]*len(variables)
        for factor in body.strip().split('*'):
            if factor.lstrip('-').isdigit():
                coefficient *= int(factor)
            else:
                variable, _, power = factor.partition('"'^'"')
                exponents[variables.index(variable)] += int(power or '1')
        key = tuple(exponents)
        terms[key] = (terms.get(key,0)+coefficient) % prime
    return {key:value for key,value in terms.items() if value}

def ideals(name):
    lines = (folder/name/'input.sing').read_text().splitlines()
