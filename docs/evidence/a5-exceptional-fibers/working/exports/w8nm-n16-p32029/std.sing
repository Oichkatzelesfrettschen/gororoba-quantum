ring r=32029,(t1,t2,t4,t5,t6,t7,t9),dp;
ideal J=t1^2*t9^2-2*t1^2*t9+2*t1*t9^2-t2^2-t4^2+t5^2+t6^2-t7^2-4*t1*t9;
option(redSB);
int t0=rtimer;
ideal s=std(J+maxideal(16));
short=0; write(":w ~/a5/exports/w8nm-n16-p32029/s.txt.part",s);
ideal B=kbase(s);
short=0; write(":w ~/a5/exports/w8nm-n16-p32029/qB.txt.part",B);
"RESULT std", ncols(s), ncols(B), rtimer-t0;
quit;
