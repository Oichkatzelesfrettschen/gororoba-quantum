"RESULT generators",ncols(G);"RESULT slice_variables",7;int t0=timer;int i;int a;int b;
ideal M=maxideal(1);
ring Y=32009,(y(1..24)),dp;ideal Krel;setring r;
setring Y;ideal Mon2=maxideal(2);int c2=ncols(Mon2);setring r;
map phi2=Y,G;ideal P2=phi2(Mon2);
ideal U2=P2,J;for(i=1;i<=ncols(M);i++){U2=U2,M[i]*P2;}
module S2=syz(U2);
matrix C2[c2][size(S2)];for(a=1;a<=size(S2);a++){for(b=1;b<=c2;b++){C2[b,a]=jet(S2[a][b],0);}}
"RESULT h2",c2-rank(C2);"PROGRESS degree2_seconds",timer-t0;
setring Y;matrix CY2=imap(r,C2);ideal K2;for(a=1;a<=ncols(CY2);a++){poly f=0;for(b=1;b<=c2;b++){f=f+CY2[b,a]*Mon2[b];}K2[a]=f;kill f;}Krel=Krel+K2;Krel=interred(Krel);setring r;
setring Y;ideal sK=std(Krel);
"RESULT relations",size(Krel);"RESULT V_projdim",dim(sK)-1;"RESULT V_degree",mult(sK);
write(":w w8_np_fiber.rel",Krel);
list PK=minAssGTZ(sK);"RESULT V_components",size(PK);
for(i=1;i<=size(PK);i++){ideal Q=std(PK[i]);"RESULT comp_"+string(i),dim(Q)-1,mult(Q),size(Q);kill Q;}
"PROGRESS total_seconds",timer-t0;
quit;
