ideal Pr;int q=0;int i;int j;for(i=1;i<=17;i++){for(j=i;j<=17;j++){q++;Pr[q]=G[i]*G[j];}}
ideal U=Pr,J,t2*Pr,t3*Pr,t4*Pr,t5*Pr,t6*Pr,t7*Pr;"RESULT U_size",ncols(U);"STAGE syz";
module S=syz(U);"PROGRESS syz_seconds",timer-t0;"RESULT syz_count",size(S);
matrix C[153][size(S)];int a;int b;poly z;
for(a=1;a<=size(S);a++){for(b=1;b<=153;b++){z=jet(S[a][b],0);C[b,a]=z;}}
"RESULT rank_C",rank(C);"RESULT h2",153-rank(C);
ring Y=32009,(y(1..17)),dp;ideal Mon;int q2=0;for(i=1;i<=17;i++){for(j=i;j<=17;j++){q2++;Mon[q2]=y(i)*y(j);}}
matrix CY=imap(r,C);ideal K2;for(a=1;a<=ncols(CY);a++){poly f=0;for(b=1;b<=153;b++){f=f+CY[b,a]*Mon[b];}K2[a]=f;kill f;}
K2=interred(K2);"RESULT K2_gens",size(K2);ideal sK=std(K2);"RESULT K2_projdim",dim(sK)-1;"RESULT K2_degree",mult(sK);
"RESULT K2_hilb_deg3",size(kbase(sK,3));write(":w iso_K2.txt",K2);
list PK=minAssGTZ(sK);"RESULT K2_components",size(PK);for(i=1;i<=size(PK);i++){ideal Q=std(PK[i]);"RESULT comp_"+string(i),dim(Q)-1,mult(Q),size(Q);kill Q;}
"PROGRESS total_seconds",timer-t0;
quit;
