proc pfa(matrix A){ int n=nrows(A); if(n==2){return(A[1,2]);} poly s=0; int j; int q; int c; intvec idx=1..(n-2);
  for(j=2;j<=n;j++){ if(A[1,j]!=0){ c=0; for(q=2;q<=n;q++){ if(q!=j){c++; idx[c]=q;} } s=s+(-1)^j*A[1,j]*pfa(submat(A,idx,idx)); } } return(s); }
proc pq(matrix A,int a,int b,int c,int d){ return(A[a,b]*A[c,d]-A[a,c]*A[b,d]+A[a,d]*A[b,c]); }
poly pB=pfa(B); "PfB",pB; int sq=((pB^2-dB)==0); "PfB_squared_equals_detB",sq; "PfB factors",factorize(pB);
// The control pairs each 4-Pfaffian of W with the 10-Pfaffian of the next quadruple in the enumeration: a wrong
// index set, which the identity does not entail to differ, so the control can fail.
int bad=0; int ctl=0; int nz=0; int cnt=0; int a;int b;int c;int d; intvec I; ideal LH; ideal PT;
for(a=1;a<=6;a++){for(b=a+1;b<=7;b++){for(c=b+1;c<=8;c++){for(d=c+1;d<=9;d++){ cnt++; I=1,2,3,4,5,6,6+a,6+b,6+c,6+d; PT[cnt]=pfa(submat(T,I,I)); LH[cnt]=pq(W,a,b,c,d); }}}}
int e; for(e=1;e<=cnt;e++){ if(LH[e]!=0){nz++;} if(LH[e]-pB^3*PT[e]!=0){bad++;} if(LH[e]-pB^3*PT[(e % cnt)+1]==0){ctl++;} }
"PFAFF RESULT cell nm field Q(i) checked",cnt,"nonzero",nz,"failures",bad,"control_shifted_quadruple_equal",ctl;
if (sq==1 and cnt==126 and nz==126 and bad==0 and ctl==0) { "PFAFF VERDICT cell nm field Q(i) PASS"; } else { "PFAFF VERDICT cell nm field Q(i) FAIL"; }
"EXIT 0"; quit;
