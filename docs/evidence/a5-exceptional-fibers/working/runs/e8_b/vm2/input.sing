*t3*t6^2+6*t2^3*t4*t7+4*t1*t2*t3*t4*t7+2*t2*t3^2*t4*t7-6*t1*t5^3*t7-6*t3*t5^3*t7+6*t2*t4*t6^2*t7-6*t2*t6^3*t7+4*t2^2*t3*t7^2+8*t1*t5^2*t7^2+8*t3*t5^2*t7^2+8*t2*t5*t6*t7^2-8*t2*t4*t7^3+2*t1*t5*t7^3+2*t3*t5*t7^3-2*t2*t6*t7^3-8*t3*t7^4-2*t1*t2^3*t8-8*t2^3*t3*t8+12*t1*t2*t3^2*t8+12*t2*t3^3*t8-6*t1*t2*t5^2*t8-4*t2*t3*t5^2*t8+4*t2^2*t5*t6*t8-14*t3^2*t5*t6*t8+2*t5^3*t6*t8-4*t1*t2*t6^2*t8-4*t2*t3*t6^2*t8+2*t5*t6^3*t8-4*t2^2*t4*t7*t8+14*t3^2*t4*t7*t8+12*t1*t2*t5*t7*t8+8*t2*t3*t5*t7*t8-2*t4*t5^2*t7*t8-4*t5^2*t6*t7*t8-2*t6^3*t7*t8-2*t1*t2*t7^2*t8+4*t4*t5*t7^2*t8-2*t5*t6*t7^2*t8+2*t6*t7^3*t8-8*t2^2*t3*t8^2-6*t1*t3^2*t8^2+14*t3^3*t8^2+8*t3*t5^2*t8^2-6*t2*t5*t6*t8^2-4*t3*t6^2*t8^2+6*t2*t4*t7*t8^2-16*t3*t5*t7*t8^2+12*t3*t7^2*t8^2-2*t1*t2*t8^3-8*t2*t3*t8^3+6*t5*t6*t8^3-6*t4*t7*t8^3-4*t3*t8^4-2*t1*t2^2*t3*t9-6*t2^2*t3^2*t9+20*t1*t3^3*t9+10*t3^4*t9+2*t1*t3*t5^2*t9-8*t3^2*t5^2*t9-8*t1*t3*t5*t7*t9+36*t3^2*t5*t7*t9+14*t5^3*t7*t9+2*t1*t3*t7^2*t9-8*t3^2*t7^2*t9-24*t5^2*t7^2*t9+6*t5*t7^3*t9-4*t2^3*t8*t9+8*t1*t2*t3*t8*t9+16*t2*t3^2*t8*t9-4*t2*t5^2*t8*t9+28*t2*t5*t7*t8*t9-4*t2*t7^2*t8*t9-2*t1*t3*t8^2*t9-6*t3^2*t8^2*t9+16*t5*t7*t8^2*t9-4*t2*t8^3*t9+18*t1*t3^2*t9^2+6*t3^3*t9^2-8*t3*t5^2*t9^2-4*t1*t5*t7*t9^2+44*t3*t5*t7*t9^2-8*t3*t7^2*t9^2+4*t1*t2*t8*t9^2+16*t2*t3*t8*t9^2+8*t4*t7*t8*t9^2+4*t1*t3*t9^3+14*t3^2*t9^3-4*t5*t7*t9^3+4*t2*t8*t9^3+4*t3*t9^4-2*t2^4-2*t1*t2^2*t3+14*t2^2*t3^2+16*t1*t3^3-16*t3^4+2*t1*t3*t5^2-10*t3^2*t5^2-2*t5^4+16*t1*t2*t5*t6-4*t2*t3*t5*t6-14*t2^2*t6^2-2*t5^2*t6^2-16*t1*t2*t4*t7+4*t2*t3*t4*t7-4*t1*t3*t5*t7+20*t3^2*t5*t7+8*t5^3*t7+4*t4*t5*t6*t7+14*t2^2*t7^2+2*t1*t3*t7^2-10*t3^2*t7^2-14*t5^2*t7^2-2*t6^2*t7^2+8*t5*t7^3-6*t2^3*t8+8*t1*t2*t3*t8+24*t2*t3^2*t8-10*t2*t5^2*t8-12*t3*t5*t6*t8-4*t2*t6^2*t8+12*t3*t4*t7*t8+20*t2*t5*t7*t8-6*t2*t7^2*t8-4*t2^2*t8^2-2*t1*t3*t8^2+14*t3^2*t8^2-8*t5^2*t8^2-14*t6^2*t8^2+16*t5*t7*t8^2+6*t7^2*t8^2-6*t2*t8^3-2*t8^4+2*t1*t2^2*t9-2*t2^2*t3*t9+20*t1*t3^2*t9+20*t3^3*t9+2*t1*t5^2*t9-14*t3*t5^2*t9-8*t1*t5*t7*t9+64*t3*t5*t7*t9+2*t1*t7^2*t9-14*t3*t7^2*t9+8*t1*t2*t8*t9+28*t2*t3*t8*t9-4*t4*t5*t8*t9+16*t4*t7*t8*t9-4*t6*t7*t8*t9+2*t1*t8^2*t9-2*t3*t8^2*t9+12*t1*t3*t9^2+30*t3^2*t9^2+2*t5^2*t9^2-16*t5*t7*t9^2+2*t7^2*t9^2+16*t2*t8*t9^2+2*t8^2*t9^2+20*t3*t9^3+2*t1*t2^2+6*t2^2*t3+8*t1*t3^2-8*t3^3+2*t1*t5^2-18*t3*t5^2+16*t2*t5*t6-16*t2*t4*t7-4*t1*t5*t7+36*t3*t5*t7+2*t1*t7^2-18*t3*t7^2+4*t1*t2*t8+20*t2*t3*t8-4*t4*t5*t8+8*t4*t7*t8-4*t6*t7*t8+2*t1*t8^2+6*t3*t8^2+2*t2^2*t9+4*t1*t3*t9+28*t3^2*t9+6*t5^2*t9-20*t5*t7*t9+6*t7^2*t9+20*t2*t8*t9+6*t8^2*t9+36*t3*t9^2+2*t2^2-4*t1*t3+4*t3^2+4*t5^2-8*t5*t7+4*t7^2+8*t2*t8+2*t8^2-4*t1*t9+20*t3*t9+4*t9^2-4*t1+4*t3+4*t9;
// Method B: full special fiber by pivot saturation. F = k[t,y]/((H : g^inf) + (t)), H = J + (g*y_j - G_j*y_q).
// Falsifiers: F5 projective dim <= germ bound; F6 nonzerodivisor pivot; F4 HF agrees with method A where both ran.
LIB "elim.lib"; option(redSB); int t0=timer;
int n=ncols(G); ideal sJ0=std(J); int i; int q=1; int best=-1;
for(i=1;i<=n;i++){ G[i]=reduce(G[i],sJ0); }
for(i=1;i<=n;i++){ if(size(reduce(quotient(sJ0,ideal(G[i])),sJ0))==0){ if(best<0 or size(G[i])<size(G[q])){q=i;best=1;} } }
if(best<0){"RESULT no_nonzerodivisor_pivot"; quit;}
"RESULT generators",n,"pivot",q,"terms",size(G[q]),"seconds",timer-t0;
string sv=varstr(basering); int nv=nvars(basering);
execute("ring R=32009,("+sv+",y(1.."+string(n)+")),dp;");
ideal Jr=std(imap(r,J)); ideal Gr=imap(r,G); poly g=Gr[q];
ideal H=Jr; for(i=1;i<=n;i++){ if(i!=q){ H=H,g*y(i)-Gr[i]*y(q); } }
ideal Rees=sat(H,ideal(g)); "RESULT sat_seconds",timer-t0,"gens",size(Rees);
write(":w rees.txt",Rees);
ideal tv; for(i=1;i<=nv;i++){ tv=tv,var(i); }
ideal F=std(Rees+tv);
execute("ring Yf=32009,(y(1.."+string(n)+")),dp;"); ideal Fy=std(imap(R,F));
"RESULT fiber_projdim",dim(Fy)-1,"degree",mult(Fy),"seconds",timer-t0;
"RESULT hilb_numerator"; hilb(Fy,1);
write(":w fiber.txt",Fy);
int d; for(d=1;d<=5;d++){ "RESULT h",d,size(kbase(Fy,d)); }
"RESULT done",timer-t0; quit;
