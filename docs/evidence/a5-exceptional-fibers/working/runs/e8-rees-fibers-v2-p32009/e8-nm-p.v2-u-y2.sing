proc pf4(matrix A,int a,int b,int c,int d){ return(A[a,b]*A[c,d]-A[a,c]*A[b,d]+A[a,d]*A[b,c]); }
ideal PF; int a;int b;int c;int d;int n=0;
for(a=1;a<=6;a++){for(b=a+1;b<=7;b++){for(c=b+1;c<=8;c++){for(d=c+1;d<=9;d++){n++;PF[n]=reduce(pf4(W,a,b,c,d),J);}}}}
int dmax=0; for(a=1;a<=126;a++){ if(PF[a]!=0){ if(tmax(PF[a])>dmax){dmax=tmax(PF[a]);} if(!thomog(PF[a])){"INHOMOGENEOUS",a;} } }
"F nonzero",size(PF),"max weight",dmax;
"STAGE pf_done",rtimer; ideal TR=trunc(dmax); "trunc size",size(TR); ideal TT=std(J+TR+m*PF); "STAGE std_mPF_done size",size(TT),rtimer;
ideal G; intvec sel; int g=0; poly rr;
for(a=1;a<=126;a++){ rr=reduce(PF[a],TT); if(rr!=0){ g++; G[g]=PF[a]; sel[g]=a; "STAGE selected",a,rtimer; TT=std(TT+ideal(rr)); } }
"STAGE nakayama_done",rtimer; "NAKAYAMA generators",g; "selected",sel; intvec gw; for(a=1;a<=g;a++){gw[a]=tdeg(G[a]);} "generator weights",gw;
list IX; ideal P; n=0; int pmax=0; int x0;int x1; for(x0=1;x0<=g;x0++){for(x1=x0;x1<=g;x1++){n++;P[n]=reduce(G[x0]*G[x1],J);IX[n]=intvec(x0,x1); if(tmax(P[n])>pmax){pmax=tmax(P[n]);}}}
"STAGE products_done",rtimer; "products",n,"max weight",pmax;
int tt=timer; ideal TR2=trunc(pmax); "trunc2 size",size(TR2); ideal sQ=std(J+TR2+m*P); "STAGE std_Q_done size",size(sQ),rtimer;
ideal N=reduce(P,sQ);
ideal mons; poly h; for(a=1;a<=n;a++){h=N[a];while(h!=0){mons=mons,leadmonom(h);h=h-lead(h);}} mons=simplify(mons,6);
matrix M=coeffs(N,mons); "nonzero normal forms",size(N),"monomials",size(mons);
module S=syz(module(M)); "STAGE syz_done",rtimer; "RELATIONS",size(S),"of",n;
string row; for(a=1;a<=size(S);a++){ row=""; for(b=1;b<=n;b++){ if(S[a][b]!=0){ row=row+" "+string(IX[b])+":"+string(S[a][b]); } } print("REL"+row); }
"EMBED"; for(a=1;a<=g;a++){ print("GEN "+string(a)+" pf "+string(sel[a])+" w "+string(gw[a])); }

"STAGE rees_start",rtimer;
// Each G_a is replaced by g_a with G_a = (c_a(s2) / c_a(0)) g_a modulo J, c_a a polynomial in s2 alone with c_a(0) != 0:
// a unit of the local ring at the origin with value 1 there, so (g) = (G) locally and g_a, G_a have one class in I / m I.
ring rloc=32009,(s1,s3,s4,s5,s6,s7,s8,s9,s2),(a(1,3,2,2,1,4,4,3,0),dp); option(redSB);
ideal Jr=std(imap(r,J)); ideal Gr=reduce(imap(r,G),Jr); ideal Go=Gr; int uk; int um; matrix ucf; poly uc; intvec ud; intvec ut; list ul; ideal UC;
for(uk=1;uk<=ncols(Gr);uk++){ ucf=coef(Gr[uk],s1*s3*s4*s5*s6*s7*s8*s9); uc=0; for(um=1;um<=ncols(ucf);um++){ uc=gcd(uc,ucf[2,um]); }
  while(subst(uc,s2,0)==0){ uc=uc/s2; } Gr[uk]=(Gr[uk]/uc)*subst(uc,s2,0); ud[uk]=deg(uc); ut[uk]=size(Gr[uk]); UC[uk]=uc; if(deg(uc)>0){ ul[size(ul)+1]=uc; } }
int ub; int ubest; matrix uT; poly ug; ideal uI;
for(uk=1;uk<=size(ud);uk++){ if(ud[uk]==0){ ubest=0; for(ub=1;ub<=size(ul);ub++){ if(deg(ul[ub])>ubest){ uI=std(Jr+ideal(ul[ub]));
  if(reduce(Go[uk],uI)==0){ uT=lift(ideal(ul[ub])+Jr,Go[uk]); ug=reduce(uT[1,1],Jr);
    if(reduce(Go[uk]-ul[ub]*ug,Jr)==0){ ubest=deg(ul[ub]); Gr[uk]=ug*subst(ul[ub],s2,0); ud[uk]=ubest; ut[uk]=size(Gr[uk]); UC[uk]=ul[ub]; } } } } } }
"UNIT degrees removed",ud; "UNIT terms left",ut;
setring r; ideal Gold=G; G=imap(rloc,Gr); ideal UCr=imap(rloc,UC); int ubadn=0; int upos=1;
for(a=1;a<=g;a++){ if(reduce(subst(UCr[a],s2,0)*Gold[a]-UCr[a]*G[a],J)!=0 or subst(UCr[a],s2,0)==0 or UCr[a]!=subst(UCr[a],s1,0,s3,0,s4,0,s5,0,s6,0,s7,0,s8,0,s9,0)){ubadn++;} if(deg(UCr[a])<=0){upos=0;} print("UNIT "+string(a)+" c(0)="+string(subst(UCr[a],s2,0))+" c="+string(UCr[a])); }
"CERT unit_identity_bad",ubadn,"all_positive_degree",upos; if(ubadn>0 or !upos){ "CERT FAIL unit"; quit; }

intvec ow=1,1,3,2,2,1,4,4,3; int pivot=1; int a2; for(a2=1;a2<=g;a2++){ if(gw[a2]<gw[pivot]){pivot=a2;} }
intvec allw=ow,gw,gw[pivot];
ring r2=32009,(s(1..9),y(1..g),u),wp(allw); number i=10754; option(redSB);
map toslice=r,s(1),s(2),s(3),s(4),s(5),s(6),s(7),s(8),s(9);
ideal J2=toslice(J); ideal G2=toslice(G);
ideal M2; int cnt=0; int b2;
for(a2=1;a2<=g;a2++){for(b2=a2+1;b2<=g;b2++){cnt++;M2[cnt]=y(a2)*G2[b2]-y(b2)*G2[a2];}}
"pivot generator",pivot,"weight",gw[pivot];
setring r; ring rk=32009,(y(1..g)),dp; ideal KQ; poly kq; int ka; int kb; intvec kx; setring r; matrix SM=matrix(S); setring rk; matrix SM=imap(r,SM); for(ka=1;ka<=ncols(SM);ka++){ kq=0; for(kb=1;kb<=nrows(SM);kb++){ if(SM[kb,ka]!=0){ kx=IX[kb]; kq=kq+SM[kb,ka]*y(kx[1])*y(kx[2]); } } KQ[ka]=kq; } option(redSB); KQ=std(KQ); "K quadrics",size(minbase(KQ)),"dim",dim(KQ),"mult",mult(KQ); setring r2; "SOURCE sha256 226c4af155e80ec36d97165640cd7716f17477b3ef3e196bc58b22c3ce571f50"; ideal sJ2=std(J2); int nzd_ok=(size(reduce(quotient(sJ2,ideal(G2[pivot])),sJ2))==0); "CERT pivot_nonzerodivisor_mod_J",nzd_ok; if(!nzd_ok){ "CERT FAIL pivot"; quit; } ideal H=J2+M2+ideal(u-G2[pivot]); ideal yy; for(a2=1;a2<=g;a2++){yy[a2]=y(a2);} H=H+yy^3; LIB "customstd.lib";  ideal HS=satstd(H,ideal(u)); option(noprot); "STAGE rees_std_done size",size(HS),rtimer; write("ssi:w e8-nm-p.v2-u-y2.hs.ssi",HS); "STAGE basis_saved",rtimer; int isb=attrib(HS,"isSB"); int ubad=0; intvec le2; for(a2=1;a2<=size(HS);a2++){ le2=leadexp(HS[a2]); if(le2[nvars(basering)]>0){ubad++;} } "CERT satstd_isSB",isb,"leading_u_bad",ubad; if(!isb){ "CERT FAIL saturation"; quit; } int cit=0; ideal QU; if(ubad>0){ while(1){ QU=quotient(HS,ideal(u)); if(size(reduce(QU,HS))==0){ break; } HS=std(QU); cit++; } "CERT colon_equal_after_iterations",cit,rtimer; write("ssi:w e8-nm-p.v2-u-y2.sat.ssi",HS); } ideal zero; for(a2=1;a2<=9;a2++){zero[a2]=0;} for(a2=1;a2<=g;a2++){zero[9+a2]=y(a2);} zero[10+g]=0; map fib=r2,zero; ideal LL=simplify(fib(HS),2); setring rk; ideal LL=imap(r2,LL); ideal LD; for(ka=1;ka<=size(LL);ka++){ if(2==0 or deg(LL[ka])<=2){ LD[size(LD)+1]=LL[ka]; } } ideal sLD=std(LD); ideal LM=minbase(sLD); intvec dg; for(ka=1;ka<=size(LM);ka++){dg[ka]=deg(LM[ka]);} "FIBER bound",2,"minimal generators",size(LM),"dim",dim(sLD),"mult",mult(sLD); "generator degrees",dg; "FIBER outside_K",size(reduce(LD,KQ)),"K_outside_fiber",size(reduce(KQ,sLD)); if(2==0){ "hilb"; hilb(sLD,1); } "STAGE rees_done",rtimer; quit;
