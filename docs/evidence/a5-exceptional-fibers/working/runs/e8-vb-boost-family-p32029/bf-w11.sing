list EP=elimpart(J);map reducedMap=s,EP[5];
ideal ReducedJ=std(reducedMap(J));
ideal ReducedMaximal=simplify(reduce(reducedMap(maximal),ReducedJ),2);
ideal ReducedG=simplify(reduce(reducedMap(G),ReducedJ),2);
"RESULT germ_dimension",dim(J);
"RESULT germ_component_count",componentCount;
"RESULT candidate_count",ncols(F);
"RESULT selected_count",selectedCount;
for(int i=1;i<=selectedCount;i++){"RESULT selected_"+string(i),Selected[i];}
int eliminatedCount=0;for(int i=1;i<=size(EP[2]);i++){if(EP[2][i]!=0){eliminatedCount++;"RESULT eliminated_"+string(eliminatedCount),EP[2][i];}}
"RESULT eliminated_count",eliminatedCount;
"RESULT reduced_j_count",size(ReducedJ);
for(int i=1;i<=size(ReducedJ);i++){"RESULT reduced_j_"+string(i),ReducedJ[i];}
"RESULT reduced_g_count",size(ReducedG);
for(int i=1;i<=size(ReducedG);i++){"RESULT reduced_g_"+string(i),ReducedG[i];}
option(redSB);def R0=basering;ideal sJ=std(ReducedJ);ideal GG=ReducedG;
int n=ncols(GG);int i;int k;int f;int e;int b;int j;
"STAGE std_J_done "+string(rtimer);
for(i=1;i<=n;i++){GG[i]=reduce(GG[i],sJ);}
ring Y=32029,(y(1..n)),dp;ideal kb=kbase(std(ideal(0)),2);int c=ncols(kb); number w=11;
for(i=1;i<=c;i++){"RESULT target_"+string(i),kb[i];}
setring R0;ideal P;poly q;intvec ev;
for(i=1;i<=c;i++){setring Y;ev=leadexp(kb[i]);setring R0;q=1;
for(f=1;f<=n;f++){for(e=1;e<=ev[f];e++){q=reduce(q*GG[f],sJ);}}P[i]=q;
"STAGE product "+string(i)+" of "+string(c)+" "+string(rtimer);}
ideal SliceM=t1,t2,t3,t4,t5,t6,t7,t8;ideal Q=sJ;for(k=1;k<=ncols(SliceM);k++){for(i=1;i<=c;i++){Q=Q,SliceM[k]*P[i];}}
"STAGE std_Q_start generators "+string(size(Q))+" "+string(rtimer);
ideal sQ=std(Q);"RESULT sq_size",size(sQ);"STAGE std_Q_done "+string(rtimer);ideal N=reduce(P,sQ);
"STAGE normal_forms_done "+string(rtimer);
ideal mons;poly h;for(b=1;b<=c;b++){h=N[b];while(h!=0){mons=mons,leadmonom(h);h=h-lead(h);}}
mons=simplify(mons,6);"RESULT monomials",size(mons);
matrix M=coeffs(N,mons);module S=syz(module(M));"STAGE syzygies_done "+string(rtimer);
"RESULT targets",c;"RESULT relations",size(S);string row;
for(j=1;j<=size(S);j++){row=string(S[j][1]);
for(b=2;b<=c;b++){row=row+";"+string(S[j][b]);}"RESULT rel_"+string(j),row;}
setring Y; module SY=imap(R0,S); ideal K; poly kq;
for(j=1;j<=size(SY);j++){ kq=0; for(b=1;b<=c;b++){ kq=kq+SY[j][b]*kb[b]; } K[j]=kq; }
option(redSB); ideal sK=std(K);
"RESULT k_generators",size(minbase(K)),"dim",dim(sK),"mult",mult(sK);
"RESULT k_numerator",hilb(sK,1);
LIB "primdec.lib"; list PL=minAssGTZ(K); ideal pc; ideal lin; int lc; ideal four;
for(i=1;i<=size(PL);i++){ pc=std(PL[i]); lin=0; lc=0;
  for(k=1;k<=size(pc);k++){ if(deg(pc[k])==1){ lc++; lin[lc]=pc[k]; } }
  "RESULT prime",dim(pc),mult(pc),lc;
  if(lc==4){ four=std(lin); } }
"RESULT radical",size(reduce(intersect(PL[1],PL[size(PL)]),sK))==0;
poly n1=reduce(y(1),four); poly n5=reduce(y(5),four); poly n2=reduce(y(2),four); poly n4=reduce(y(4),four);
number fa=-1/leadcoef(diff(n1,y(10))); number fb=-1/leadcoef(diff(n5,y(9)));
number fd=-fa*leadcoef(diff(n4,y(10)));
"RESULT frame_a",fa; "RESULT frame_b",fb; "RESULT frame_d",fd;
"RESULT frame_consistent",(n2+(1/fb)*y(8)==0) and (n1+(1/fa)*y(10)==0) and (n5+(1/fb)*y(9)==0);
map phi=Y,y(8),y(9),y(2),(y(3)-y(7)+fd*y(8))/2,y(10),(y(3)+y(7)-fd*y(8))/2,y(1),y(6)-fb*y(9),y(5)-fb*y(10),
  y(4)-(fd/2)*y(7)-fa*y(8);
ideal mx=maxideal(1); ideal pim=phi(mx);
"RESULT frame_determinant_nonzero",det(jacob(pim))!=0;
ideal NK=std(phi(K));
"RESULT normal_form_size",size(NK);
for(i=1;i<=size(NK);i++){"NORMALFORM "+string(NK[i]);}
ideal CK=std(K);
for(i=1;i<=size(CK);i++){"KBASIS "+string(CK[i]);}
"RESULT done 1";
quit;

