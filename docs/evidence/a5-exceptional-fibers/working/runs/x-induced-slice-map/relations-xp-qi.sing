matrix B[6][6]=submat(T,ra,ra);
matrix X[6][9]=submat(T,ra,rb);
matrix Dm[9][9]=submat(T,rb,rb);
poly dB=det(B); matrix aB=adjoint(B);
matrix W=dB*Dm+transpose(X)*aB*X;
intvec tw=1,0,3,2,2,1,4,4,3;
int k;

proc tdeg(poly p){ int v=0; int k; intvec e=leadexp(p); for(k=1;k<=9;k++){v=v+e[k]*tw[k];} return(v); }
proc thomog(poly p){ int v=tdeg(p); while(p!=0){ if(tdeg(p)!=v){return(0);} p=p-lead(p); } return(1); }
proc tmax(poly p){ int v=0; while(p!=0){ if(tdeg(p)>v){v=tdeg(p);} p=p-lead(p); } return(v); }
// Minimal monomials in the positive-weight variables of weight above E.
proc trunc(int E){
  ideal pos; int k; for(k=1;k<=9;k++){ if(tw[k]>0){pos=pos,var(k);} } pos=simplify(pos,2);
  ideal cur=1; ideal out; ideal nxt; int a; int b; poly q;
  while(size(cur)>0){
    nxt=0;
    for(a=1;a<=ncols(cur);a++){ if(cur[a]!=0){ for(b=1;b<=ncols(pos);b++){
      q=cur[a]*pos[b]; if(tdeg(q)>E){out=out,q;}else{nxt=nxt,q;} } } }
    cur=simplify(nxt,6);
  }
  return(simplify(out,6));
}
proc pf4(matrix A,int a,int b,int c,int d){ return(A[a,b]*A[c,d]-A[a,c]*A[b,d]+A[a,d]*A[b,c]); }

ideal J=(8*s2*s8 + s5^2 - 8*i*s7),(64*i*s1*s8*s9 + 16*s2^2*s8^2 + 32*i*s2*s7*s8 + 64*i*s3*s6*s8 + 16*i*s4^2*s8 - 16*s7^2),(-16*s2^2*s8^2 - 32*i*s2*s7*s8 - 16*i*s4^2*s8 + 16*s7^2),(-8*s1*s2*s8^2 - 8*i*s1*s2*s8 - 8*i*s1*s7*s8 + 8*s1*s7 + 8*s2*s8^2*s9 + 8*i*s2*s8*s9 - 8*i*s3*s4*s8 + 8*s3*s4 + 8*s4*s6*s8^2 + 8*i*s4*s6*s8 + 8*i*s7*s8*s9 - 8*s7*s9),(8*i*s1*s4*s8^2 - 8*s1*s4*s8 - 8*i*s2*s3*s8^2 + 8*s2*s3*s8 + 8*i*s2*s6*s8^2 - 8*s2*s6*s8 + 8*s3*s7*s8 + 8*i*s3*s7 + 8*s4*s8*s9 + 8*i*s4*s9 - 8*s6*s7*s8 - 8*i*s6*s7),(-8*s1*s2*s8^2 - 8*i*s1*s2*s8 - 8*i*s1*s7*s8 + 8*s1*s7 - 8*s2*s8^2*s9 - 8*i*s2*s8*s9 - 8*i*s3*s4*s8 + 8*s3*s4 - 8*s4*s6*s8^2 - 8*i*s4*s6*s8 - 8*i*s7*s8*s9 + 8*s7*s9),(-8*i*s1*s4*s8^2 + 8*s1*s4*s8 + 8*i*s2*s3*s8^2 - 8*s2*s3*s8 + 8*i*s2*s6*s8^2 - 8*s2*s6*s8 - 8*s3*s7*s8 - 8*i*s3*s7 + 8*s4*s8*s9 + 8*i*s4*s9 - 8*s6*s7*s8 - 8*i*s6*s7),(16*s1*s4*s8 - 16*s2*s3*s8 - 16*i*s2*s6*s8^2 - 16*i*s3*s7 - 16*s4*s8*s9 + 16*s6*s7*s8),(16*s1*s2*s8^2 + 16*i*s1*s7*s8 - 16*i*s2*s8*s9 + 16*i*s3*s4*s8 - 16*i*s4*s6*s8 + 16*s7*s9),(16*s1*s4*s8 - 16*s2*s3*s8 + 16*i*s2*s6*s8^2 - 16*i*s3*s7 + 16*s4*s8*s9 - 16*s6*s7*s8),(-16*s1*s2*s8^2 - 16*i*s1*s7*s8 - 16*i*s2*s8*s9 - 16*i*s3*s4*s8 - 16*i*s4*s6*s8 + 16*s7*s9),(8*s1^2*s8^2 + 8*i*s1^2*s8 - 8*s1*s8^2*s9 - 16*i*s1*s8*s9 + 8*s1*s9 + 8*i*s3^2*s8 - 8*s3^2 - 8*s3*s6*s8^2 - 16*i*s3*s6*s8 + 8*s3*s6 + 8*s6^2*s8^2 + 8*i*s6^2*s8 + 8*i*s8*s9^2 - 8*s9^2),(16*i*s1*s6*s8^2 - 16*s1*s6*s8 + 16*s3*s8*s9 + 16*i*s3*s9),(-8*s1^2*s8^2 - 8*i*s1^2*s8 + 8*s1*s8^2*s9 + 8*s1*s9 - 8*i*s3^2*s8 + 8*s3^2 + 8*s3*s6*s8^2 + 8*s3*s6 + 8*s6^2*s8^2 + 8*i*s6^2*s8 + 8*i*s8*s9^2 - 8*s9^2),(-8*s1^2*s8^2 - 8*i*s1^2*s8 - 8*s1*s8^2*s9 - 8*s1*s9 - 8*i*s3^2*s8 + 8*s3^2 - 8*s3*s6*s8^2 - 8*s3*s6 + 8*s6^2*s8^2 + 8*i*s6^2*s8 + 8*i*s8*s9^2 - 8*s9^2),(16*i*s1*s6*s8^2 - 16*s1*s6*s8 + 16*s3*s8*s9 + 16*i*s3*s9),(-8*s1^2*s8^2 - 8*i*s1^2*s8 - 8*s1*s8^2*s9 - 16*i*s1*s8*s9 + 8*s1*s9 - 8*i*s3^2*s8 + 8*s3^2 - 8*s3*s6*s8^2 - 16*i*s3*s6*s8 + 8*s3*s6 - 8*s6^2*s8^2 - 8*i*s6^2*s8 - 8*i*s8*s9^2 + 8*s9^2),(-8*s1*s2*s8^2 + 8*i*s1*s2*s8 - 8*i*s1*s7*s8 - 8*s1*s7 + 8*s2*s8^2*s9 - 8*i*s2*s8*s9 - 8*i*s3*s4*s8 - 8*s3*s4 + 8*s4*s6*s8^2 - 8*i*s4*s6*s8 + 8*i*s7*s8*s9 + 8*s7*s9),(8*i*s1*s4*s8^2 + 8*s1*s4*s8 - 8*i*s2*s3*s8^2 - 8*s2*s3*s8 + 8*i*s2*s6*s8^2 + 8*s2*s6*s8 + 8*s3*s7*s8 - 8*i*s3*s7 + 8*s4*s8*s9 - 8*i*s4*s9 - 8*s6*s7*s8 + 8*i*s6*s7),(-8*s1*s2*s8^2 + 8*i*s1*s2*s8 - 8*i*s1*s7*s8 - 8*s1*s7 - 8*s2*s8^2*s9 + 8*i*s2*s8*s9 - 8*i*s3*s4*s8 - 8*s3*s4 - 8*s4*s6*s8^2 + 8*i*s4*s6*s8 - 8*i*s7*s8*s9 - 8*s7*s9),(-8*i*s1*s4*s8^2 - 8*s1*s4*s8 + 8*i*s2*s3*s8^2 + 8*s2*s3*s8 + 8*i*s2*s6*s8^2 + 8*s2*s6*s8 - 8*s3*s7*s8 + 8*i*s3*s7 + 8*s4*s8*s9 - 8*i*s4*s9 - 8*s6*s7*s8 + 8*i*s6*s7),(-8*s1^2*s8^2 + 8*i*s1^2*s8 + 8*s1*s8^2*s9 + 8*s1*s9 - 8*i*s3^2*s8 - 8*s3^2 + 8*s3*s6*s8^2 + 8*s3*s6 - 8*s6^2*s8^2 + 8*i*s6^2*s8 - 8*i*s8*s9^2 - 8*s9^2),(-16*i*s1*s6*s8^2 - 16*s1*s6*s8 - 16*s3*s8*s9 + 16*i*s3*s9),(8*s1^2*s8^2 - 8*i*s1^2*s8 - 8*s1*s8^2*s9 + 16*i*s1*s8*s9 + 8*s1*s9 + 8*i*s3^2*s8 + 8*s3^2 - 8*s3*s6*s8^2 + 16*i*s3*s6*s8 + 8*s3*s6 - 8*s6^2*s8^2 + 8*i*s6^2*s8 - 8*i*s8*s9^2 - 8*s9^2),(8*s1^2*s8^2 - 8*i*s1^2*s8 + 8*s1*s8^2*s9 - 16*i*s1*s8*s9 - 8*s1*s9 + 8*i*s3^2*s8 + 8*s3^2 + 8*s3*s6*s8^2 - 16*i*s3*s6*s8 - 8*s3*s6 - 8*s6^2*s8^2 + 8*i*s6^2*s8 - 8*i*s8*s9^2 - 8*s9^2),(-16*i*s1*s6*s8^2 - 16*s1*s6*s8 - 16*s3*s8*s9 + 16*i*s3*s9),(8*s1^2*s8^2 - 8*i*s1^2*s8 + 8*s1*s8^2*s9 + 8*s1*s9 + 8*i*s3^2*s8 + 8*s3^2 + 8*s3*s6*s8^2 + 8*s3*s6 + 8*s6^2*s8^2 - 8*i*s6^2*s8 + 8*i*s8*s9^2 + 8*s9^2),(-i*s5),(-16*s1*s9 - 16*s2*s7 - 16*s3*s6 - 4*s4^2); J=std(J);
print("RESULT germ_before "+string(dim(J))+" "+string(mult(J))+" "+string(size(J)));

list L=minAssGTZ(J); ideal JJ=1; ideal Lk; ideal sm=std(maxideal(1)); int kk;
for(kk=1;kk<=size(L);kk++){
  Lk=std(L[kk]);
  print("RESULT component "+string(dim(Lk))+" "+string(mult(Lk))+" "+string(size(reduce(Lk,sm))==0));
  if(size(reduce(Lk,sm))==0){JJ=intersect(JJ,Lk);}
}
J=std(JJ);


print("RESULT germ_after "+string(dim(J))+" "+string(mult(J))+" "+string(size(J)));
int bad=0; for(k=1;k<=size(J);k++){ if(!thomog(J[k])){bad++;} }
print("RESULT germ_inhomogeneous "+string(bad));
ideal m=maxideal(1);
ideal PF; int a; int b; int c; int d; int n=0;
for(a=1;a<=6;a++){for(b=a+1;b<=7;b++){for(c=b+1;c<=8;c++){for(d=c+1;d<=9;d++){ n++; PF[n]=reduce(pf4(W,a,b,c,d),J); }}}}
int dmax=0; string inhomogeneous="";
for(a=1;a<=126;a++){ if(PF[a]!=0){
  if(tmax(PF[a])>dmax){dmax=tmax(PF[a]);}
  if(!thomog(PF[a])){inhomogeneous=inhomogeneous+" "+string(a);} } }
print("RESULT pfaffian_nonzero "+string(size(PF)));
print("RESULT pfaffian_max_weight "+string(dmax));
print("RESULT pfaffian_inhomogeneous"+inhomogeneous);


ideal TR=trunc(dmax); ideal TT=std(J+TR+m*PF);
ideal G; intvec sel; int g=0; poly rr;
for(a=1;a<=126;a++){ rr=reduce(PF[a],TT); if(rr!=0){ g++; G[g]=PF[a]; sel[g]=a; TT=std(TT+ideal(rr)); } }
print("RESULT generators "+string(g));
print("RESULT selected "+string(sel));
intvec gw; for(a=1;a<=g;a++){gw[a]=tdeg(G[a]);}
print("RESULT generator_weights "+string(gw));

list IX; ideal P; n=0; int pmax=0; int x1; int x2;
for(x1=1;x1<=g;x1++){for(x2=x1;x2<=g;x2++){n++; P[n]=reduce(G[x1]*G[x2],J); IX[n]=intvec(x1,x2); if(tmax(P[n])>pmax){pmax=tmax(P[n]);}}}
print("RESULT products "+string(n)+" "+string(pmax));
ideal TR2=trunc(pmax); ideal sQ=std(J+TR2+m*P);
ideal N=reduce(P,sQ);
ideal mons; poly h;
for(a=1;a<=n;a++){ h=N[a]; while(h!=0){ mons=mons,leadmonom(h); h=h-lead(h); } }
mons=simplify(mons,6);
matrix M=coeffs(N,mons);
print("RESULT normal_forms "+string(size(N))+" "+string(size(mons)));
module S=syz(module(M));
print("RESULT relations "+string(size(S)));
string row;
for(a=1;a<=size(S);a++){
  row="";
  for(b=1;b<=n;b++){ if(S[a][b]!=0){ row=row+" "+string(IX[b])+":"+string(S[a][b]); } }
  print("RELATION"+row);
}

print("RESULT done 1");
quit;
