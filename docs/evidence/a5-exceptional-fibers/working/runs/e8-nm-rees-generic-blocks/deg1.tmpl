// y-degree 1 blocks of the multidegree decomposition of the Rees ideal of E8bar at N-, field GF(@P@), i = @IVAL@.
// z = s2 is fixed to @ZVAL@ (entry @ZIDX@ of the fixed list 7013, 21890, 3567). Gradings: tw = (1,0,3,2,2,1,4,4,3), t3 = (1,0,2,1,1,0,2,2,1);
// y_a has the bidegree of G_a; s2 has bidegree (0,0), so every block is a free k[s2]-module and the 8 other variables enumerate it.
// Reading 1: the box of blocks is 0<=tw<=14, 0<=t3<=8, the componentwise maximum of bideg(G_a)+bideg(G_b), a<b.
// Reading 2: span(J*y, minors) in a block is the bidegree component of the submodule of the free module S8^21 generated
//   by Jz*e_c and G_b e_a - G_a e_b (s2 = z in J, G and phi alike); its codimension is counted by a standard basis of that module.
LIB "matrix.lib";
system("--ticks-per-sec",1000);
int t0=rtimer;
int MODE=@MODE@;
option(redSB);
ring r9=@FIELD@,(s1,s2,s3,s4,s5,s6,s7,s8,s9),dp;
ideal J9=@JTEXT@;
ideal G9=@GTEXT@;
print("RESULT i_squared_mod_p = "+string((@IVAL@*@IVAL@) % @P@));
print("RESULT z_value = @ZVAL@");
print("RESULT reading_box = tw<=@W@ and t3<=@V@ (componentwise max of bideg G_a + bideg G_b, a<b)");
print("RESULT reading_span = bidegree part of the submodule generated by Jz e_c and G_b e_a - G_a e_b, counted by standard monomials");
intvec gw=@GW@;
intvec gv=@GV@;
ring S8=@FIELD@,(s1,s3,s4,s5,s6,s7,s8,s9),(wp(1,3,2,2,1,4,4,3),C);
map sp=r9,s1,@ZVAL@,s3,s4,s5,s6,s7,s8,s9;
ideal Jz=sp(J9); ideal Gz=sp(G9);
Jz=std(Jz); Gz=reduce(Gz,Jz);
print("RESULT Jz_generators = "+string(size(Jz)));
print("RESULT Jz_dim = "+string(dim(Jz)));
print("RESULT Jz_mult = "+string(mult(Jz)));
print("RESULT Gz_nonzero = "+string(size(Gz)));
intvec w8=1,3,2,2,1,4,4,3;
intvec v8=1,2,1,1,0,2,2,1;
int WM=@W@; int VM=@V@;
proc mono(int k,int w,int v){
  if(w<0 or v<0){ return(ideal(0)); }
  if(k>8){ if(w==0 and v==0){ return(ideal(1)); } return(ideal(0)); }
  int e=0; ideal sub; int j; ideal acc=0;
  while(e*w8[k]<=w and e*v8[k]<=v){
    sub=mono(k+1,w-e*w8[k],v-e*v8[k]);
    for(j=1;j<=ncols(sub);j++){ if(sub[j]!=0){ acc=acc,var(k)^e*sub[j]; } }
    e++;
  }
  return(simplify(acc,2));
}
list MS; int w; int v; int c; int j; int n; int idx; int i2; int nn; int nq; int qs; int ts; int hf;
int K=(WM+1)*(VM+1);
for(w=0;w<=WM;w++){ for(v=0;v<=VM;v++){ MS[w*(VM+1)+v+1]=mono(1,w,v); } }
n=0; for(idx=1;idx<=K;idx++){ n=n+size(MS[idx]); }
print("RESULT s_monomials_in_box = "+string(n));
intvec HFJ=0:K;
ideal ms; ideal tmp;
for(w=0;w<=WM;w++){ for(v=0;v<=VM;v++){ idx=w*(VM+1)+v+1; ms=MS[idx]; hf=0;
  for(j=1;j<=ncols(ms);j++){ if(ms[j]!=0){ if(reduce(ms[j],Jz)==ms[j]){ hf++; } } }
  HFJ[idx]=hf; } }
print("RESULT setup_ms = "+string(rtimer-t0));
ring Q=@FIELD@,(a,b,l,m),dp;
map phi=S8,a,l*a,l*m,2*@ZVAL@*l-@CI8@*l*m^2,b,@IVAL@*l^2,-@ZVAL@*l^2+@CI8@*l^2*m^2,-l*b;
ideal JQ=phi(Jz); ideal gq=phi(Gz);
print("RESULT Jz_on_phi_nonzero = "+string(size(JQ)));
print("RESULT gq_nonzero = "+string(size(gq)));
print("RESULT bad_control_nonzero_terms = "+string(size(gq[1]*gq[2]-2*gq[2]*gq[1])));
list IM; ideal itmp; ideal monsT; ideal E; matrix CM; int ii; int kk; int jj; int rr; int rmax; int dd; int nt; int rankE; int nz; int terms; int x;
intvec RK0=0:K; int bad0=0; int badcomplete=0; int rkmax=0; int tmax=0; int shape_done=0;
for(w=0;w<=WM;w++){ for(v=0;v<=VM;v++){ idx=w*(VM+1)+v+1;
  setring S8; tmp=MS[idx]; setring Q; itmp=phi(tmp); IM[idx]=itmp;
  if(size(itmp)>0){
    rmax=0; for(x=1;x<=ncols(itmp);x++){ if(itmp[x]!=0){ dd=deg(itmp[x],intvec(0,0,0,1)); if(dd>rmax){rmax=dd;} } }
    monsT=0; nt=0;
    for(ii=0;ii<=v;ii++){ kk=v-ii; jj=w-2*v+ii; if(jj>=0){ for(rr=0;rr<=rmax;rr++){ nt++; monsT[nt]=a^ii*b^jj*l^kk*m^rr; } } }
    CM=coeffs(itmp,monsT);
    if(shape_done==0){ print("RESULT coeffs_shape_first = "+string(nrows(CM))+"x"+string(ncols(CM))+" for ideal size "+string(ncols(itmp))+" and monomials "+string(ncols(monsT))); shape_done=1; }
    nz=0; for(ii=1;ii<=nrows(CM);ii++){ for(jj=1;jj<=ncols(CM);jj++){ if(CM[ii,jj]!=0){nz++;} } }
    terms=0; for(x=1;x<=ncols(itmp);x++){ terms=terms+size(itmp[x]); }
    if(nz!=terms){ badcomplete++; }
    RK0[idx]=rank(CM);
  }
  if(RK0[idx]!=HFJ[idx]){ bad0++; }
} }
print("RESULT degree0_bidegrees_where_Jz_differs_from_kernel_of_phi = "+string(bad0));
print("RESULT degree0_incomplete_monomial_lists = "+string(badcomplete));
print("RESULT stage0_ms = "+string(rtimer-t0));
if(MODE==0){ print("RESULT done 1"); quit; }
// stage 1: codimension of span(J*y, minors) in each block
setring S8;
module M; n=0;
for(c=1;c<=21;c++){ for(j=1;j<=ncols(Jz);j++){ n++; M[n]=Jz[j]*gen(c); } }
for(c=1;c<=21;c++){ for(j=c+1;j<=21;j++){ n++; M[n]=Gz[j]*gen(c)-Gz[c]*gen(j); } }
print("RESULT module_generators = "+string(n));
ts=rtimer;
module sM=std(M);
print("RESULT module_std_ms = "+string(rtimer-ts));
print("RESULT module_std_size = "+string(size(sM)));
// the kernel of the evaluation map at z = @ZVAL@ as the module of f in S8^21 with sum f_c G_c in Jz (valid when Jz is the kernel of phi, checked in degree 0 above),
// and the minimal new generators of that kernel over span(J*y, minors): q1 - rankE, with M1 = M + (s_k) Kmod
module H1; module H2;
for(c=1;c<=21;c++){ H1[c]=Gz[c]*gen(1); } for(j=1;j<=ncols(Jz);j++){ H2[j]=Jz[j]*gen(1); }
ts=rtimer; module Kg=modulo(H1,H2);
print("RESULT kernel_module_generators = "+string(size(Kg))); print("RESULT kernel_module_ms = "+string(rtimer-ts));
ts=rtimer; module sK=std(Kg); print("RESULT kernel_std_ms = "+string(rtimer-ts));
module M1=M; n=ncols(M1);
for(j=1;j<=ncols(Kg);j++){ if(Kg[j]!=0){ for(c=1;c<=8;c++){ n++; M1[n]=var(c)*Kg[j]; } } }
ts=rtimer; module s1M=std(M1); print("RESULT m1_std_ms = "+string(rtimer-ts)); print("RESULT m1_generators = "+string(n));
intvec Nsz=0:K; intvec Nq=0:K; intvec Qsp=0:K; intvec MsS=0:K; intvec QK=0:K; intvec Q1=0:K; int qk; int q1;
vector t;
for(w=0;w<=WM;w++){ for(v=0;v<=VM;v++){ idx=w*(VM+1)+v+1; ts=rtimer; nn=0; nq=0; qs=0; qk=0; q1=0;
  for(c=1;c<=21;c++){
    if(w-gw[c]>=0 and v-gv[c]>=0){
      i2=(w-gw[c])*(VM+1)+(v-gv[c])+1; ms=MS[i2];
      for(j=1;j<=ncols(ms);j++){ if(ms[j]!=0){
        nn++; if(reduce(ms[j],Jz)==ms[j]){ nq++; }
        t=ms[j]*gen(c); if(reduce(t,sM)==t){ qs++; } if(reduce(t,sK)==t){ qk++; } if(reduce(t,s1M)==t){ q1++; }
      } }
    }
  }
  Nsz[idx]=nn; Nq[idx]=nq; Qsp[idx]=qs; QK[idx]=qk; Q1[idx]=q1; MsS[idx]=rtimer-ts; } }
print("RESULT stage1_ms = "+string(rtimer-t0));
// stage 2: rank of the evaluation map z = @ZVAL@, block by block
setring Q;
intvec Nev=0:K; intvec RKE=0:K; intvec MsE=0:K;
for(w=0;w<=WM;w++){ for(v=0;v<=VM;v++){ idx=w*(VM+1)+v+1; ts=rtimer;
  E=0; nn=0;
  for(c=1;c<=21;c++){
    if(w-gw[c]>=0 and v-gv[c]>=0){
      i2=(w-gw[c])*(VM+1)+(v-gv[c])+1; itmp=IM[i2];
      for(j=1;j<=ncols(itmp);j++){ if(itmp[j]!=0){ nn++; E[nn]=itmp[j]*gq[c]; } }
    }
  }
  Nev[idx]=nn;
  if(nn>0){
    rmax=0; for(x=1;x<=nn;x++){ dd=deg(E[x],intvec(0,0,0,1)); if(dd>rmax){rmax=dd;} }
    monsT=0; nt=0;
    for(ii=0;ii<=v;ii++){ kk=v-ii; jj=w-2*v+ii; if(jj>=0){ for(rr=0;rr<=rmax;rr++){ nt++; monsT[nt]=a^ii*b^jj*l^kk*m^rr; } } }
    CM=coeffs(E,monsT);
    nz=0; for(ii=1;ii<=nrows(CM);ii++){ for(jj=1;jj<=ncols(CM);jj++){ if(CM[ii,jj]!=0){nz++;} } }
    terms=0; for(x=1;x<=nn;x++){ terms=terms+size(E[x]); }
    if(nz!=terms){ badcomplete++; }
    RKE[idx]=rank(CM);
    if(nt>tmax){ tmax=nt; }
  }
  MsE[idx]=rtimer-ts; } }
print("RESULT degree1_incomplete_monomial_lists = "+string(badcomplete));
print("RESULT target_monomials_max = "+string(tmax));
print("RESULT stage2_ms = "+string(rtimer-t0));
// table: N, N' (= N mod J*y), codim of span, rank of evaluation, kernel, rank of span, new relations, ms span, ms eval
int nblocks=0; int nnew=0; int nneg=0; int nmax=0; int nmaxidx=0; int tot=0; int msmax=0; int kern; int rsp; int nw; int nocc=0; int ng; int ngtot=0; int ngblocks=0; int badk=0; int badm1=0;
for(w=0;w<=WM;w++){ for(v=0;v<=VM;v++){ idx=w*(VM+1)+v+1;
  if(Nsz[idx]!=Nev[idx]){ print("RESULT ERROR size_mismatch "+string(w)+","+string(v)); }
  if(Nsz[idx]>0){
    nblocks++; kern=Nsz[idx]-RKE[idx]; rsp=Nsz[idx]-Qsp[idx]; nw=kern-rsp;
    if(nw>0){ nnew++; } if(nw<0){ nneg++; }
    if(Nsz[idx]>nmax){ nmax=Nsz[idx]; nmaxidx=idx; }
    if(MsS[idx]+MsE[idx]>msmax){ msmax=MsS[idx]+MsE[idx]; }
    ng=Q1[idx]-RKE[idx]; ngtot=ngtot+ng; if(ng>0){ ngblocks++; } if(QK[idx]!=RKE[idx]){ badk++; } if(Q1[idx]<RKE[idx]){ badm1++; }
    print("RESULT block1 "+string(w)+","+string(v)+" = N "+string(Nsz[idx])+" NmodJ "+string(Nq[idx])+" rankE "+string(RKE[idx])+" kernel "+string(kern)+" spanrank "+string(rsp)+" new "+string(nw)+" minimal_new "+string(ng)+" qK "+string(QK[idx])+" ms_span "+string(MsS[idx])+" ms_eval "+string(MsE[idx]));
  }
} }
print("RESULT occupied_blocks = "+string(nblocks));
print("RESULT minimal_new_generators_total = "+string(ngtot));
print("RESULT blocks_with_minimal_new_generators = "+string(ngblocks));
print("RESULT blocks_where_kernel_module_count_differs_from_rankE = "+string(badk));
print("RESULT blocks_where_m1_count_below_rankE = "+string(badm1));
print("RESULT largest_block_size = "+string(nmax));
print("RESULT largest_block_index = "+string(nmaxidx));
print("RESULT blocks_with_new_relations = "+string(nnew));
print("RESULT blocks_with_span_exceeding_kernel = "+string(nneg));
print("RESULT max_ms_per_block = "+string(msmax));
print("RESULT total_ms = "+string(rtimer-t0));
system("sh","grep VmHWM /proc/$PPID/status | sed 's/VmHWM:[[:space:]]*/RESULT vmhwm_kb = /;s/ kB//'");
print("RESULT done 1");
quit;
