intvec tw=1,0,3,2,2,1,4,4,3;
int k;

proc tdeg(poly p){ int v=0; int k; intvec e=leadexp(p); for(k=1;k<=9;k++){v=v+e[k]*tw[k];} return(v); }
proc thomog(poly p){ int v=tdeg(p); while(p!=0){ if(tdeg(p)!=v){return(0);} p=p-lead(p); } return(1); }
proc tmax(poly p){ int v=0; while(p!=0){ if(tdeg(p)>v){v=tdeg(p);} p=p-lead(p); } return(v); }
// Minimal monomials in the positive-weight variables of weight above E.
proc trunc(int E){
  ideal pos; int k; for(k=1;k<=9;k++){ if(tw[k]>0){pos=pos,var(k);} } pos=simplify(pos,2);
  ideal cur=1; ideal out; ideal nxt; int a; int b; poly q;
  while(size(cur)>0){
    nxt=0;
    for(a=1;a<=ncols(cur);a++){ if(cur[a]!=0){ for(b=1;b<=ncols(pos);b++){
      q=cur[a]*pos[b]; if(tdeg(q)>E){out=out,q;}else{nxt=nxt,q;} } } }
    cur=simplify(nxt,6);
  }
  return(simplify(out,6));
}
proc pf4(matrix A,int a,int b,int c,int d){ return(A[a,b]*A[c,d]-A[a,c]*A[b,d]+A[a,d]*A[b,c]); }

ideal J=(8*s2*s8 + s5^2 - 8*i*s7),(64*i*s1*s8*s9 + 16*s2^2*s8^2 + 32*i*s2*s7*s8 + 64*i*s3*s6*s8 + 16*i*s4^2*s8 - 16*s7^2),(-16*s2^2*s8^2 - 32*i*s2*s7*s8 - 16*i*s4^2*s8 + 16*s7^2),(-8*s1*s2*s8^2 - 8*i*s1*s2*s8 - 8*i*s1*s7*s8 + 8*s1*s7 + 8*s2*s8^2*s9 + 8*i*s2*s8*s9 - 8*i*s3*s4*s8 + 8*s3*s4 + 8*s4*s6*s8^2 + 8*i*s4*s6*s8 + 8*i*s7*s8*s9 - 8*s7*s9),(8*i*s1*s4*s8^2 - 8*s1*s4*s8 - 8*i*s2*s3*s8^2 + 8*s2*s3*s8 + 8*i*s2*s6*s8^2 - 8*s2*s6*s8 + 8*s3*s7*s8 + 8*i*s3*s7 + 8*s4*s8*s9 + 8*i*s4*s9 - 8*s6*s7*s8 - 8*i*s6*s7),(-8*s1*s2*s8^2 - 8*i*s1*s2*s8 - 8*i*s1*s7*s8 + 8*s1*s7 - 8*s2*s8^2*s9 - 8*i*s2*s8*s9 - 8*i*s3*s4*s8 + 8*s3*s4 - 8*s4*s6*s8^2 - 8*i*s4*s6*s8 - 8*i*s7*s8*s9 + 8*s7*s9),(-8*i*s1*s4*s8^2 + 8*s1*s4*s8 + 8*i*s2*s3*s8^2 - 8*s2*s3*s8 + 8*i*s2*s6*s8^2 - 8*s2*s6*s8 - 8*s3*s7*s8 - 8*i*s3*s7 + 8*s4*s8*s9 + 8*i*s4*s9 - 8*s6*s7*s8 - 8*i*s6*s7),(16*s1*s4*s8 - 16*s2*s3*s8 - 16*i*s2*s6*s8^2 - 16*i*s3*s7 - 16*s4*s8*s9 + 16*s6*s7*s8),(16*s1*s2*s8^2 + 16*i*s1*s7*s8 - 16*i*s2*s8*s9 + 16*i*s3*s4*s8 - 16*i*s4*s6*s8 + 16*s7*s9),(16*s1*s4*s8 - 16*s2*s3*s8 + 16*i*s2*s6*s8^2 - 16*i*s3*s7 + 16*s4*s8*s9 - 16*s6*s7*s8),(-16*s1*s2*s8^2 - 16*i*s1*s7*s8 - 16*i*s2*s8*s9 - 16*i*s3*s4*s8 - 16*i*s4*s6*s8 + 16*s7*s9),(8*s1^2*s8^2 + 8*i*s1^2*s8 - 8*s1*s8^2*s9 - 16*i*s1*s8*s9 + 8*s1*s9 + 8*i*s3^2*s8 - 8*s3^2 - 8*s3*s6*s8^2 - 16*i*s3*s6*s8 + 8*s3*s6 + 8*s6^2*s8^2 + 8*i*s6^2*s8 + 8*i*s8*s9^2 - 8*s9^2),(16*i*s1*s6*s8^2 - 16*s1*s6*s8 + 16*s3*s8*s9 + 16*i*s3*s9),(-8*s1^2*s8^2 - 8*i*s1^2*s8 + 8*s1*s8^2*s9 + 8*s1*s9 - 8*i*s3^2*s8 + 8*s3^2 + 8*s3*s6*s8^2 + 8*s3*s6 + 8*s6^2*s8^2 + 8*i*s6^2*s8 + 8*i*s8*s9^2 - 8*s9^2),(-8*s1^2*s8^2 - 8*i*s1^2*s8 - 8*s1*s8^2*s9 - 8*s1*s9 - 8*i*s3^2*s8 + 8*s3^2 - 8*s3*s6*s8^2 - 8*s3*s6 + 8*s6^2*s8^2 + 8*i*s6^2*s8 + 8*i*s8*s9^2 - 8*s9^2),(16*i*s1*s6*s8^2 - 16*s1*s6*s8 + 16*s3*s8*s9 + 16*i*s3*s9),(-8*s1^2*s8^2 - 8*i*s1^2*s8 - 8*s1*s8^2*s9 - 16*i*s1*s8*s9 + 8*s1*s9 - 8*i*s3^2*s8 + 8*s3^2 - 8*s3*s6*s8^2 - 16*i*s3*s6*s8 + 8*s3*s6 - 8*s6^2*s8^2 - 8*i*s6^2*s8 - 8*i*s8*s9^2 + 8*s9^2),(-8*s1*s2*s8^2 + 8*i*s1*s2*s8 - 8*i*s1*s7*s8 - 8*s1*s7 + 8*s2*s8^2*s9 - 8*i*s2*s8*s9 - 8*i*s3*s4*s8 - 8*s3*s4 + 8*s4*s6*s8^2 - 8*i*s4*s6*s8 + 8*i*s7*s8*s9 + 8*s7*s9),(8*i*s1*s4*s8^2 + 8*s1*s4*s8 - 8*i*s2*s3*s8^2 - 8*s2*s3*s8 + 8*i*s2*s6*s8^2 + 8*s2*s6*s8 + 8*s3*s7*s8 - 8*i*s3*s7 + 8*s4*s8*s9 - 8*i*s4*s9 - 8*s6*s7*s8 + 8*i*s6*s7),(-8*s1*s2*s8^2 + 8*i*s1*s2*s8 - 8*i*s1*s7*s8 - 8*s1*s7 - 8*s2*s8^2*s9 + 8*i*s2*s8*s9 - 8*i*s3*s4*s8 - 8*s3*s4 - 8*s4*s6*s8^2 + 8*i*s4*s6*s8 - 8*i*s7*s8*s9 - 8*s7*s9),(-8*i*s1*s4*s8^2 - 8*s1*s4*s8 + 8*i*s2*s3*s8^2 + 8*s2*s3*s8 + 8*i*s2*s6*s8^2 + 8*s2*s6*s8 - 8*s3*s7*s8 + 8*i*s3*s7 + 8*s4*s8*s9 - 8*i*s4*s9 - 8*s6*s7*s8 + 8*i*s6*s7),(-8*s1^2*s8^2 + 8*i*s1^2*s8 + 8*s1*s8^2*s9 + 8*s1*s9 - 8*i*s3^2*s8 - 8*s3^2 + 8*s3*s6*s8^2 + 8*s3*s6 - 8*s6^2*s8^2 + 8*i*s6^2*s8 - 8*i*s8*s9^2 - 8*s9^2),(-16*i*s1*s6*s8^2 - 16*s1*s6*s8 - 16*s3*s8*s9 + 16*i*s3*s9),(8*s1^2*s8^2 - 8*i*s1^2*s8 - 8*s1*s8^2*s9 + 16*i*s1*s8*s9 + 8*s1*s9 + 8*i*s3^2*s8 + 8*s3^2 - 8*s3*s6*s8^2 + 16*i*s3*s6*s8 + 8*s3*s6 - 8*s6^2*s8^2 + 8*i*s6^2*s8 - 8*i*s8*s9^2 - 8*s9^2),(8*s1^2*s8^2 - 8*i*s1^2*s8 + 8*s1*s8^2*s9 - 16*i*s1*s8*s9 - 8*s1*s9 + 8*i*s3^2*s8 + 8*s3^2 + 8*s3*s6*s8^2 - 16*i*s3*s6*s8 - 8*s3*s6 - 8*s6^2*s8^2 + 8*i*s6^2*s8 - 8*i*s8*s9^2 - 8*s9^2),(-16*i*s1*s6*s8^2 - 16*s1*s6*s8 - 16*s3*s8*s9 + 16*i*s3*s9),(8*s1^2*s8^2 - 8*i*s1^2*s8 + 8*s1*s8^2*s9 + 8*s1*s9 + 8*i*s3^2*s8 + 8*s3^2 + 8*s3*s6*s8^2 + 8*s3*s6 + 8*s6^2*s8^2 - 8*i*s6^2*s8 + 8*i*s8*s9^2 + 8*s9^2); J=std(J);
print("RESULT germ_before "+string(dim(J))+" "+string(mult(J))+" "+string(size(J)));

list L=minAssGTZ(J); ideal JJ=1; ideal Lk; ideal sm=std(maxideal(1)); int kk;
for(kk=1;kk<=size(L);kk++){
  Lk=std(L[kk]);
  print("RESULT component "+string(dim(Lk))+" "+string(mult(Lk))+" "+string(size(reduce(Lk,sm))==0));
  if(size(reduce(Lk,sm))==0){JJ=intersect(JJ,Lk);}
}
J=std(JJ);
J=std(J+ideal(v*u0-1));


print("RESULT germ_after "+string(dim(J))+" "+string(mult(J))+" "+string(size(J)));
int bad=0; for(k=1;k<=size(J);k++){ if(!thomog(J[k])){bad++;} }
print("RESULT germ_inhomogeneous "+string(bad));
ideal m=s1,s2,s3,s4,s5,s6,s7,s8,s9;
ideal PF; int a; int b; int c; int d; int n=0;
for(a=1;a<=6;a++){for(b=a+1;b<=7;b++){for(c=b+1;c<=8;c++){for(d=c+1;d<=9;d++){ n++; PF[n]=reduce(pf4(W,a,b,c,d),J); }}}}
int dmax=0; string inhomogeneous="";
for(a=1;a<=126;a++){ if(PF[a]!=0){
  if(tmax(PF[a])>dmax){dmax=tmax(PF[a]);}
  if(!thomog(PF[a])){inhomogeneous=inhomogeneous+" "+string(a);} } }
print("RESULT pfaffian_nonzero "+string(size(PF)));
print("RESULT pfaffian_max_weight "+string(dmax));
print("RESULT pfaffian_inhomogeneous"+inhomogeneous);


ideal TR=trunc(dmax); ideal TT=std(J+TR+m*PF);
ideal G; intvec sel; int g=0; poly rr;
for(a=1;a<=126;a++){ rr=reduce(PF[a],TT); if(rr!=0){ g++; G[g]=PF[a]; sel[g]=a; TT=std(TT+ideal(rr)); } }
print("RESULT generators "+string(g));
print("RESULT selected "+string(sel));
intvec gw; for(a=1;a<=g;a++){gw[a]=tdeg(G[a]);}
print("RESULT generator_weights "+string(gw));

ideal HP; int hq=0;
hq++; HP[hq]=reduce(pf4(NHm,2,6,7,9),J);
hq++; HP[hq]=reduce(pf4(NHm,2,6,8,9),J);
hq++; HP[hq]=reduce(pf4(NHm,2,3,6,9),J);
hq++; HP[hq]=reduce(pf4(NHm,2,3,6,8),J);
hq++; HP[hq]=reduce(pf4(NHm,2,4,8,9),J);
hq++; HP[hq]=reduce(pf4(NHm,2,5,8,9),J);
hq++; HP[hq]=reduce(pf4(NHm,1,7,8,9),J);
hq++; HP[hq]=reduce(pf4(NHm,2,3,4,9),J);
hq++; HP[hq]=reduce(pf4(NHm,2,3,4,8),J);
hq++; HP[hq]=reduce(pf4(NHm,4,6,8,9),J);
hq++; HP[hq]=reduce(pf4(NHm,4,7,8,9),J);
hq++; HP[hq]=reduce(pf4(NHm,1,6,7,9),J);
hq++; HP[hq]=reduce(pf4(NHm,2,4,7,9),J);
hq++; HP[hq]=reduce(pf4(NHm,1,6,7,8),J);
hq++; HP[hq]=reduce(pf4(NHm,2,4,6,9),J);
hq++; HP[hq]=reduce(pf4(NHm,2,4,6,7),J);
hq++; HP[hq]=reduce(pf4(NHm,3,4,6,7),J);
hq++; HP[hq]=reduce(pf4(NHm,3,4,6,9),J);
hq++; HP[hq]=reduce(pf4(NHm,3,6,7,9),J);
hq++; HP[hq]=reduce(pf4(NHm,3,6,8,9),J);
hq++; HP[hq]=reduce(pf4(NHm,6,7,8,9),J);
int hdmax=dmax; for(a=1;a<=ncols(HP);a++){ if(tmax(HP[a])>hdmax){hdmax=tmax(HP[a]);} }
print("RESULT header_max_weight "+string(hdmax)+" "+string(dmax));
ideal T0=std(J+TR+m*PF);

ideal TU=std(J+m*PF); int hbad=0; poly hhi; poly hrest;
for(a=1;a<=ncols(HP);a++){ hhi=0; hrest=HP[a];
  while(hrest!=0){ if(tdeg(lead(hrest))>dmax){hhi=hhi+lead(hrest);} hrest=hrest-lead(hrest); }
  if(reduce(hhi,TU)!=0){hbad++;} }
print("RESULT header_high_weight_outside "+string(hbad));
print("RESULT done 1");
quit;

ideal NWf=reduce(G,T0); ideal NHf=reduce(HP,T0);
print("RESULT header_normal_forms_nonzero "+string(size(NHf)));
ideal hmons; poly hh; ideal hall=NWf,NHf;
for(a=1;a<=ncols(hall);a++){ hh=hall[a]; while(hh!=0){ hmons=hmons,leadmonom(hh); hh=hh-lead(hh); } }
hmons=simplify(hmons,6);
matrix CW=coeffs(NWf,hmons); matrix CH=coeffs(NHf,hmons);
int hsplit=size(ideal(matrix(hmons)*CW-matrix(NWf)))+size(ideal(matrix(hmons)*CH-matrix(NHf)));
print("RESULT coefficient_split "+string(hsplit));
print("RESULT header_outside_span "+string(size(reduce(module(CH),std(module(CW))))));
matrix Lm=lift(module(CW),module(CH));
print("RESULT lift_residual "+string(size(ideal(CW*Lm-CH))));
int hdeg=0; for(a=1;a<=nrows(Lm);a++){for(b=1;b<=ncols(Lm);b++){ if(deg(Lm[a,b])>hdeg){hdeg=deg(Lm[a,b]);} }}
print("RESULT lift_shape "+string(nrows(Lm))+" "+string(ncols(Lm))+" "+string(hdeg));
print("RESULT lift_determinant_nonzero "+string(det(Lm)!=0));
matrix Gm=inverse(transpose(Lm));
string hrow;
for(a=1;a<=nrows(Gm);a++){ hrow=""; for(b=1;b<=ncols(Gm);b++){ hrow=hrow+" "+string(Gm[a,b]); } print("MAPROW"+hrow); }
poly hbad=HP[1]+s2; poly hbn=reduce(hbad,T0);
ideal hm2=hmons; hh=hbn; while(hh!=0){ hm2=hm2,leadmonom(hh); hh=hh-lead(hh); } hm2=simplify(hm2,6);
matrix CW2=coeffs(NWf,hm2); matrix CB2=coeffs(ideal(hbn),hm2);
print("RESULT control_nonmember_residual "+string(size(reduce(module(CB2),std(module(CW2))))));

print("RESULT done 1");
quit;
