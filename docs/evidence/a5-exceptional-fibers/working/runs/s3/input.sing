option(redSB); int t0=timer;
ideal sJ=std(J); int n=ncols(G); int i; int k; int f; int e;
for(i=1;i<=n;i++){G[i]=reduce(G[i],sJ);}
ring Y=32009,(y(1..17)),dp;
execute("ideal K="+read("iso_k2.rel")+";");
ideal sK=std(K); ideal kb=kbase(sK,3); int c=ncols(kb); "RESULT normal_cubics",c;
setring r; ideal P3; poly q; intvec ev;
for(i=1;i<=c;i++){ setring Y; ev=leadexp(kb[i]); setring r; q=1;
  for(f=1;f<=n;f++){ for(e=1;e<=ev[f];e++){ q=reduce(q*G[f],sJ); } } P3[i]=q; }
"RESULT products",c,"seconds",timer-t0;
ideal Q=sJ; for(k=1;k<=nvars(basering);k++){for(i=1;i<=c;i++){Q=Q,var(k)*P3[i];}}
"RESULT Q_gens",size(Q);
ideal sQ=std(Q); "RESULT std_Q_seconds",timer-t0,"size",size(sQ);
ideal N=reduce(P3,sQ); write(":w s3_nf3.txt",N);
"RESULT done",timer-t0; quit;
