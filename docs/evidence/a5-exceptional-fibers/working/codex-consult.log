\"CHECK linear-memberships\",reduce(y(1),SK),reduce(y(5),SK),reduce(y(6),SK);
ideal Kplus=std(K+ideal(y(1),y(5),y(6)));
list Primes=minAssChar(Kplus,0);
\"CHECK primes\",size(Primes);
ideal Prime=std(Primes[1]);
\"CHECK prime_equals_Kplus\",size(reduce(Prime,Kplus))==0,size(reduce(Kplus,Prime))==0;
\"CHECK dimensions\",dim(SK)-1,mult(SK),dim(Prime)-1,mult(Prime);
ring r=32009,(x,z),dp;
ideal J=x"'^2-z''^2;
ideal P=x''^2,x*z,z''^2;
ideal Presentation=P,J;
module S=syz(Presentation);
matrix C[3][ncols(S)];
int a,b;
for(a=1;a<=ncols(S);a++){for(b=1;b<=3;b++){C[b,a]=jet(S[a][b],0);}}
"CHECK lean_h2",3-rank(C);
ideal Denominator=J,x*P,z*P;
ideal NF=reduce(P,std(Denominator));
matrix Coeff=coef(NF,x*z);
matrix Scalars=submat(Coeff,2..nrows(Coeff),1..ncols(Coeff));
"CHECK NF_h2",rank(Scalars);
ideal Chart=std(subst(P,x,1));
ideal Closure=sat(homog(Chart,x),ideal(x));
"CHECK chart_syntax",Closure;
quit;
'"'''
