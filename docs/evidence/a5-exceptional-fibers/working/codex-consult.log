docs/local/a5-failed-runs/probes/pA_xm_rel.sing
     1	// Probe A: reload the 69 quadric relations of X- to N- and recompute invariants.
     2	// Falsifier: relations 69, projdim 3, degree 12 (kaggle-pack-a/result.json).
     3	LIB "primdec.lib";
     4	ring Y=32009,(y(1..15)),dp;
     5	execute("ideal K="+read("../kaggle-pack-a/xm_nm/xm_nm_fiber.rel")+";");
     6	"RESULT size",size(K);
     7	int t0=timer;
     8	option(redSB);
     9	ideal sK=std(K);
    10	"RESULT projdim",dim(sK)-1,"degree",mult(sK),"std_seconds",timer-t0;
    11	intvec h=hilb(sK,1);
    12	"RESULT hilb1",h;
    13	"RESULT HF", kbase(sK,2)[1]==0;
    14	int d;for(d=1;d<=5;d++){ideal kb=kbase(sK,d);"RESULT HF_deg",d,size(kb);kill kb;}
    15	"RESULT initial_degrees",sort(intvec(deg(sK[1])))[1];
    16	"RESULT size_std",size(sK);
    17	quit;

docs/local/a5-failed-runs/probes/pB_xm_decomp.sing
     1	// Probe B: decompose V(K2) of X- to N- without minAssGTZ. Falsifier: components must multiply out to projdim 3, degree 12.
     2	LIB "primdec.lib";
     3	ring Y=32009,(y(1..15)),dp;
     4	execute("ideal K="+read("../kaggle-pack-a/xm_nm/xm_nm_fiber.rel")+";");
     5	int t0=timer;
     6	list F=facstd(K);
     7	"RESULT facstd_pieces",size(F),"seconds",timer-t0;
     8	int i;
     9	for(i=1;i<=size(F);i++){ideal Q=std(F[i]);"RESULT piece",i,"projdim",dim(Q)-1,"degree",mult(Q),"size",size(Q);kill Q;}
    10	// linear forms vanishing on V and the variables in the radical
    11	ideal sK=std(K);
    12	for(i=1;i<=15;i++){ if(reduce(var(i)^2,sK)==0){"RESULT y"+string(i)+"^2 in K";} }
    13	quit;

docs/local/a5-failed-runs/probes/pC_xm_reduce.sing
     1	// Probe C: kill the nilpotent coordinates y1,y5,y6 (y^2 in K) and decompose in 12 variables.
     2	LIB "primdec.lib";
     3	ring Y=32009,(y(1..15)),dp;
     4	execute("ideal K="+read("../kaggle-pack-a/xm_nm/xm_nm_fiber.rel")+";");
     5	ideal K1=std(K+ideal(y(1),y(5),y(6)));
     6	"RESULT reduced12 projdim",dim(K1)-1,"degree",mult(K1),"size",size(K1);
     7	int i; for(i=1;i<=15;i++){ if(i!=1 && i!=5 && i!=6 && reduce(var(i)^2,K1)==0){"RESULT more nilpotent y"+string(i);} }
     8	int t0=timer;
     9	list F=facstd(K1);"RESULT facstd12 pieces",size(F),"seconds",timer-t0;
    10	for(i=1;i<=size(F);i++){ideal Q=std(F[i]);"RESULT piece",i,"projdim",dim(Q)-1,"degree",mult(Q),"size",size(Q);kill Q;}
    11	t0=timer;
    12	list L=minAssChar(K1);"RESULT minAssChar comps",size(L),"seconds",timer-t0;
    13	for(i=1;i<=size(L);i++){ideal Q=std(L[i]);"RESULT comp",i,"projdim",dim(Q)-1,"degree",mult(Q),"size",size(Q);kill Q;}
    14	quit;

