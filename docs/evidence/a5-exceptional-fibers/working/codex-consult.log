import re
from pathlib import Path
base=Path('docs/local/a5-failed-runs/kaggle-pack-a')
prime=32009
variables=['t1','t2','t4','t5','t6','t7','t9']
def parse(polynomial):
    result={}
    for sign,term in re.findall(r'([+-]?)(["'^+-]+)'"',polynomial):
        coefficient=-1 if sign=='-' else 1
        exponents=[0]*len(variables)
        for factor in term.split('*'):
            if factor.startswith('t'):
                parts=factor.split('"'^'"')
                exponents[variables.index(parts[0])]+=int(parts[1]) if len(parts)>1 else 1
            else: coefficient*=int(factor)
        key=tuple(exponents)
        result[key]=(result.get(key,0)+coefficient)%prime
    return {key:value for key,value in result.items() if value}
def polys(name,label):
    lines=(base/name/'input.sing').read_text().splitlines()
    line=next(s for s in lines if s.startswith('ideal '+label+'='))
    return [parse(s) for s in line.split('=',1)[1].rstrip(';').split(',')]
def normalized(polynomial):
    first=polynomial[min(polynomial)]
    inverse=pow(first,-1,prime)
    return tuple(sorted((key,value*inverse%prime) for key,value in polynomial.items()))
for label in ['J','G']:
    plus=polys('xp_np',label); minus=polys('xm_nm',label)
    transformed=[{key:value*(-1 if key[-1]%2 else 1)%prime for key,value in polynomial.items()} for polynomial in plus]
    print(label,'counts',len(plus),len(minus),'t9-sign equivalence as normalized sets',sorted(map(normalized,transformed))==sorted(map(normalized,minus)))
    for index,polynomial in enumerate(transformed):
        matches=[j+1 for j,other in enumerate(minus) if normalized(polynomial)==normalized(other)]
        print(label,index+1,'matched',matches)
