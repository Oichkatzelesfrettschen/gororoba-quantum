poly T1=jet((kpar^2*aq1-aq2)*(u^2)*vinv/4,n,sw); poly T2=jet((T1*w*(w+2)+2*w^2)*zinv,n,sw);
poly T7=jet(kpar*w*(w+2)*u*vinv,n,sw); poly T8=jet(-(w^2)*u,n,sw);
