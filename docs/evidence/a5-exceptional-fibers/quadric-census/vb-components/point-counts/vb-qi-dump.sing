"RESULT specialmutated generators of J nonzero on the arc through order", n-2, size(simplify(jet(phi(ReducedJ),n-2,sw),2));
ideal Gs=jet(phi(ReducedG),n-3,sw); int nu=lowest(Gs); ideal F=limit(Gs,nu);
matrix M=concat(jacob(F),transpose(matrix(F))); map p1=Sspecialmutated,0,2,3,5,7; map p2=Sspecialmutated,0,13,4,9,6; map back=Y,F;
"RESULT specialmutated k = -9 + K x, w = W x^2, rho = Rh x, sig = Sg x: nu", nu, "nonzero limit entries", size(simplify(F,2));
"RESULT specialmutated K2 nonzero on the limit", size(simplify((back(K2)),2)), "P1", size(simplify((back(P1)),2)), "of", ncols(back(P1)), "P2", size(simplify((back(P2)),2)), "of", ncols(back(P2));
"RESULT specialmutated rank of [dF | F] at two points", rank(p1(M)), rank(p2(M));
ring Sneighbor=(0,I),(x,W,Rh,Sg,K),dp; minpoly=I2+1;
intvec sw=1,0,0,0,0;
int n=14; poly kpar=-8+K*x; poly w=W*x^2; poly rho=Rh*x; poly sig=Sg*x; poly m=1+w;
poly u=inv(m,n); poly zinv=inv(m^2+1,n); poly vinv=inv(1+kpar^2,n);
poly aq1=w^4-6*w^2-4*w; poly aq2=w^4+8*w^3+18*w^2+12*w;
poly T1=jet((kpar^2*aq1-aq2)*(u^2)*vinv/4,n,sw); poly T2=jet((T1*w*(w+2)+2*w^2)*zinv,n,sw);
poly T7=jet(kpar*w*(w+2)*u*vinv,n,sw); poly T8=jet(-(w^2)*u/2,n,sw);
ideal IM; int vi; string vn; for (vi=1;vi<=nvars(R0);vi++) { vn=varstr(R0,vi); IM[vi]=0; if (vn=="t1") { IM[vi]=T1; } if (vn=="t2") { IM[vi]=T2; } if (vn=="t3") { IM[vi]=-(m*rho+sig)/2; } if (vn=="t4") { IM[vi]=(m*sig+rho)/2; } if (vn=="t5") { IM[vi]=(m*rho-sig)/2; } if (vn=="t6") { IM[vi]=(rho-m*sig)/2; } if (vn=="t7") { IM[vi]=1*T7; } if (vn=="t8") { IM[vi]=T8; } } map phi=R0,IM;
"RESULT neighbor generators of J nonzero on the arc through order", n-2, size(simplify(jet(phi(ReducedJ),n-2,sw),2));
ideal Gs=jet(phi(ReducedG),n-3,sw); int nu=lowest(Gs); ideal F=limit(Gs,nu);
matrix M=concat(jacob(F),transpose(matrix(F))); map p1=Sneighbor,0,2,3,5,7; map p2=Sneighbor,0,13,4,9,6; map back=Y,F;
"RESULT neighbor k = -8 + K x, w = W x^2, rho = Rh x, sig = Sg x: nu", nu, "nonzero limit entries", size(simplify(F,2));
"RESULT neighbor K2 nonzero on the limit", size(simplify((back(K2)),2)), "P1", size(simplify((back(P1)),2)), "of", ncols(back(P1)), "P2", size(simplify((back(P2)),2)), "of", ncols(back(P2));
"RESULT neighbor rank of [dF | F] at two points", rank(p1(M)), rank(p2(M));
"EXIT 0";
quit;
