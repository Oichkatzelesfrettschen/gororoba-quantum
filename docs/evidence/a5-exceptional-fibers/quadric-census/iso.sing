option(redSB);
ring Y=32009,(y(1..17)),dp;
execute("ideal K="+read("docs/evidence/a5-exceptional-fibers/working/distribute/out/a5-iso-d4/iso_p1/d2/relations-upto-d2.rel")+";");
ideal S=std(K);
"RESULT iso generators", size(K), "dim", dim(S), "mult", mult(S);
ideal Q=std(quotient(S,maxideal(1)));
"RESULT iso K2 : m equals K2 (saturated)", size(simplify(reduce(Q,S),2))==0;
ideal Lin=maxideal(1); int j; ideal N;
"RESULT iso hilbert numerator", hilb(S,2);
quit;
