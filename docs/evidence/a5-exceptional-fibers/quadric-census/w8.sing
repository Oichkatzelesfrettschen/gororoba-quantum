option(redSB);
ring Y=32009,(y(1..24)),dp;
execute("ideal K="+read("docs/evidence/a5-exceptional-fibers/working/runs/w8_a2/w8_k2.rel")+";");
ideal S=std(K);
"RESULT w8 generators", size(K), "dim", dim(S), "mult", mult(S);
ideal Q=std(quotient(S,maxideal(1)));
"RESULT w8 K2 : m equals K2 (saturated)", size(simplify(reduce(Q,S),2))==0;
ideal Lin=maxideal(1); int j; ideal N;
"RESULT w8 hilbert numerator", hilb(S,2);
quit;
