LIB "general.lib"; option(redSB); system("--ticks-per-sec",1); int t0=rtimer;
ring Y=32029,(y(1..17)),dp; execute("ideal K="+read("docs/evidence/a5-exceptional-fibers/working/distribute/out/a5-p2-iso/iso_p2/d2/relations-d2.rel")+";");
ideal Z=std(K+ideal(5453*y(1)+3782*y(2)+8025*y(3)+9540*y(4)+9099*y(5)+5170*y(6)+16706*y(7)+13651*y(8)+14720*y(9)+29272*y(10)+31253*y(11)+20401*y(12)+16288*y(13)+18278*y(14)+21186*y(15)+24217*y(16)+2323*y(17),15642*y(1)+20304*y(2)+21672*y(3)+14428*y(4)+15653*y(5)+6578*y(6)+29488*y(7)+26961*y(8)+12991*y(9)+7457*y(10)+18083*y(11)+15587*y(12)+10220*y(13)+28054*y(14)+15493*y(15)+11415*y(16)+4150*y(17),2655*y(1)+3515*y(2)+29478*y(3)+24745*y(4)+8923*y(5)+26892*y(6)+23342*y(7)+23129*y(8)+80*y(9)+21597*y(10)+1315*y(11)+20325*y(12)+26637*y(13)+18202*y(14)+13801*y(15)+31695*y(16)+12748*y(17),30781*y(1)+9316*y(2)+21403*y(3)+19596*y(4)+26520*y(5)+24794*y(6)+1923*y(7)+9288*y(8)+23065*y(9)+27494*y(10)+18697*y(11)+23372*y(12)+15488*y(13)+19401*y(14)+26108*y(15)+29796*y(16)+8401*y(17)));
"RESULT p32029 section 18 dim", dim(Z), "deg", mult(Z);
ideal A=std(Z+ideal(y(1)-1));
"RESULT p32029 section 18 affine vdim", vdim(A);
int j; string fd; poly e=eliminate(A, product(maxideal(1))/y(2))[1]; list F=factorize(e); for (j=2;j<=size(F[1]);j++) { fd=fd+" "+string(deg(F[1][j]))+"^"+string(F[2][j]); }
"RESULT p32029 section 18 eliminant y(2) deg", deg(e), "factor degree^multiplicity", fd, "s", rtimer-t0;
quit;
