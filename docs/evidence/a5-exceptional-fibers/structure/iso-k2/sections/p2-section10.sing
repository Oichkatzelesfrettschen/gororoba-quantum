LIB "general.lib"; option(redSB); system("--ticks-per-sec",1); int t0=rtimer;
ring Y=32029,(y(1..17)),dp; execute("ideal K="+read("docs/evidence/a5-exceptional-fibers/working/distribute/out/a5-p2-iso/iso_p2/d2/relations-d2.rel")+";");
ideal Z=std(K+ideal(739*y(1)+13340*y(2)+6891*y(3)+5781*y(4)+4304*y(5)+14690*y(6)+14382*y(7)+16171*y(8)+21592*y(9)+401*y(10)+17949*y(11)+12262*y(12)+25888*y(13)+706*y(14)+25815*y(15)+30606*y(16)+22851*y(17),21299*y(1)+6661*y(2)+18897*y(3)+31792*y(4)+5190*y(5)+1282*y(6)+16832*y(7)+11049*y(8)+4355*y(9)+5408*y(10)+15802*y(11)+16722*y(12)+23764*y(13)+10670*y(14)+1048*y(15)+4733*y(16)+24320*y(17),9620*y(1)+27342*y(2)+8225*y(3)+20577*y(4)+12095*y(5)+20977*y(6)+17596*y(7)+11776*y(8)+9709*y(9)+14425*y(10)+12144*y(11)+8119*y(12)+30422*y(13)+10914*y(14)+23062*y(15)+17960*y(16)+8032*y(17),21288*y(1)+3011*y(2)+14748*y(3)+21070*y(4)+3963*y(5)+26019*y(6)+6552*y(7)+30897*y(8)+3913*y(9)+18260*y(10)+1296*y(11)+19375*y(12)+18168*y(13)+4192*y(14)+29212*y(15)+26037*y(16)+21035*y(17)));
"RESULT p32029 section 10 dim", dim(Z), "deg", mult(Z);
ideal A=std(Z+ideal(y(1)-1));
"RESULT p32029 section 10 affine vdim", vdim(A);
int j; string fd; poly e=eliminate(A, product(maxideal(1))/y(2))[1]; list F=factorize(e); for (j=2;j<=size(F[1]);j++) { fd=fd+" "+string(deg(F[1][j]))+"^"+string(F[2][j]); }
"RESULT p32029 section 10 eliminant y(2) deg", deg(e), "factor degree^multiplicity", fd, "s", rtimer-t0;
quit;
