int nK=size(K); int nL=size(Lam); int nP=0; int nQ=0;
if (@HAS_P@) { nP=size(P); nQ=size(Qq); }
map ev=Y,yv[1],yv[2],yv[3],yv[4],yv[5],yv[6],yv[7],yv[8],yv[9],yv[10],yv[11],yv[12],yv[13],yv[14],yv[15],yv[16],yv[17],yv[18],yv[19],yv[20],yv[21],yv[22],yv[23],yv[24];
ideal eK=ev(K); ideal eL=ev(Lam);
res("on control: K2 generators nonzero at G_2(u): "+string(size(eK))+" of "+string(nK)+" (0 required); Lambda forms nonzero: "+string(size(eL))+" of "+string(nL)+" (0 for C20)");
if (@HAS_P@) {
  ideal eP=ev(P); ideal eQ=ev(Qq);
  res("on control: P generators nonzero: "+string(size(eP))+" of "+string(nP)+" (0 for C20); K2:P generators nonzero: "+string(size(eQ))+" of "+string(nQ)+" (positive: the point is off C30)");
}
