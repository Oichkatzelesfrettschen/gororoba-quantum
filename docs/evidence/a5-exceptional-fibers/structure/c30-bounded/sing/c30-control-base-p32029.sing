// c30-control-base-p32029: off control: plane over a point of the strict transform of L0 outside the exceptional quadric, prime 32029
// header docs/evidence/a5-exceptional-fibers/working/build/inputs/p32029-r9115/w8-nm.sing (sha256 20d00f15fd8f35c9bc5f0e4a998508244e4eba8662c0c20fbf8690e1bff384dc); values: docs/evidence/anu_qrng/draw-2026-11-08T182935Z.json, keys in points.json
LIB "linalg.lib"; LIB "general.lib"; LIB "matrix.lib"; system("--ticks-per-sec",1); int t0=rtimer;
proc res(string m) { string l="RESULT c30-control-base-p32029 "+m; print(l); write(":a docs/evidence/a5-exceptional-fibers/structure/c30-bounded/logs/c30-control-base-p32029.result", l); }
< "docs/evidence/a5-exceptional-fibers/working/build/inputs/p32029-r9115/w8-nm.sing";

ring rg=32029,(s,v2,v4,v5,v6,v7,v9),dp;
int pb=11358; int pc=21801; int s0=20678;
map phi=r,s,s*v2,s*(v4+pb),s*(v5+pc),s*(v6+pb),s*(v7+pc),s*v9;
ideal Gs=phi(G); ideal Jsi=phi(J); poly Js=Jsi[1];
int i; int k; int m; poly acc; ideal Gp; poly q; int divBad=0;
for (i=1;i<=ncols(Gs);i++) { q=Gs[i]/s^2; if (q*s^2!=Gs[i]) { divBad++; } Gp[i]=q; }
poly Jp=Js/s^2; if (Jp*s^2!=Js) { divBad++; }
map sh=rg,s+s0,v2,v4,v5,v6,v7,v9;
ideal Gc=sh(Gp); ideal Jc=sh(Jp);
map zero=rg,0,0,0,0,0,0,0;
res("off control: J and G not divisible by s^2 (0 required) "+string(divBad)+"; J' at the point (0 required) "+string(zero(Jc)[1])+"; generators of G' nonzero at the point (0 required) "+string(size(zero(Gc))));
matrix JG=jacob(Gc); matrix JG0=zero(JG); matrix dJ=jacob(Jc); matrix dJ0=zero(dJ);
int a0=0; for (k=1;k<=7;k++) { if (dJ0[1,k]!=0 && a0==0) { a0=k; } }
number den=leadcoef(dJ0[1,a0]);
matrix Kv[6][7]; int row=0;
for (k=1;k<=7;k++) { if (k!=a0) { row++; Kv[row,k]=1; Kv[row,a0]=-leadcoef(dJ0[1,k])/den; } }
intmat PLi[24][6];
for (k=1;k<=6;k++) { for (i=1;i<=24;i++) { acc=0; for (m=1;m<=7;m++) { acc=acc+JG0[i,m]*Kv[k,m]; } PLi[i,k]=int(leadcoef(acc)); } }

ring Y=32029,(y(1..24)),dp;
execute("ideal K="+read("docs/evidence/a5-exceptional-fibers/working/distribute/out/a5-p2-w8/w8_p2/d2/relations-upto-d2.rel")+";");
ideal Lam=y(22),y(19)+y(21),y(18),y(13)-y(23),y(11)+9115*y(23),y(8)+y(24),y(4)+y(12)-y(24),y(3),y(2)+9115*y(24);

int nK=size(K); int nL=size(Lam); int jj; int kk;
ring Z=32029,(Y1,Y2,Y3,Y4,Y5,Y6),dp;
matrix PM[24][6]; for (jj=1;jj<=24;jj++) { for (kk=1;kk<=6;kk++) { PM[jj,kk]=PLi[jj,kk]; } }
res("off control: rank of the gradient of G' on the tangent space of B at the point (3 expected): "+string(rank(PM)));
ideal im; for (jj=1;jj<=24;jj++) { im[jj]=PLi[jj,1]*Y1+PLi[jj,2]*Y2+PLi[jj,3]*Y3+PLi[jj,4]*Y4+PLi[jj,5]*Y5+PLi[jj,6]*Y6; }
map psi=Y,im;
ideal iK=psi(K);
res("off control: K2 generators nonzero on the plane over the point: "+string(size(iK))+" of "+string(nK)+" (positive: the fibre over a point off the origin is not in V(K2))");

quit;
