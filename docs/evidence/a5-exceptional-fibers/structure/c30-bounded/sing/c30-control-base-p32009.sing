proc res(string m) { string l="RESULT c30-control-base-p32009 "+m; print(l); write(":a docs/evidence/a5-exceptional-fibers/structure/c30-bounded/logs/c30-control-base-p32009.result", l); }
< "docs/evidence/a5-exceptional-fibers/working/build/inputs/p32009-r10754/w8-nm.sing";

ring rg=32009,(s,v2,v4,v5,v6,v7,v9),dp;
int pb=5418; int pc=10548; int s0=19622;
map phi=r,s,s*v2,s*(v4+pb),s*(v5+pc),s*(v6+pb),s*(v7+pc),s*v9;
ideal Gs=phi(G); ideal Jsi=phi(J); poly Js=Jsi[1];
int i; int k; int m; poly acc; ideal Gp; poly q;
for (i=1;i<=ncols(Gs);i++) { q=Gs[i]/s^2; Gp[i]=q; }
poly Jp=Js/s^2;
map sh=rg,s+s0,v2,v4,v5,v6,v7,v9;
ideal Gc=sh(Gp); ideal Jc=sh(Jp);
