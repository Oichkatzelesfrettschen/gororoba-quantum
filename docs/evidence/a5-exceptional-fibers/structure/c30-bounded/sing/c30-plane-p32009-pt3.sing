  d4=tr(Mi[1,1]*Fa+Mi[1,2]*Fb+Mi[1,3]*FJ,NN); d5=tr(Mi[2,1]*Fa+Mi[2,2]*Fb+Mi[2,3]*FJ,NN); d9=tr(Mi[3,1]*Fa+Mi[3,2]*Fb+Mi[3,3]*FJ,NN);
  x4=tr(x4-d4,NN); x5=tr(x5-d5,NN); x9=tr(x9-d9,NN);
 }
 resTotal=resTotal+size(Fa)+size(Fb)+size(FJ);
 ideal H3; poly h; int bad=0;
 for (i=1;i<=24;i++) { h=tr(subst(subst(subst(Gq[i],v4,x4),v5,x5),v9,x9),NN); if (subst(h,v2,0)!=0) { bad++; } H3[i]=h/v2; }
 badTotal=badTotal+bad;
 poly a4=diff(Jlin,v4); poly a5=diff(Jlin,v5); poly a9=diff(Jlin,v9);
 poly r4=dd(-a4,a9); poly r5=dd(-a5,a9);
 poly v9sol=r4*v4+r5*v5;
 poly lj; poly l2; poly l4; poly l5; poly A2; poly A4; poly A5; poly B2; poly B4; poly B5;
 lj=subst(jet(Gq[ia],1,wt)-jet(Gq[ia],0,wt),v9,v9sol); A2=diff(lj,v2); A4=diff(lj,v4); A5=diff(lj,v5);
 lj=subst(jet(Gq[ib],1,wt)-jet(Gq[ib],0,wt),v9,v9sol); B2=diff(lj,v2); B4=diff(lj,v4); B5=diff(lj,v5);
 poly det2=tr(A4*B5-A5*B4,1);
 if (dir==1) { det2n=leadcoef(subst(det2,ep,0)); }
