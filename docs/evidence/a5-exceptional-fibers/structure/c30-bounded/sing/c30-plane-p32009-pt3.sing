proc tr(poly f, int n) { return(jet(jet(f,n,wt),1,wep)); }
proc dd(poly x, poly d) {
  number x0=leadcoef(subst(x,ep,0)); number x1=leadcoef(subst(diff(x,ep),ep,0));
  number d0=leadcoef(subst(d,ep,0)); number d1=leadcoef(subst(diff(d,ep),ep,0));
