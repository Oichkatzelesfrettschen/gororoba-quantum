execute("ideal Qq="+read("docs/evidence/a5-exceptional-fibers/structure/w8-kp/quotient.txt")+";");
ideal Lam=y(22),y(19)+y(21),y(18),y(13)-y(23),y(11)+10754*y(23),y(8)+y(24),y(4)+y(12)-y(24),y(3),y(2)+10754*y(24);

