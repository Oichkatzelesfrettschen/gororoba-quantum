 ideal Gq=subst(subst(Gp,v6,0),v7,0); poly Jq=subst(subst(Jp,v6,0),v7,0);
 poly Jlin=jet(Jq,1,wt);
 matrix M[3][3];
 M[1,1]=subst(diff(Gq[ia],v4),s,0); M[1,2]=subst(diff(Gq[ia],v5),s,0); M[1,3]=subst(diff(Gq[ia],v9),s,0);
 M[2,1]=subst(diff(Gq[ib],v4),s,0); M[2,2]=subst(diff(Gq[ib],v5),s,0); M[2,3]=subst(diff(Gq[ib],v9),s,0);
 M[3,1]=diff(Jq,v4); M[3,2]=diff(Jq,v5); M[3,3]=diff(Jq,v9);
 M=subst(subst(subst(subst(M,s,0),v2,0),v4,0),v5,0); M=subst(M,v9,0);
