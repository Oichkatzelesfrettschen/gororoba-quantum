ideal VBc=z8,-z1^2 - z2^2 + z3^2 - z4^2 + z5^2 + z6^2 - z7^2,-z9^2 - z10^2 + z11^2 - z12^2 + z13^2 + z14^2 - z15^2,-z1*z9 - z2*z10 + z3*z11 - z4*z12 + z5*z13 + z6*z14 - z7*z15,-z2*z9 + z1*z10,-z3*z9 + z1*z11,-z4*z9 + z1*z12,-z5*z9 + z1*z13,-z6*z9 + z1*z14,-z7*z9 + z1*z15,-z3*z10 + z2*z11,-z4*z10 + z2*z12,-z5*z10 + z2*z13,-z6*z10 + z2*z14,-z7*z10 + z2*z15,-z4*z11 + z3*z12,-z5*z11 + z3*z13,-z6*z11 + z3*z14,-z7*z11 + z3*z15,-z5*z12 + z4*z13,-z6*z12 + z4*z14,-z7*z12 + z4*z15,-z6*z13 + z5*z14,-z7*z13 + z5*z15,-z7*z14 + z6*z15;
setring s;
proc thru(ideal X){ list L=minAssGTZ(X); list T; int c=0; for(int i=1;i<=size(L);i++){ if(size(reduce(L[i],std(maxideal(1))))==0){c++; T[c]=std(L[i]);} } return(T); }
proc same(ideal A, ideal B){ return(size(reduce(A,B))==0 && size(reduce(B,A))==0); }
list PB=thru(std(J+FullF)); list P9=thru(std(J+sliceMap(B9c))); list PV=thru(std(J+sliceMap(VBc)));
"RESULT germ_dim", dim(J);
"RESULT base_primes", size(PB);
int bd=-1; for(int i=1;i<=size(PB);i++){ if(dim(PB[i])>bd){bd=dim(PB[i]);} }
"RESULT base_dim", bd;
int eq9=(size(PB)==1 && size(P9)==1); if(eq9){ eq9=same(PB[1],P9[1]); }
"RESULT base_equals_b9", eq9;
if(eq9){
  list PQ=thru(std(quotient(J+FullF,P9[1]))); int qd=-1;
  for(int i=1;i<=size(PQ);i++){ if(dim(PQ[i])>qd){qd=dim(PQ[i]);} }
  "RESULT residual_primes", size(PQ); "RESULT residual_dim", qd;
  int eqv=(size(PQ)==1 && size(PV)==1); if(eqv){ eqv=same(PQ[1],PV[1]); }
  "RESULT residual_equals_vb", eqv;
}
quit;
