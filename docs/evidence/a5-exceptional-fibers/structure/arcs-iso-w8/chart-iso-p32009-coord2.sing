poly a0=G[2];
ideal C=J; int i; for (i=1;i<=17;i++) { if (i!=2) { C=C+(a0*z(i)-G[i]); } } C=C+(z(2)-1);
def SS=sat(C,ideal(a0)); ideal S; if (typeof(SS)=="list") { S=SS[1]; } else { S=SS; }
"RESULT iso-p32009-coord2 saturation done s", rtimer-t0;
write(":w chart-sat-iso-p32009-coord2.txt", S);
S=std(S); "RESULT iso-p32009-coord2 chart dim", dim(S), "s", rtimer-t0;
write(":w chart-std-iso-p32009-coord2.txt", S);
ideal E=std(S+ideal(t2,t3,t4,t5,t6,t7)); "RESULT iso-p32009-coord2 fiber over the origin in the chart: dim", dim(E), "degree", mult(E), "s", rtimer-t0;
write(":w chart-fiber-iso-p32009-coord2.txt", E);
quit;
