// t-space slice xpnm-p32009-k2-satG: k = 2 forms, saturation by ideal(G); header docs/evidence/a5-exceptional-fibers/working/build/inputs/p32009-r10754/xp-nm.sing (sha256 54d3166188cb56a45e2b0d4d0be6da73bbf757de0d6dedc6586d396e201cf280)
// forms l1..l2: docs/evidence/anu_qrng/draw-2026-11-06T113431Z.json, key x-l1..x-l2 of forms.json (values below 32009, index order)
LIB "elim.lib"; LIB "general.lib"; system("--ticks-per-sec",1); int t0=rtimer; string rl;
< "docs/evidence/a5-exceptional-fibers/working/build/inputs/p32009-r10754/xp-nm.sing";
poly l1=27367*G[1]+3861*G[2]+29705*G[3];
poly l2=24460*G[1]+8493*G[2]+9529*G[3];
ideal Q=J,l1,l2;
ideal S0=G;
rl="RESULT xpnm-p32009-k2-satG "+"start: variables "+string(nvars(basering))+", forms 2, size(Q) "+string(size(Q))+", s "+string(rtimer-t0); print(rl); write(":a docs/evidence/a5-exceptional-fibers/structure/arcs-iso-w8/tslice/logs/xpnm-p32009-k2-satG.result", rl);
def SS=sat_with_exp(Q,S0); ideal S=SS[1]; int ex=SS[2];
rl="RESULT xpnm-p32009-k2-satG "+"saturation done: generators "+string(size(S))+", exponent "+string(ex)+", s "+string(rtimer-t0); print(rl); write(":a docs/evidence/a5-exceptional-fibers/structure/arcs-iso-w8/tslice/logs/xpnm-p32009-k2-satG.result", rl);
S=std(S);
rl="RESULT xpnm-p32009-k2-satG "+"standard basis of the saturation: generators "+string(size(S))+", s "+string(rtimer-t0); print(rl); write(":a docs/evidence/a5-exceptional-fibers/structure/arcs-iso-w8/tslice/logs/xpnm-p32009-k2-satG.result", rl);
int dm=dim(S); int dg=0; if (dm>=0) { dg=mult(S); }
rl="RESULT xpnm-p32009-k2-satG "+"dim "+string(dm)+" degree "+string(dg)+" s "+string(rtimer-t0); print(rl); write(":a docs/evidence/a5-exceptional-fibers/structure/arcs-iso-w8/tslice/logs/xpnm-p32009-k2-satG.result", rl);
int on=(size(reduce(S,std(maxideal(1))))==0);
rl="RESULT xpnm-p32009-k2-satG "+"origin on the closure (all generators vanish at 0) "+string(on)+" s "+string(rtimer-t0); print(rl); write(":a docs/evidence/a5-exceptional-fibers/structure/arcs-iso-w8/tslice/logs/xpnm-p32009-k2-satG.result", rl);
quit;
