rl="RESULT iso-p32009-k5-satt2 "+"start: variables "+string(nvars(basering))+", forms 5, size(Q) "+string(size(Q))+", s "+string(rtimer-t0); print(rl); write(":a docs/evidence/a5-exceptional-fibers/structure/arcs-iso-w8/tslice/logs/iso-p32009-k5-satt2.result", rl);
