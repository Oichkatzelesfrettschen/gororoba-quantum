int dm=dim(S); int dg=0; if (dm>=0) { dg=mult(S); }
rl="RESULT iso-p32009-k5-satt2 "+"dim "+string(dm)+" degree "+string(dg)+" s "+string(rtimer-t0); print(rl); write(":a docs/evidence/a5-exceptional-fibers/structure/arcs-iso-w8/tslice/logs/iso-p32009-k5-satt2.result", rl);
int on=(size(reduce(S,std(maxideal(1))))==0);
