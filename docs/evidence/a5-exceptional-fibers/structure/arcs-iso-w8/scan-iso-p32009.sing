execute("ideal Grun="+read("docs/evidence/a5-exceptional-fibers/working/distribute/out/a5-iso-d4/iso_p1/d2/gens.txt")+";");
intvec eps; int jj; for (jj=1;jj<=ncols(G);jj++) { if (Grun[jj]==G[jj]) { eps[jj]=1; } else { if (Grun[jj]==-G[jj]) { eps[jj]=-1; } else { ERROR("generator "+string(jj)+" is not +-G"); } } }
"RESULT signs of the run generators against the header", eps;
execute("ring Y=32009,(y(1..17)),dp;");
execute("ideal K="+read("docs/evidence/a5-exceptional-fibers/working/runs/s3/iso_k2.rel")+";");
ring R=32009,(s,C,D,T,Z),dp;
number I=imap(r,I);
intvec sw=1,0,0,0,0;
proc lowest(ideal Gs, intvec sw) { int k; int j; for (k=0;k<=60;k++) { for (j=1;j<=ncols(Gs);j++) { if (jet(Gs[j],k,sw)!=0) { return(k); } } } return(-1); }
poly A=s^1; poly Cc=C*s^1; poly Dd=D*s^1; poly T7=T*s^1;
poly num=0+Cc*Dd-T7^2; poly B=num/A;
map phi=r,(A+B)/2,Z*s^1,(A-B)/(2*I),(Cc+Dd)/2,(Cc-Dd)/(2*I),T7;
ideal Gs=phi(G); int nu=lowest(Gs,sw); ideal F; int j;
for (j=1;j<=ncols(Gs);j++) { F[j]=subst(jet(Gs[j],nu,sw)-jet(Gs[j],nu-1,sw),s,1); }
matrix M=concat(jacob(F),transpose(matrix(F)));
map p1=R,0,2,3,5,7; map p2=R,0,13,4,9,6;
ideal Fr; for (j=1;j<=ncols(F);j++) { Fr[j]=eps[j]*F[j]; } map back=Y,Fr; ideal kk=back(K);
"RESULT a1_c1_d1_t71_t31 J", phi(J)==0, "nu", nu, "rank", rank(p1(M)), rank(p2(M)), "K2", size(simplify(kk,2))==0,  "zeroF", size(simplify(F,2))==0;
kill A,Cc,Dd,T7,num,B,phi,Gs,nu,F,Fr,j,M,p1,p2,back,kk;
