execute("ideal Grun="+read("docs/evidence/a5-exceptional-fibers/working/distribute/out/a5-iso-d4/iso_p1/d2/gens.txt")+";");
intvec eps; int jj; for (jj=1;jj<=ncols(G);jj++) { if (Grun[jj]==G[jj]) { eps[jj]=1; } else { if (Grun[jj]==-G[jj]) { eps[jj]=-1; } else { ERROR("generator is not +-G"); } } }
poly a0=18848*G[1]+15873*G[2]+1777*G[3]+21891*G[4]+15131*G[5]+1866*G[6]+18266*G[7]+3918*G[8]+27346*G[9]+29471*G[10]+14854*G[11]+14018*G[12]+133*G[13]+23303*G[14]+15268*G[15]+7689*G[16]+7355*G[17];
ideal Lam=18848*z(1)+15873*z(2)+1777*z(3)+21891*z(4)+15131*z(5)+1866*z(6)+18266*z(7)+3918*z(8)+27346*z(9)+29471*z(10)+14854*z(11)+14018*z(12)+133*z(13)+23303*z(14)+15268*z(15)+7689*z(16)+7355*z(17)-1,21750*z(1)+1459*z(2)+1005*z(3)+12521*z(4)+1932*z(5)+27013*z(6)+12613*z(7)+27727*z(8)+961*z(9)+7363*z(10)+22910*z(11)+25771*z(12)+6054*z(13)+28147*z(14)+2128*z(15)+23464*z(16)+2206*z(17),16226*z(1)+427*z(2)+317*z(3)+30317*z(4)+20375*z(5)+29522*z(6)+5258*z(7)+20396*z(8)+21877*z(9)+9596*z(10)+12824*z(11)+31456*z(12)+12750*z(13)+26108*z(14)+25857*z(15)+10487*z(16)+27202*z(17),24241*z(1)+29292*z(2)+1330*z(3)+2472*z(4)+27950*z(5)+9079*z(6)+16451*z(7)+17152*z(8)+18923*z(9)+3208*z(10)+1491*z(11)+23510*z(12)+6943*z(13)+21013*z(14)+10330*z(15)+24757*z(16)+15113*z(17),13218*z(1)+14568*z(2)+15498*z(3)+1746*z(4)+405*z(5)+25632*z(6)+27198*z(7)+29813*z(8)+2797*z(9)+9270*z(10)+25870*z(11)+28068*z(12)+14305*z(13)+4800*z(14)+29116*z(15)+26669*z(16)+17531*z(17);
ring Y=32009,(y(1..17)),dp; execute("ideal K="+read("docs/evidence/a5-exceptional-fibers/working/runs/s3/iso_k2.rel")+";");
setring r; ideal epz; for (jj=1;jj<=ncols(G);jj++) { epz[jj]=eps[jj]*z(jj); } map toz=Y,epz;
ideal Kz=toz(K);
ideal KS=std(Kz+Lam+ideal(t2,t3,t4,t5,t6,t7));
"RESULT iso-p32009-slice K2 slice: dim", dim(KS), "vdim", vdim(KS), "s", rtimer-t0;
poly sepv=z(2); ideal els=eliminate(KS, product(maxideal(1))/sepv); list fs=factorize(els[1]); string fd; for (jj=2;jj<=size(fs[1]);jj++) { fd=fd+" "+string(deg(fs[1][jj]))+"^"+string(fs[2][jj]); }
"RESULT iso-p32009-slice K2 slice eliminant of z(2): deg", deg(els[1]), "factors", fd;
ideal C=J; int i; for (i=1;i<=17;i++) { C=C+(a0*z(i)-G[i]); } C=C+Lam;
def SS=sat(C,ideal(a0)); ideal S; if (typeof(SS)=="list") { S=SS[1]; } else { S=SS; }
"RESULT iso-p32009-slice saturation done s", rtimer-t0;
write(":w chart-sat-iso-p32009-slice.txt", S);
S=std(S); "RESULT iso-p32009-slice sliced chart dim", dim(S), "s", rtimer-t0;
ideal E=std(S+ideal(t2,t3,t4,t5,t6,t7));
"RESULT iso-p32009-slice fiber over the origin: dim", dim(E), "vdim", vdim(E), "s", rtimer-t0;
write(":w chart-fiber-iso-p32009-slice.txt", E);
"RESULT iso-p32009-slice K2 vanishes on the fiber", size(reduce(Kz,E))==0, "fiber inside the K2 slice", size(reduce(KS,E))==0, "K2 slice inside the fiber", size(reduce(E,KS))==0;
quit;
