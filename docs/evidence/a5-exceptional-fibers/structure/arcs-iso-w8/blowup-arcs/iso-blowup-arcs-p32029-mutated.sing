t6^2*t7-8*t2*t3*t5*t7^2-2*t4*t5^2*t7^2+2*t5^2*t6*t7^2+20*t3^3*t4-20*t3^3*t6+4*t3*t4^2*t6-4*t3*t4*t6^2-28*t2*t3^2*t7-4*t3*t4*t5*t7+4*t2*t4*t6*t7+4*t3*t5*t6*t7-4*t2*t5*t7^2+20*t3^2*t4-20*t3^2*t6+4*t4^2*t6-4*t4*t6^2-24*t2*t3*t7-4*t4*t5*t7+4*t5*t6*t7+8*t3*t4-8*t3*t6-8*t2*t7,-13799*t3^5*t5-4431*t2*t3^4*t6+4431*t2*t3^2*t4*t6^2+13799*t3*t4^2*t5*t6^2+13799*t3^5*t7-4431*t2*t3^2*t5*t6*t7+4431*t3*t4*t5^2*t6*t7-13799*t3*t4^2*t6^2*t7+13799*t3*t5^3*t7^2-4431*t3*t4*t5*t6*t7^2-13799*t3*t5^2*t7^3-4937*t3^4*t5+14305*t2*t3^3*t6+8862*t2*t3*t4*t6^2+13799*t4^2*t5*t6^2+4937*t3^4*t7-8862*t2*t3*t5*t6*t7+4431*t4*t5^2*t6*t7-13799*t4^2*t6^2*t7+13799*t5^3*t7^2-4431*t4*t5*t6*t7^2-13799*t5^2*t7^3-9874*t3^3*t5+1012*t2*t3^2*t6+4431*t3*t4*t5*t6+4431*t2*t4*t6^2+9874*t3^3*t7-4431*t3*t5^2*t7-4431*t3*t4*t6*t7-4431*t2*t5*t6*t7+4431*t3*t5*t7^2-9874*t3^2*t5+5443*t2*t3*t6+4431*t4*t5*t6+9874*t3^2*t7-4431*t5^2*t7-4431*t4*t6*t7+4431*t5*t7^2+8862*t3*t5-8862*t2*t6-8862*t3*t7;
execute("ideal Grun="+read("docs/evidence/a5-exceptional-fibers/working/distribute/out/a5-p2-iso/iso_p2/d2/gens.txt")+";");
intvec eps; int jj; for (jj=1;jj<=ncols(G);jj++) { if (Grun[jj]==G[jj]) { eps[jj]=1; } else { if (Grun[jj]==-G[jj]) { eps[jj]=-1; } else { ERROR("generator "+string(jj)+" is not +-G"); } } }
"RESULT signs of the run generators against the header", eps;
execute("ring Y=32029,(y(1..17)),dp;");
execute("ideal K="+read("docs/evidence/a5-exceptional-fibers/working/distribute/out/a5-p2-iso/iso_p2/d2/relations-d2.rel")+";");
"RESULT K2 generators", size(K);
ring S=32029,(s,b,c,V,A),dp;
intvec sw=1,0,0,0,0;
poly Q=2*b; poly T=2*c; poly U2=b*V*s; poly R=b^2*V*s+b*A*s^2;
poly P=(R*T-(0))/(2*b);
map phi=r,s*U2,s,s*(Q+P)/2,s*(T+R)/2,s*(Q-P)/2,s*(T-R)/2;
"RESULT J on the arc", size(simplify(phi(J),2))==0;
ideal Gs=phi(G); int j; int k; int nu=-1;
for (k=0;k<=8 and nu<0;k++) { for (j=1;j<=ncols(Gs);j++) { if (jet(Gs[j],k,sw)!=0) { nu=k; } } }
ideal F; for (j=1;j<=ncols(Gs);j++) { F[j]=subst(jet(Gs[j],nu,sw)-jet(Gs[j],nu-1,sw),s,1); }
ideal Fr; for (j=1;j<=ncols(F);j++) { Fr[j]=eps[j]*F[j]; } map back=Y,Fr;
matrix M=concat(jacob(F),transpose(matrix(F)));
map p1=S,0,2,3,5,7; map p2=S,0,13,4,9,6;
"RESULT nu", nu, "nonzero limit entries", size(simplify(F,2));
"RESULT K2 nonzero on the limit", size(simplify(back(K),2));
"RESULT rank of [dF | F] at two points", rank(p1(M)), rank(p2(M));
quit;
