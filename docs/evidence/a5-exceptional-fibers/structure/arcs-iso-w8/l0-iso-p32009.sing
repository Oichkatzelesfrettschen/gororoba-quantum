ideal L0=t2,t4-t6,t5-t7;
"RESULT G vanishes on L0", size(reduce(G,std(L0)))==0;
list mp=minAssGTZ(J+G); int j; int c; for (j=1;j<=size(mp);j++) { if (size(reduce(mp[j],std(maxideal(1))))==0) { c++; "RESULT prime of V(J+G) through 0:", j, "dim", dim(std(mp[j])), "equals L0", size(reduce(mp[j],std(L0)))==0 && size(reduce(L0,std(mp[j])))==0; } }
"RESULT primes of V(J+G) through 0", c;
proc low(poly g) { int k; for (k=0;k<=20;k++) { if (jet(g,k)!=0) { return(k); } } return(-1); }
ideal q; for (j=1;j<=ncols(G);j++) { if (low(G[j])==2) { q=q+jet(G[j],2); } }
ideal B=std(q+jet(J[1],2)); list bp=minAssGTZ(q+jet(J[1],2));
"RESULT quadratic parts on the tangent cone: dim", dim(B), "degree", mult(B), "minimal primes", size(bp), "the prime is L0", size(reduce(bp[1],std(L0)))==0 && size(reduce(L0,std(bp[1])))==0;
quit;
