// iso-control-base-p32009: off control: first-order fiber over a point of L0 away from the origin, prime 32009
// header docs/evidence/a5-exceptional-fibers/working/build/inputs/p32009-r10754/iso-nm.sing (sha256 1f1757d55751f1e3b34605d78fc818e3b457349b7069a17240d0a5ff44713170); values: docs/evidence/anu_qrng/draw-2026-11-09T060635Z.json, keys in points.json
LIB "linalg.lib"; LIB "general.lib"; LIB "matrix.lib"; system("--ticks-per-sec",1); int t0=rtimer;
proc res(string m) { string l="RESULT iso-control-base-p32009 "+m; print(l); write(":a docs/evidence/a5-exceptional-fibers/structure/arcs-iso-w8/iso-planes/logs/iso-control-base-p32009.result", l); }
< "docs/evidence/a5-exceptional-fibers/working/build/inputs/p32009-r10754/iso-nm.sing";
execute("ideal Grun="+read("docs/evidence/a5-exceptional-fibers/working/distribute/out/a5-iso-d4/iso_p1/d2/gens.txt")+";");
intvec eps; int jj; for (jj=1;jj<=ncols(G);jj++) { if (Grun[jj]==G[jj]) { eps[jj]=1; } else { if (Grun[jj]==-G[jj]) { eps[jj]=-1; } else { ERROR("generator "+string(jj)+" is not +-G"); } } }
res("signs of the run generators against the header: "+string(eps));

// off control: the point (s0, 0, b, c, b, c) of the strict transform of L0, away from the exceptional divisor
ring rg=32009,(s,v2,v4,v5,v6,v7),dp;
int pb=507; int pc=9044; int s0=29214;
map phi=r,s*v2,s,s*(v4+pb),s*(v5+pc),s*(v6+pb),s*(v7+pc);
ideal Gs=phi(G); ideal Jsi=phi(J); poly Js=Jsi[1];
int i; int k; int m; poly acc; ideal Gp; poly q; int divBad=0;
for (i=1;i<=ncols(Gs);i++) { q=Gs[i]/s^2; if (q*s^2!=Gs[i]) { divBad++; } Gp[i]=q; }
poly Jp=Js/s^2; if (Jp*s^2!=Js) { divBad++; }
map sh=rg,s+s0,v2,v4,v5,v6,v7;
ideal Gc=sh(Gp); ideal Jc=sh(Jp);
map zero=rg,0,0,0,0,0,0;
res("off control: J and G not divisible by s^2 (0 required) "+string(divBad)+"; J' at the point (0 required) "+string(zero(Jc)[1])+"; generators of G' nonzero at the point (0 required) "+string(size(zero(Gc))));
matrix JG=jacob(Gc); matrix JG0=zero(JG); matrix dJ=jacob(Jc); matrix dJ0=zero(dJ);
int a0=0; for (k=1;k<=6;k++) { if (dJ0[1,k]!=0 && a0==0) { a0=k; } }
number den=leadcoef(dJ0[1,a0]);
matrix Kv[5][6]; int row=0;
for (k=1;k<=6;k++) { if (k!=a0) { row++; Kv[row,k]=1; Kv[row,a0]=-leadcoef(dJ0[1,k])/den; } }
intmat PLi[17][5];
for (k=1;k<=5;k++) { for (i=1;i<=17;i++) { acc=0; for (m=1;m<=6;m++) { acc=acc+JG0[i,m]*Kv[k,m]; } PLi[i,k]=int(leadcoef(acc)); } }

execute("ring Y=32009,(y(1..17)),dp;");
execute("ideal K="+read("docs/evidence/a5-exceptional-fibers/working/runs/s3/iso_k2.rel")+";");

int nK=size(K); int jj; int kk;
ring Z=32009,(Y1,Y2,Y3,Y4,Y5),dp;
matrix PM[17][5]; for (jj=1;jj<=17;jj++) { for (kk=1;kk<=5;kk++) { PM[jj,kk]=PLi[jj,kk]; } }
res("off control: rank of the gradient of G' on the tangent space of {J' = 0} at the point: "+string(rank(PM)));
ideal im; for (jj=1;jj<=17;jj++) { im[jj]=eps[jj]*(PLi[jj,1]*Y1+PLi[jj,2]*Y2+PLi[jj,3]*Y3+PLi[jj,4]*Y4+PLi[jj,5]*Y5); }
map psi=Y,im;
ideal iK=psi(K);
res("off control: K2 generators nonzero on the image of the tangent space: "+string(size(iK))+" of "+string(nK)+" (positive: the first-order fiber over a point off the origin is not in V(K2))");

quit;
