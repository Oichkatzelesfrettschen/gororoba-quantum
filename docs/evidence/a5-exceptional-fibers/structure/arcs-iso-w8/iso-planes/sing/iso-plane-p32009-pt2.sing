// iso-plane-p32009-pt2: fiber-cone plane over the point [0:17:29:17:29] of P(L0), smooth generator G'_9, prime 32009
// header docs/evidence/a5-exceptional-fibers/working/build/inputs/p32009-r10754/iso-nm.sing (sha256 1f1757d55751f1e3b34605d78fc818e3b457349b7069a17240d0a5ff44713170); values: docs/evidence/anu_qrng/draw-2026-11-09T060635Z.json, keys in points.json
LIB "linalg.lib"; LIB "general.lib"; LIB "matrix.lib"; system("--ticks-per-sec",1); int t0=rtimer;
proc res(string m) { string l="RESULT iso-plane-p32009-pt2 "+m; print(l); write(":a docs/evidence/a5-exceptional-fibers/structure/arcs-iso-w8/iso-planes/logs/iso-plane-p32009-pt2.result", l); }
< "docs/evidence/a5-exceptional-fibers/working/build/inputs/p32009-r10754/iso-nm.sing";
execute("ideal Grun="+read("docs/evidence/a5-exceptional-fibers/working/distribute/out/a5-iso-d4/iso_p1/d2/gens.txt")+";");
intvec eps; int jj; for (jj=1;jj<=ncols(G);jj++) { if (Grun[jj]==G[jj]) { eps[jj]=1; } else { if (Grun[jj]==-G[jj]) { eps[jj]=-1; } else { ERROR("generator "+string(jj)+" is not +-G"); } } }
res("signs of the run generators against the header: "+string(eps));
int pb0=17; int pc0=29; int NN=10; int ia=9; intvec Y0=3,5,7;

ring rg=32009,(s,v2,v4,v5,v6,v7,ep),dp;
intvec wt=1,1,1,1,1,1,0; intvec wep=0,0,0,0,0,0,1;
proc tr(poly f, int n) { return(jet(jet(f,n,wt),1,wep)); }
proc dd(poly x, poly d) {
  number x0=leadcoef(subst(x,ep,0)); number x1=leadcoef(subst(diff(x,ep),ep,0));
  number d0=leadcoef(subst(d,ep,0)); number d1=leadcoef(subst(diff(d,ep),ep,0));
  poly r=(x0/d0) + ep*((x1*d0-x0*d1)/(d0*d0));
  return(r);
}
int dir; list planeVal; list planeDer; int divTotal=0; int chkTotal=0; int badTotal=0; int resTotal=0; int sTotal=0;
number detM; number detA;
for (dir=1; dir<=2; dir++) {
 setring rg;
 poly pb=pb0; poly pc=pc0; if (dir==1) { pb=pb0+ep; } else { pc=pc0+ep; }
 map phi=r,s*v2,s,s*(v4+pb),s*(v5+pc),s*(v6+pb),s*(v7+pc);
 ideal Gs=phi(G); ideal Jsi=phi(J); poly Js=Jsi[1];
 int i; ideal Gp; poly q;
 for (i=1;i<=ncols(Gs);i++) { q=Gs[i]/s^2; if (q*s^2!=Gs[i]) { divTotal++; } Gp[i]=q; }
 poly Jp=Js/s^2; if (Jp*s^2!=Js) { divTotal++; }
 ideal Gq=subst(subst(Gp,v6,0),v7,0); poly Jq=subst(subst(Jp,v6,0),v7,0);
 poly Jlin=jet(Jq,1,wt);
 matrix M[2][2];
 M[1,1]=diff(Gq[ia],v4); M[1,2]=diff(Gq[ia],v5);
 M[2,1]=diff(Jq,v4); M[2,2]=diff(Jq,v5);
 M=subst(subst(subst(subst(M,s,0),v2,0),v4,0),v5,0);
 matrix M0=subst(M,ep,0); matrix M1=subst(diff(M,ep),ep,0);
 if (dir==1) { detM=leadcoef(det(M0)); }
 matrix Mi0=inverse(M0); matrix Mi=Mi0-ep*(Mi0*M1*Mi0);
 poly x4=0; poly x5=0; poly Fa; poly FJ; poly d4; poly d5;
 for (i=1;i<=NN+2;i++) {
  Fa=tr(subst(subst(Gq[ia],v4,x4),v5,x5),NN);
  FJ=tr(subst(subst(Jq,v4,x4),v5,x5),NN);
  d4=tr(Mi[1,1]*Fa+Mi[1,2]*FJ,NN); d5=tr(Mi[2,1]*Fa+Mi[2,2]*FJ,NN);
  x4=tr(x4-d4,NN); x5=tr(x5-d5,NN);
 }
 resTotal=resTotal+size(Fa)+size(FJ);
 ideal H3; poly h; int bad=0;
 for (i=1;i<=17;i++) { h=tr(subst(subst(Gq[i],v4,x4),v5,x5),NN); if (subst(h,v2,0)!=0) { bad++; } H3[i]=h/v2; }
 badTotal=badTotal+bad;
 poly a4=diff(Jlin,v4); poly a5=diff(Jlin,v5);
 poly r4=dd(-a4,a5);
 poly v5sol=r4*v4;
 poly lj; poly l2; poly l4; poly A2; poly A4; poly c1; poly al; poly be; int chk=0; int sc=0;
 lj=subst(jet(Gq[ia],1,wt)-jet(Gq[ia],0,wt),v5,v5sol); A2=diff(lj,v2); A4=diff(lj,v4);
 if (dir==1) { detA=leadcoef(subst(A4,ep,0)); }
 intmat V[17][3]; intmat D[17][3];
 for (i=1;i<=17;i++) {
  lj=jet(Gq[i],1,wt)-jet(Gq[i],0,wt);
  if (diff(lj,s)!=0) { sc++; }
  lj=subst(lj,v5,v5sol); l2=diff(lj,v2); l4=diff(lj,v4);
  c1=dd(l4,A4);
  if (size(tr(l2-c1*A2,1))!=0) { chk++; }
  al=diff(jet(H3[i],1,wt),s); be=diff(jet(H3[i],1,wt),v2);
  if (i==ia) { c1=1; al=0; be=0; }
  V[i,1]=int(leadcoef(subst(c1,ep,0))); V[i,2]=int(leadcoef(subst(al,ep,0))); V[i,3]=int(leadcoef(subst(be,ep,0)));
  D[i,1]=int(leadcoef(subst(diff(c1,ep),ep,0))); D[i,2]=int(leadcoef(subst(diff(al,ep),ep,0))); D[i,3]=int(leadcoef(subst(diff(be,ep),ep,0)));
 }
 chkTotal=chkTotal+chk; sTotal=sTotal+sc;
 if (dir==1) {
  // I3 = (s, v2) in k[[s, v2]] iff every generator vanishes at the origin and the linear parts span (s, v2)/(s, v2)^2
  // (Nakayama); both are read in the global ordering dp, from constant terms and a 17 x 2 coefficient rank.
  ring r2=32009,(s,v2),dp;
  ideal I3=imap(rg,H3); int i3const=0; matrix L3[ncols(I3)][2];
  for (i=1;i<=ncols(I3);i++) {
   if (jet(I3[i],0)!=0) { i3const++; }
   L3[i,1]=diff(jet(I3[i],1),s); L3[i,2]=diff(jet(I3[i],1),v2);
  }
  int i3rank=rank(L3);
  int i3unit=(i3const==0 && i3rank==2);
  setring rg;
 }
 planeVal[dir]=V; planeDer[dir]=D;
 kill Gs,Jsi,Js,Gp,q,Jp,Gq,Jq,Jlin,M,M0,M1,Mi0,Mi,x4,x5,Fa,FJ,d4,d5,H3,h,a4,a5,r4,v5sol,lj,l2,l4,A2,A4,c1,al,be,phi,pb,pc,V,D,bad,chk,sc,i;
}
res("point [1:0:"+string(pb0)+":"+string(pc0)+":"+string(pb0)+":"+string(pc0)+"] of P(L0), smooth generator G'_"+string(ia));
res("J and the generators of G not divisible by s^2 in the chart (0 required): "+string(divTotal)+"; Newton residual terms over both directions (0 required): "+string(resTotal)+"; generators not divisible by v2 on S (0 required): "+string(badTotal)+"; linear parts of G' with an s term (0 required): "+string(sTotal)+"; linear-part consistency failures (0 required): "+string(chkTotal));
res("determinant of the 2x2 Newton block "+string(detM)+", linear coefficient of G'_"+string(ia)+" on the tangent line of {J' = 0} in the slice "+string(detA)+" (nonzero required)");
res("I3 = (G'_j restricted to S, divided by v2): zero constant terms and linear parts of rank "+string(i3rank)+" (2 required), so it is the maximal ideal (s, v2) (1 required): "+string(i3unit));
intmat V1=planeVal[1]; intmat V2=planeVal[2]; intmat D1=planeDer[1]; intmat D2=planeDer[2];
res("values of M(p) agree between the two dual directions (1 required): "+string(V1==V2));

// membership, Jacobian rank and tangent consistency
execute("ring Y=32009,(y(1..17)),dp;");
execute("ideal K="+read("docs/evidence/a5-exceptional-fibers/working/runs/s3/iso_k2.rel")+";");

int nK=size(K); int j; int kk;
matrix TT[17][5]; matrix MMy[17][3]; matrix Y0m[3][1];
for (kk=1;kk<=3;kk++) { Y0m[kk,1]=Y0[kk]; }
for (j=1;j<=17;j++) {
  for (kk=1;kk<=3;kk++) { TT[j,kk]=eps[j]*V1[j,kk]; MMy[j,kk]=eps[j]*V1[j,kk]; }
  TT[j,4]=eps[j]*(D1[j,1]*Y0[1]+D1[j,2]*Y0[2]+D1[j,3]*Y0[3]);
  TT[j,5]=eps[j]*(D2[j,1]*Y0[1]+D2[j,2]*Y0[2]+D2[j,3]*Y0[3]);
}
matrix y0m=MMy*Y0m;
ideal ycoords; for (j=1;j<=17;j++) { ycoords[j]=y0m[j,1]; }
map ev=Y,ycoords;
ring Z=32009,(Y1,Y2,Y3),dp;
ideal im; for (j=1;j<=17;j++) { im[j]=eps[j]*(V1[j,1]*Y1+V1[j,2]*Y2+V1[j,3]*Y3); }
map psi=Y,im;
ideal iK=psi(K);
res("plane: K2 generators nonzero on Pi_p: "+string(size(iK))+" of "+string(nK)+" (0: Pi_p lies in V(K2))");
ideal im2=im; im2[1]=im[1]+eps[1]*Y1; map psi2=Y,im2; ideal iK2=psi2(K);
res("mutation: K2 generators nonzero on the plane with one coordinate of M(p) shifted by one (positive required): "+string(size(iK2))+" of "+string(nK));
matrix MZ[17][3]; for (j=1;j<=17;j++) { for (kk=1;kk<=3;kk++) { MZ[j,kk]=V1[j,kk]; } }
res("plane: rank of M(p) (3 required): "+string(rank(MZ)));
setring Y;
matrix JKm=jacob(K); matrix JK0=ev(JKm); matrix RK=JK0*TT;
res("tangent consistency: Jacobian of the K2 generators at y0 = M(p) Y0 against the five tangent vectors, nonzero entries (0 required): "+string(size(ideal(RK)))+"; rank of that Jacobian (12 at a smooth point of the 5-dimensional cone): "+string(rank(JK0)));
ideal eK0=ev(K);
res("point y0 = M(p) Y0: K2 generators nonzero "+string(size(eK0))+" (0 required)");
matrix TTc[17][5]; for (j=1;j<=17;j++) { for (kk=1;kk<=5;kk++) { TTc[j,kk]=TT[j,kk]; } }
res("rank of [M(p) | dM/db Y0 | dM/dc Y0] (5: the planes sweep a cone of dimension 5, so a 4-dimensional projective set, which is V(K2)): "+string(rank(TTc))+", s "+string(rtimer-t0));
// the M(p) of this script, in header order, for the cross-check case
write(":w docs/evidence/a5-exceptional-fibers/structure/arcs-iso-w8/iso-planes/logs/iso-plane-p32009-pt2.M", "intmat MP[17][3]="+string(V1)+";");

quit;
