// iso-linear-p32009: symbolic linear parts of J' and G' along P(L0), prime 32009
// header docs/evidence/a5-exceptional-fibers/working/build/inputs/p32009-r10754/iso-nm.sing (sha256 1f1757d55751f1e3b34605d78fc818e3b457349b7069a17240d0a5ff44713170); values: docs/evidence/anu_qrng/draw-2026-11-09T060635Z.json, keys in points.json
LIB "linalg.lib"; LIB "general.lib"; LIB "matrix.lib"; system("--ticks-per-sec",1); int t0=rtimer;
proc res(string m) { string l="RESULT iso-linear-p32009 "+m; print(l); write(":a docs/evidence/a5-exceptional-fibers/structure/arcs-iso-w8/iso-planes/logs/iso-linear-p32009.result", l); }
< "docs/evidence/a5-exceptional-fibers/working/build/inputs/p32009-r10754/iso-nm.sing";

// the 18 x 3 matrix of linear coefficients of J' and G'_1..G'_17 in (v2, v4, v5) on the slice v6 = v7 = 0, with b and c
// as variables: rank 2 over k(b, c) and every 3 x 3 minor identically zero say that dG' has rank 1 on the tangent
// space of {J' = 0, v6 = v7 = 0} at every point of P(L0) where dJ' is nonzero
ring rs=32009,(s,v2,v4,v5,v6,v7,b,c),dp;
map phi=r,s*v2,s,s*(v4+b),s*(v5+c),s*(v6+b),s*(v7+c);
ideal Gs=phi(G); ideal Js=phi(J);
int i; int dv=0; ideal Fp; poly q;
q=Js[1]/s^2; if (q*s^2!=Js[1]) { dv++; } Fp[1]=q;
for (i=1;i<=ncols(Gs);i++) { q=Gs[i]/s^2; if (q*s^2!=Gs[i]) { dv++; } Fp[i+1]=q; }
ideal Fq=subst(subst(Fp,v6,0),v7,0);
matrix Lm[18][3];
for (i=1;i<=ncols(Fq);i++) {
  Lm[i,1]=subst(subst(subst(subst(diff(Fq[i],v2),s,0),v2,0),v4,0),v5,0);
  Lm[i,2]=subst(subst(subst(subst(diff(Fq[i],v4),s,0),v2,0),v4,0),v5,0);
  Lm[i,3]=subst(subst(subst(subst(diff(Fq[i],v5),s,0),v2,0),v4,0),v5,0);
}
ideal M3=minor(Lm,3); ideal M2=minor(Lm,2);
res("symbolic linear parts in b, c: J and G not divisible by s^2 (0 required): "+string(dv)+"; nonzero 3x3 minors "+string(size(M3))+" of "+string(binomial(18,3))+" (0 required); nonzero 2x2 minors "+string(size(M2))+" (positive: rank 2 over k(b, c)); first row (dJ') "+string(Lm[1,1])+", "+string(Lm[1,2])+", "+string(Lm[1,3]));

quit;
