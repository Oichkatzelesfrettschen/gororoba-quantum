LIB "general.lib"; option(redSB); system("--ticks-per-sec",1); int t0=rtimer;
ring Y=32009,(y(1..24),t),dp; execute("ideal Q="+read("docs/evidence/a5-exceptional-fibers/working/runs/w8_a2/w8_k2.rel")+";");
ideal Lam=y(22),y(19)+y(21),y(18),y(13)-y(23),y(11)+10754*y(23),y(8)+y(24),y(4)+y(12)-y(24),y(3),y(2)+10754*y(24);
ideal KL=std(Q+Lam);
"RESULT K2+Lam projdim", dim(KL)-2, "degree", mult(KL);
ideal A=std(Q+Lam+ideal(14662*y(1)+14673*y(2)+24962*y(3)+10134*y(4)+24354*y(5)+15110*y(6)+8554*y(7)+7296*y(8)+23356*y(9)+22573*y(10)+3869*y(11)+26070*y(12)+22675*y(13)+24401*y(14)+14244*y(15)+7870*y(16)+4768*y(17)+12813*y(18)+8774*y(19)+4346*y(20)+15369*y(21)+14383*y(22)+17665*y(23)+14625*y(24),24622*y(1)+23085*y(2)+24907*y(3)+30656*y(4)+1108*y(5)+2040*y(6)+29757*y(7)+12113*y(8)+14651*y(9)+2354*y(10)+22838*y(11)+18938*y(12)+31898*y(13)+1791*y(14)+22515*y(15)+5756*y(16)+19102*y(17)+22285*y(18)+26114*y(19)+14617*y(20)+2666*y(21)+13065*y(22)+15290*y(23)+9491*y(24),4232*y(1)+13304*y(2)+26642*y(3)+2940*y(4)+1922*y(5)+28000*y(6)+28909*y(7)+10938*y(8)+668*y(9)+30856*y(10)+12175*y(11)+13314*y(12)+25625*y(13)+10258*y(14)+21310*y(15)+8638*y(16)+22626*y(17)+22789*y(18)+13374*y(19)+2755*y(20)+13567*y(21)+19887*y(22)+10468*y(23)+10702*y(24),30626*y(1)+22919*y(2)+15186*y(3)+22847*y(4)+11052*y(5)+16347*y(6)+23200*y(7)+2669*y(8)+15434*y(9)+4588*y(10)+27056*y(11)+21367*y(12)+18376*y(13)+20771*y(14)+28014*y(15)+6375*y(16)+20725*y(17)+221*y(18)+9381*y(19)+12838*y(20)+19499*y(21)+23131*y(22)+24102*y(23)+7780*y(24),16139*y(1)+18927*y(2)+14137*y(3)+6950*y(4)+6932*y(5)+6434*y(6)+30762*y(7)+21030*y(8)+31275*y(9)+22225*y(10)+26268*y(11)+13339*y(12)+7516*y(13)+838*y(14)+12260*y(15)+19033*y(16)+29969*y(17)+27448*y(18)+26040*y(19)+27169*y(20)+15436*y(21)+17095*y(22)+10558*y(23)+297*y(24))+ideal(6328*y(1)+26107*y(2)+28319*y(3)+29182*y(4)+18431*y(5)+10928*y(6)+18608*y(7)+9361*y(8)+2890*y(9)+2714*y(10)+22851*y(11)+15069*y(12)+16652*y(13)+25027*y(14)+11032*y(15)+9099*y(16)+10267*y(17)+14731*y(18)+30666*y(19)+19043*y(20)+10464*y(21)+8450*y(22)+15893*y(23)+28912*y(24)-1)+ideal(t-(26187*y(1)+30132*y(2)+9420*y(3)+25507*y(4)+5209*y(5)+17027*y(6)+23896*y(7)+12818*y(8)+1514*y(9)+6107*y(10)+6807*y(11)+25279*y(12)+2759*y(13)+24365*y(14)+29765*y(15)+6624*y(16)+4670*y(17)+26473*y(18)+5587*y(19)+24916*y(20)+26826*y(21)+7496*y(22)+12094*y(23)+22638*y(24))));
"RESULT K2+Lam section 1 dim", dim(A), "vdim", vdim(A), "s", rtimer-t0;
poly e=eliminate(A, product(maxideal(1))/t)[1]; list F=factorize(e); string fd=""; int j;
for (j=2;j<=size(F[1]);j++) { fd=fd+" "+string(deg(F[1][j]))+"^"+string(F[2][j]); }
"RESULT K2+Lam section 1 eliminant deg", deg(e), "factor degree^multiplicity", fd, "s", rtimer-t0;
quit;
