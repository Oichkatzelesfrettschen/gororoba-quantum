LIB "general.lib"; option(redSB); system("--ticks-per-sec",1); int t0=rtimer;
ring Y=32009,(y(1..24),t),dp; execute("ideal Q="+read("quotient.txt")+";");
ideal A=std(Q+ideal(2092*y(1)+20656*y(2)+25712*y(3)+18589*y(4)+4678*y(5)+25372*y(6)+17541*y(7)+19562*y(8)+20295*y(9)+8497*y(10)+27744*y(11)+13440*y(12)+18295*y(13)+12044*y(14)+18373*y(15)+26322*y(16)+29781*y(17)+19948*y(18)+17470*y(19)+29944*y(20)+19976*y(21)+30997*y(22)+26444*y(23)+25056*y(24),23664*y(1)+716*y(2)+8778*y(3)+14369*y(4)+12233*y(5)+27900*y(6)+10370*y(7)+14752*y(8)+19977*y(9)+16398*y(10)+10747*y(11)+15579*y(12)+23256*y(13)+202*y(14)+3455*y(15)+29683*y(16)+31563*y(17)+25527*y(18)+28873*y(19)+25141*y(20)+29182*y(21)+3719*y(22)+20878*y(23)+1833*y(24),16913*y(1)+2481*y(2)+5696*y(3)+13624*y(4)+10422*y(5)+17743*y(6)+27206*y(7)+23308*y(8)+10787*y(9)+31759*y(10)+20561*y(11)+2531*y(12)+623*y(13)+16845*y(14)+25426*y(15)+21144*y(16)+12266*y(17)+19215*y(18)+13919*y(19)+7965*y(20)+3738*y(21)+4268*y(22)+17288*y(23)+19909*y(24),20270*y(1)+16706*y(2)+6301*y(3)+4029*y(4)+25956*y(5)+30139*y(6)+15683*y(7)+14269*y(8)+10329*y(9)+19411*y(10)+2958*y(11)+8355*y(12)+1102*y(13)+12401*y(14)+20309*y(15)+25719*y(16)+10641*y(17)+16083*y(18)+29149*y(19)+24375*y(20)+922*y(21)+24836*y(22)+23866*y(23)+5620*y(24),28805*y(1)+23933*y(2)+17697*y(3)+31422*y(4)+2485*y(5)+29734*y(6)+6642*y(7)+18042*y(8)+1772*y(9)+10613*y(10)+27139*y(11)+7208*y(12)+1975*y(13)+30381*y(14)+16333*y(15)+23173*y(16)+27442*y(17)+27703*y(18)+30340*y(19)+21805*y(20)+21159*y(21)+3301*y(22)+10091*y(23)+2207*y(24))+ideal(3609*y(1)+9572*y(2)+13371*y(3)+24890*y(4)+30647*y(5)+2359*y(6)+3243*y(7)+8702*y(8)+6829*y(9)+30465*y(10)+9408*y(11)+22096*y(12)+20863*y(13)+9837*y(14)+809*y(15)+23982*y(16)+5751*y(17)+20748*y(18)+22418*y(19)+11414*y(20)+19238*y(21)+6474*y(22)+20338*y(23)+6495*y(24)-1)+ideal(t-(13340*y(1)+8306*y(2)+16242*y(3)+31285*y(4)+6555*y(5)+6920*y(6)+8354*y(7)+4480*y(8)+14474*y(9)+9828*y(10)+7384*y(11)+5764*y(12)+28659*y(13)+30239*y(14)+16053*y(15)+15372*y(16)+6868*y(17)+6449*y(18)+11169*y(19)+16596*y(20)+27853*y(21)+7728*y(22)+8871*y(23)+6140*y(24))));
"RESULT section 6 dim", dim(A), "vdim", vdim(A), "s", rtimer-t0;
poly e=eliminate(A, product(maxideal(1))/t)[1]; list F=factorize(e); string fd=""; int j;
for (j=2;j<=size(F[1]);j++) { fd=fd+" "+string(deg(F[1][j]))+"^"+string(F[2][j]); }
"RESULT section 6 eliminant deg", deg(e), "factor degree^multiplicity", fd, "s", rtimer-t0;
quit;
