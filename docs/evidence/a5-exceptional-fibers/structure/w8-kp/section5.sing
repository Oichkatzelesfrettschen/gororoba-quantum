LIB "general.lib"; option(redSB); system("--ticks-per-sec",1); int t0=rtimer;
ring Y=32009,(y(1..24),t),dp; execute("ideal Q="+read("quotient.txt")+";");
ideal A=std(Q+ideal(23524*y(1)+3982*y(2)+6855*y(3)+22706*y(4)+11690*y(5)+30474*y(6)+19835*y(7)+6655*y(8)+1201*y(9)+10269*y(10)+10378*y(11)+23663*y(12)+3338*y(13)+19773*y(14)+9644*y(15)+11888*y(16)+7401*y(17)+9376*y(18)+28777*y(19)+10318*y(20)+15467*y(21)+29530*y(22)+28664*y(23)+28450*y(24),31328*y(1)+23869*y(2)+5479*y(3)+19511*y(4)+29053*y(5)+15623*y(6)+20122*y(7)+12239*y(8)+15719*y(9)+26439*y(10)+21775*y(11)+8016*y(12)+15702*y(13)+18614*y(14)+12565*y(15)+1766*y(16)+25730*y(17)+28088*y(18)+8301*y(19)+16129*y(20)+24370*y(21)+12392*y(22)+30777*y(23)+22950*y(24),11414*y(1)+7498*y(2)+20544*y(3)+18973*y(4)+15132*y(5)+17071*y(6)+9745*y(7)+23004*y(8)+28040*y(9)+14929*y(10)+23637*y(11)+28532*y(12)+8188*y(13)+15458*y(14)+22767*y(15)+15036*y(16)+13042*y(17)+31204*y(18)+30318*y(19)+11902*y(20)+17314*y(21)+2541*y(22)+23004*y(23)+794*y(24),1456*y(1)+25720*y(2)+11440*y(3)+7512*y(4)+27001*y(5)+11699*y(6)+14873*y(7)+22484*y(8)+24210*y(9)+15203*y(10)+23340*y(11)+18472*y(12)+24519*y(13)+9994*y(14)+30495*y(15)+11604*y(16)+7290*y(17)+11388*y(18)+21895*y(19)+169*y(20)+18867*y(21)+22955*y(22)+16467*y(23)+27542*y(24),20608*y(1)+14347*y(2)+3787*y(3)+29872*y(4)+8689*y(5)+21038*y(6)+15969*y(7)+16057*y(8)+29885*y(9)+20323*y(10)+5175*y(11)+13842*y(12)+19785*y(13)+30166*y(14)+8784*y(15)+13507*y(16)+27023*y(17)+22592*y(18)+23243*y(19)+28571*y(20)+3918*y(21)+25459*y(22)+31910*y(23)+14939*y(24))+ideal(27460*y(1)+17057*y(2)+15750*y(3)+2771*y(4)+18768*y(5)+5452*y(6)+10756*y(7)+25501*y(8)+30003*y(9)+650*y(10)+31079*y(11)+22562*y(12)+11384*y(13)+8272*y(14)+17103*y(15)+2292*y(16)+1069*y(17)+6916*y(18)+15772*y(19)+13451*y(20)+27685*y(21)+28891*y(22)+16182*y(23)+27059*y(24)-1)+ideal(t-(30267*y(1)+14067*y(2)+26374*y(3)+9408*y(4)+29460*y(5)+24186*y(6)+19636*y(7)+2089*y(8)+22281*y(9)+15761*y(10)+29563*y(11)+13233*y(12)+16509*y(13)+20085*y(14)+5089*y(15)+1321*y(16)+21359*y(17)+5550*y(18)+3893*y(19)+7950*y(20)+17097*y(21)+16249*y(22)+8656*y(23)+2748*y(24))));
"RESULT section 5 dim", dim(A), "vdim", vdim(A), "s", rtimer-t0;
poly e=eliminate(A, product(maxideal(1))/t)[1]; list F=factorize(e); string fd=""; int j;
for (j=2;j<=size(F[1]);j++) { fd=fd+" "+string(deg(F[1][j]))+"^"+string(F[2][j]); }
"RESULT section 5 eliminant deg", deg(e), "factor degree^multiplicity", fd, "s", rtimer-t0;
quit;
