LIB "general.lib"; option(redSB); system("--ticks-per-sec",1); int t0=rtimer;
ring Y=32009,(y(1..24),t),dp; execute("ideal Q="+read("quotient.txt")+";");
ideal A=std(Q+ideal(11765*y(1)+10100*y(2)+28087*y(3)+30024*y(4)+30709*y(5)+23798*y(6)+29179*y(7)+21496*y(8)+22744*y(9)+28551*y(10)+14582*y(11)+21501*y(12)+17350*y(13)+16134*y(14)+8131*y(15)+23828*y(16)+22078*y(17)+1587*y(18)+2288*y(19)+19692*y(20)+22178*y(21)+1227*y(22)+27243*y(23)+11958*y(24),26375*y(1)+4550*y(2)+26895*y(3)+21799*y(4)+2458*y(5)+4343*y(6)+30393*y(7)+28668*y(8)+5785*y(9)+10025*y(10)+6942*y(11)+11160*y(12)+27203*y(13)+31171*y(14)+4366*y(15)+1130*y(16)+29150*y(17)+393*y(18)+26078*y(19)+15251*y(20)+7176*y(21)+28413*y(22)+2629*y(23)+25502*y(24),13199*y(1)+14004*y(2)+9031*y(3)+16510*y(4)+13215*y(5)+13302*y(6)+25653*y(7)+13472*y(8)+29331*y(9)+12141*y(10)+18862*y(11)+25360*y(12)+26080*y(13)+5877*y(14)+7527*y(15)+4484*y(16)+12981*y(17)+31846*y(18)+8090*y(19)+13636*y(20)+18081*y(21)+2318*y(22)+9491*y(23)+25698*y(24),178*y(1)+9938*y(2)+25111*y(3)+23912*y(4)+25024*y(5)+17153*y(6)+12273*y(7)+7978*y(8)+19255*y(9)+14214*y(10)+13952*y(11)+6150*y(12)+27501*y(13)+28751*y(14)+12551*y(15)+17125*y(16)+7677*y(17)+3856*y(18)+28439*y(19)+16768*y(20)+9015*y(21)+26620*y(22)+29171*y(23)+12742*y(24),13655*y(1)+12413*y(2)+3456*y(3)+16533*y(4)+22297*y(5)+12242*y(6)+2380*y(7)+8810*y(8)+25363*y(9)+4058*y(10)+11123*y(11)+20766*y(12)+20864*y(13)+23245*y(14)+11734*y(15)+20086*y(16)+29390*y(17)+18337*y(18)+20508*y(19)+28613*y(20)+7474*y(21)+14333*y(22)+14533*y(23)+2389*y(24))+ideal(27098*y(1)+65*y(2)+6244*y(3)+20653*y(4)+29489*y(5)+2030*y(6)+6873*y(7)+19393*y(8)+7262*y(9)+6507*y(10)+8465*y(11)+23488*y(12)+3658*y(13)+28891*y(14)+4737*y(15)+19082*y(16)+16126*y(17)+9737*y(18)+27272*y(19)+3356*y(20)+28524*y(21)+8186*y(22)+13722*y(23)+12552*y(24)-1)+ideal(t-(12910*y(1)+14814*y(2)+149*y(3)+27918*y(4)+28537*y(5)+14753*y(6)+16131*y(7)+9295*y(8)+6144*y(9)+19932*y(10)+10466*y(11)+31908*y(12)+8775*y(13)+24758*y(14)+673*y(15)+3744*y(16)+6105*y(17)+11709*y(18)+1263*y(19)+23272*y(20)+19342*y(21)+14803*y(22)+7008*y(23)+23008*y(24))));
"RESULT section 3 dim", dim(A), "vdim", vdim(A), "s", rtimer-t0;
poly e=eliminate(A, product(maxideal(1))/t)[1]; list F=factorize(e); string fd=""; int j;
for (j=2;j<=size(F[1]);j++) { fd=fd+" "+string(deg(F[1][j]))+"^"+string(F[2][j]); }
"RESULT section 3 eliminant deg", deg(e), "factor degree^multiplicity", fd, "s", rtimer-t0;
quit;
