LIB "general.lib"; option(redSB); system("--ticks-per-sec",1); int t0=rtimer;
ring Y=32009,(y(1..24),t),dp; execute("ideal Q="+read("quotient.txt")+";");
ideal A=std(Q+ideal(5501*y(1)+22967*y(2)+9147*y(3)+6194*y(4)+14033*y(5)+10452*y(6)+22183*y(7)+4476*y(8)+11799*y(9)+13791*y(10)+7793*y(11)+11103*y(12)+30285*y(13)+231*y(14)+26347*y(15)+27889*y(16)+14220*y(17)+10889*y(18)+20357*y(19)+20780*y(20)+11980*y(21)+14092*y(22)+562*y(23)+8018*y(24),24468*y(1)+21797*y(2)+20165*y(3)+29516*y(4)+25808*y(5)+11812*y(6)+29979*y(7)+9119*y(8)+3505*y(9)+13252*y(10)+13505*y(11)+10501*y(12)+29073*y(13)+21855*y(14)+31893*y(15)+29710*y(16)+8831*y(17)+11544*y(18)+15057*y(19)+6715*y(20)+29696*y(21)+6264*y(22)+8544*y(23)+629*y(24),18971*y(1)+7117*y(2)+27938*y(3)+4282*y(4)+15356*y(5)+9921*y(6)+31376*y(7)+26731*y(8)+3986*y(9)+3438*y(10)+22047*y(11)+15175*y(12)+8541*y(13)+18353*y(14)+26259*y(15)+18538*y(16)+14531*y(17)+10794*y(18)+31775*y(19)+17793*y(20)+1786*y(21)+22416*y(22)+5219*y(23)+27964*y(24),9857*y(1)+18520*y(2)+20777*y(3)+6774*y(4)+23412*y(5)+2639*y(6)+14518*y(7)+4693*y(8)+11573*y(9)+20301*y(10)+3479*y(11)+11125*y(12)+13479*y(13)+1464*y(14)+22132*y(15)+16094*y(16)+29544*y(17)+5732*y(18)+11778*y(19)+16372*y(20)+17307*y(21)+30039*y(22)+18099*y(23)+1667*y(24),27455*y(1)+28784*y(2)+25349*y(3)+17807*y(4)+4326*y(5)+27432*y(6)+27382*y(7)+4975*y(8)+15703*y(9)+4145*y(10)+18132*y(11)+30421*y(12)+17823*y(13)+34*y(14)+10885*y(15)+1435*y(16)+4878*y(17)+25118*y(18)+8538*y(19)+5966*y(20)+25603*y(21)+2665*y(22)+493*y(23)+11108*y(24))+ideal(23375*y(1)+20456*y(2)+4690*y(3)+31734*y(4)+30218*y(5)+18211*y(6)+29390*y(7)+20716*y(8)+10969*y(9)+20430*y(10)+19802*y(11)+14125*y(12)+10602*y(13)+21126*y(14)+11387*y(15)+739*y(16)+19437*y(17)+16689*y(18)+13639*y(19)+21692*y(20)+25743*y(21)+12689*y(22)+23337*y(23)+15721*y(24)-1)+ideal(t-(22956*y(1)+21232*y(2)+22475*y(3)+25686*y(4)+11675*y(5)+9582*y(6)+24255*y(7)+17568*y(8)+26545*y(9)+875*y(10)+20794*y(11)+17823*y(12)+14785*y(13)+16659*y(14)+28082*y(15)+13982*y(16)+9708*y(17)+9343*y(18)+19300*y(19)+19945*y(20)+28893*y(21)+25653*y(22)+12058*y(23)+3600*y(24))));
"RESULT section 4 dim", dim(A), "vdim", vdim(A), "s", rtimer-t0;
poly e=eliminate(A, product(maxideal(1))/t)[1]; list F=factorize(e); string fd=""; int j;
for (j=2;j<=size(F[1]);j++) { fd=fd+" "+string(deg(F[1][j]))+"^"+string(F[2][j]); }
"RESULT section 4 eliminant deg", deg(e), "factor degree^multiplicity", fd, "s", rtimer-t0;
quit;
