LIB "general.lib"; option(redSB); system("--ticks-per-sec",1); int t0=rtimer;
ring Y=32009,(y(1..24),t),dp; execute("ideal Q="+read("quotient.txt")+";");
ideal A=std(Q+ideal(29768*y(1)+30643*y(2)+18799*y(3)+22842*y(4)+9748*y(5)+31632*y(6)+8836*y(7)+10576*y(8)+20804*y(9)+29183*y(10)+28424*y(11)+21299*y(12)+4007*y(13)+9135*y(14)+14106*y(15)+22287*y(16)+4649*y(17)+18474*y(18)+5238*y(19)+13033*y(20)+19190*y(21)+13247*y(22)+10686*y(23)+23144*y(24),9715*y(1)+25427*y(2)+26626*y(3)+14219*y(4)+12110*y(5)+31126*y(6)+29494*y(7)+28767*y(8)+8324*y(9)+12940*y(10)+5956*y(11)+20079*y(12)+2673*y(13)+1613*y(14)+8954*y(15)+14734*y(16)+2832*y(17)+660*y(18)+140*y(19)+31021*y(20)+2011*y(21)+4724*y(22)+12380*y(23)+2772*y(24),28292*y(1)+27623*y(2)+24191*y(3)+23225*y(4)+6664*y(5)+30575*y(6)+4070*y(7)+16898*y(8)+22839*y(9)+28826*y(10)+21630*y(11)+3033*y(12)+25161*y(13)+3263*y(14)+14485*y(15)+23667*y(16)+17401*y(17)+29752*y(18)+17194*y(19)+23223*y(20)+21090*y(21)+30462*y(22)+15033*y(23)+14351*y(24),14444*y(1)+25071*y(2)+30541*y(3)+144*y(4)+7175*y(5)+21911*y(6)+13599*y(7)+31235*y(8)+11717*y(9)+27262*y(10)+565*y(11)+1415*y(12)+20433*y(13)+29308*y(14)+2263*y(15)+11988*y(16)+8590*y(17)+8039*y(18)+19912*y(19)+140*y(20)+26253*y(21)+26828*y(22)+23295*y(23)+23384*y(24),8267*y(1)+14608*y(2)+18570*y(3)+16296*y(4)+21732*y(5)+18026*y(6)+27260*y(7)+7017*y(8)+29615*y(9)+551*y(10)+7199*y(11)+21040*y(12)+916*y(13)+24607*y(14)+24631*y(15)+427*y(16)+19112*y(17)+17886*y(18)+1249*y(19)+5428*y(20)+3664*y(21)+2495*y(22)+5548*y(23)+2712*y(24))+ideal(3774*y(1)+11337*y(2)+4015*y(3)+10798*y(4)+6603*y(5)+28823*y(6)+2931*y(7)+21173*y(8)+15227*y(9)+30881*y(10)+17377*y(11)+25682*y(12)+31239*y(13)+29304*y(14)+4309*y(15)+11363*y(16)+24705*y(17)+21829*y(18)+27613*y(19)+11606*y(20)+30883*y(21)+6932*y(22)+29261*y(23)+26488*y(24)-1)+ideal(t-(23427*y(1)+31407*y(2)+26815*y(3)+27544*y(4)+8892*y(5)+19521*y(6)+24994*y(7)+3383*y(8)+28149*y(9)+23571*y(10)+11154*y(11)+14460*y(12)+27237*y(13)+3825*y(14)+20255*y(15)+2656*y(16)+21980*y(17)+8868*y(18)+2416*y(19)+9284*y(20)+5162*y(21)+30273*y(22)+4957*y(23)+10997*y(24))));
"RESULT section 2 dim", dim(A), "vdim", vdim(A), "s", rtimer-t0;
poly e=eliminate(A, product(maxideal(1))/t)[1]; list F=factorize(e); string fd=""; int j;
for (j=2;j<=size(F[1]);j++) { fd=fd+" "+string(deg(F[1][j]))+"^"+string(F[2][j]); }
"RESULT section 2 eliminant deg", deg(e), "factor degree^multiplicity", fd, "s", rtimer-t0;
quit;
