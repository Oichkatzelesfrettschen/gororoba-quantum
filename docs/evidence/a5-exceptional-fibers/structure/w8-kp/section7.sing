LIB "general.lib"; option(redSB); system("--ticks-per-sec",1); int t0=rtimer;
ring Y=32009,(y(1..24),t),dp; execute("ideal Q="+read("quotient.txt")+";");
ideal A=std(Q+ideal(27084*y(1)+23142*y(2)+17752*y(3)+8567*y(4)+17679*y(5)+19652*y(6)+24327*y(7)+25251*y(8)+2759*y(9)+24921*y(10)+13543*y(11)+23115*y(12)+4635*y(13)+9043*y(14)+16838*y(15)+17669*y(16)+25289*y(17)+20525*y(18)+27568*y(19)+7437*y(20)+19281*y(21)+8399*y(22)+2422*y(23)+11642*y(24),24223*y(1)+30035*y(2)+26889*y(3)+3093*y(4)+31269*y(5)+16222*y(6)+11994*y(7)+31947*y(8)+25189*y(9)+26568*y(10)+1623*y(11)+9158*y(12)+24612*y(13)+13554*y(14)+28018*y(15)+19921*y(16)+4093*y(17)+6185*y(18)+19488*y(19)+15152*y(20)+28769*y(21)+15937*y(22)+4222*y(23)+17492*y(24),11624*y(1)+23381*y(2)+23047*y(3)+6364*y(4)+2172*y(5)+22476*y(6)+22835*y(7)+4378*y(8)+28767*y(9)+26402*y(10)+22696*y(11)+17383*y(12)+1776*y(13)+21852*y(14)+31024*y(15)+6292*y(16)+13874*y(17)+7575*y(18)+5366*y(19)+20940*y(20)+3990*y(21)+4354*y(22)+12921*y(23)+23329*y(24),26230*y(1)+14796*y(2)+13607*y(3)+14206*y(4)+24884*y(5)+27408*y(6)+26379*y(7)+7980*y(8)+20060*y(9)+31339*y(10)+18559*y(11)+18514*y(12)+22747*y(13)+6644*y(14)+26315*y(15)+3397*y(16)+2685*y(17)+25381*y(18)+12674*y(19)+24435*y(20)+19571*y(21)+25382*y(22)+694*y(23)+7558*y(24),10231*y(1)+9535*y(2)+5259*y(3)+7163*y(4)+12803*y(5)+26326*y(6)+7780*y(7)+4446*y(8)+27956*y(9)+18733*y(10)+3801*y(11)+6000*y(12)+1166*y(13)+673*y(14)+15207*y(15)+21479*y(16)+7860*y(17)+20218*y(18)+3363*y(19)+11203*y(20)+23221*y(21)+105*y(22)+28964*y(23)+26315*y(24))+ideal(10726*y(1)+2569*y(2)+21267*y(3)+17579*y(4)+27201*y(5)+23453*y(6)+19608*y(7)+21021*y(8)+18117*y(9)+21304*y(10)+5242*y(11)+4146*y(12)+273*y(13)+4284*y(14)+3422*y(15)+7666*y(16)+20722*y(17)+29422*y(18)+17718*y(19)+1155*y(20)+806*y(21)+22096*y(22)+9302*y(23)+14428*y(24)-1)+ideal(t-(11341*y(1)+9905*y(2)+29928*y(3)+31125*y(4)+18545*y(5)+6501*y(6)+2758*y(7)+15004*y(8)+14204*y(9)+20654*y(10)+14552*y(11)+31671*y(12)+13097*y(13)+19409*y(14)+18529*y(15)+28793*y(16)+18177*y(17)+12726*y(18)+31655*y(19)+27383*y(20)+3585*y(21)+4111*y(22)+12382*y(23)+22079*y(24))));
"RESULT section 7 dim", dim(A), "vdim", vdim(A), "s", rtimer-t0;
poly e=eliminate(A, product(maxideal(1))/t)[1]; list F=factorize(e); string fd=""; int j;
for (j=2;j<=size(F[1]);j++) { fd=fd+" "+string(deg(F[1][j]))+"^"+string(F[2][j]); }
"RESULT section 7 eliminant deg", deg(e), "factor degree^multiplicity", fd, "s", rtimer-t0;
quit;
