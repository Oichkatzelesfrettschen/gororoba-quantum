LIB "general.lib"; option(redSB); system("--ticks-per-sec",1); int t0=rtimer;
ring Y=32009,(y(1..24),t),dp; execute("ideal Q="+read("quotient.txt")+";");
ideal A=std(Q+ideal(628*y(1)+24728*y(2)+23375*y(3)+22021*y(4)+30620*y(5)+22855*y(6)+11300*y(7)+17495*y(8)+16932*y(9)+31528*y(10)+21082*y(11)+16781*y(12)+16894*y(13)+20574*y(14)+11994*y(15)+7342*y(16)+17608*y(17)+18823*y(18)+2022*y(19)+28941*y(20)+12588*y(21)+6087*y(22)+23341*y(23)+30207*y(24),10345*y(1)+23818*y(2)+3477*y(3)+30194*y(4)+22995*y(5)+24499*y(6)+27414*y(7)+191*y(8)+13537*y(9)+8101*y(10)+26873*y(11)+3497*y(12)+25409*y(13)+29044*y(14)+28360*y(15)+21018*y(16)+22099*y(17)+31111*y(18)+30786*y(19)+11089*y(20)+20584*y(21)+17518*y(22)+10670*y(23)+8769*y(24),18548*y(1)+26305*y(2)+22688*y(3)+19558*y(4)+19571*y(5)+26925*y(6)+12175*y(7)+20925*y(8)+15084*y(9)+28940*y(10)+28617*y(11)+28061*y(12)+22340*y(13)+24327*y(14)+8729*y(15)+18211*y(16)+20336*y(17)+7099*y(18)+12715*y(19)+18819*y(20)+12546*y(21)+15947*y(22)+3315*y(23)+1903*y(24),2183*y(1)+16166*y(2)+29319*y(3)+7221*y(4)+1764*y(5)+4808*y(6)+23625*y(7)+6778*y(8)+7375*y(9)+1535*y(10)+2937*y(11)+23368*y(12)+646*y(13)+30993*y(14)+3218*y(15)+24854*y(16)+31066*y(17)+11423*y(18)+27716*y(19)+3249*y(20)+4157*y(21)+17397*y(22)+11377*y(23)+30208*y(24),4038*y(1)+31176*y(2)+2636*y(3)+21735*y(4)+25318*y(5)+17968*y(6)+7130*y(7)+14979*y(8)+6128*y(9)+22468*y(10)+13694*y(11)+26668*y(12)+21453*y(13)+19990*y(14)+1069*y(15)+19588*y(16)+17329*y(17)+3480*y(18)+11669*y(19)+17227*y(20)+958*y(21)+21339*y(22)+24729*y(23)+30382*y(24))+ideal(14145*y(1)+4589*y(2)+18907*y(3)+27083*y(4)+11466*y(5)+17909*y(6)+25898*y(7)+1342*y(8)+19010*y(9)+31754*y(10)+19802*y(11)+30173*y(12)+16606*y(13)+28364*y(14)+10769*y(15)+24087*y(16)+7399*y(17)+21496*y(18)+5127*y(19)+11330*y(20)+5940*y(21)+24853*y(22)+13175*y(23)+15946*y(24)-1)+ideal(t-(24538*y(1)+7799*y(2)+4078*y(3)+24341*y(4)+24541*y(5)+2772*y(6)+11766*y(7)+15048*y(8)+19593*y(9)+25231*y(10)+20488*y(11)+18671*y(12)+9369*y(13)+28298*y(14)+31260*y(15)+22362*y(16)+11530*y(17)+2413*y(18)+16410*y(19)+27751*y(20)+30193*y(21)+14028*y(22)+15824*y(23)+3785*y(24))));
"RESULT section 8 dim", dim(A), "vdim", vdim(A), "s", rtimer-t0;
poly e=eliminate(A, product(maxideal(1))/t)[1]; list F=factorize(e); string fd=""; int j;
for (j=2;j<=size(F[1]);j++) { fd=fd+" "+string(deg(F[1][j]))+"^"+string(F[2][j]); }
"RESULT section 8 eliminant deg", deg(e), "factor degree^multiplicity", fd, "s", rtimer-t0;
quit;
