LIB "general.lib"; option(redSB); system("--ticks-per-sec",1); int t0=rtimer;
ring Y=32009,(y(1..24),t),dp; execute("ideal Q="+read("quotient.txt")+";");
ideal A=std(Q+ideal(1316*y(1)+18885*y(2)+21025*y(3)+15800*y(4)+2032*y(5)+22794*y(6)+17301*y(7)+1891*y(8)+7371*y(9)+9873*y(10)+5748*y(11)+12897*y(12)+4927*y(13)+31944*y(14)+6812*y(15)+28009*y(16)+26890*y(17)+12886*y(18)+6973*y(19)+4970*y(20)+29216*y(21)+19642*y(22)+12372*y(23)+26833*y(24),23726*y(1)+23282*y(2)+521*y(3)+19328*y(4)+25742*y(5)+4312*y(6)+2389*y(7)+27451*y(8)+26700*y(9)+17537*y(10)+12457*y(11)+10993*y(12)+20104*y(13)+1778*y(14)+29833*y(15)+31078*y(16)+30708*y(17)+20162*y(18)+22072*y(19)+5453*y(20)+3700*y(21)+29386*y(22)+4568*y(23)+20657*y(24),20741*y(1)+871*y(2)+30239*y(3)+18081*y(4)+5618*y(5)+3430*y(6)+5412*y(7)+8525*y(8)+27537*y(9)+13814*y(10)+18652*y(11)+5610*y(12)+9419*y(13)+25652*y(14)+20879*y(15)+10980*y(16)+13310*y(17)+19155*y(18)+6889*y(19)+26629*y(20)+30461*y(21)+9113*y(22)+10918*y(23)+19696*y(24),7026*y(1)+29947*y(2)+10742*y(3)+2786*y(4)+8217*y(5)+493*y(6)+24226*y(7)+24757*y(8)+18607*y(9)+12486*y(10)+28445*y(11)+14542*y(12)+31848*y(13)+5981*y(14)+28517*y(15)+28514*y(16)+13548*y(17)+21199*y(18)+30390*y(19)+22412*y(20)+30396*y(21)+8253*y(22)+8939*y(23)+2828*y(24),18310*y(1)+26946*y(2)+2273*y(3)+29802*y(4)+14494*y(5)+3027*y(6)+29390*y(7)+28438*y(8)+23249*y(9)+15223*y(10)+12467*y(11)+5739*y(12)+14876*y(13)+23178*y(14)+18603*y(15)+12228*y(16)+9057*y(17)+5150*y(18)+7314*y(19)+31161*y(20)+3096*y(21)+1838*y(22)+29656*y(23)+19364*y(24))+ideal(17079*y(1)+15226*y(2)+29420*y(3)+13818*y(4)+25618*y(5)+1197*y(6)+9181*y(7)+9188*y(8)+2967*y(9)+7101*y(10)+3742*y(11)+27024*y(12)+22890*y(13)+25249*y(14)+5041*y(15)+23171*y(16)+5976*y(17)+6121*y(18)+3603*y(19)+29810*y(20)+19749*y(21)+19500*y(22)+30459*y(23)+23231*y(24)-1)+ideal(t-(29910*y(1)+17804*y(2)+15926*y(3)+3799*y(4)+8483*y(5)+6563*y(6)+16571*y(7)+20561*y(8)+13472*y(9)+438*y(10)+15823*y(11)+17749*y(12)+5165*y(13)+16627*y(14)+26561*y(15)+22775*y(16)+11238*y(17)+29905*y(18)+7775*y(19)+30527*y(20)+26178*y(21)+31820*y(22)+644*y(23)+2229*y(24))));
"RESULT section 1 dim", dim(A), "vdim", vdim(A), "s", rtimer-t0;
poly e=eliminate(A, product(maxideal(1))/t)[1]; list F=factorize(e); string fd=""; int j;
for (j=2;j<=size(F[1]);j++) { fd=fd+" "+string(deg(F[1][j]))+"^"+string(F[2][j]); }
"RESULT section 1 eliminant deg", deg(e), "factor degree^multiplicity", fd, "s", rtimer-t0;
quit;
