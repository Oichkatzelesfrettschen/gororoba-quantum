ring r=32009,(t1,t2,t3,t4,t5,t6,t7,t8),dp;
ideal J=t3^2-t4^2-t5^2+t6^2,t1^2-t2^2+t7^2-t8^2+4*t2+2*t8,t4*t5*t8-t3*t6*t8-t3*t5-t4*t5+t3*t6+t4*t6,t4^2*t8-t6^2*t8-t3*t4-t4^2-t5*t6+t6^2,t3*t4*t8-t5*t6*t8-t3*t4-t4^2-t5^2+t5*t6,t2*t4*t8+t1*t6*t8-t2*t4+t1*t5-t1*t6-2*t4*t8,t1*t4*t8+t2*t6*t8-t1*t3-t1*t4-t2*t6-2*t6*t8,t2*t3*t8+t1*t5*t8-t2*t3-t1*t5+t1*t6-2*t3*t8,t1*t3*t8+t2*t5*t8-t1*t3-t1*t4-t2*t5-2*t5*t8,t2*t3*t5+t1*t5^2-t2*t4*t6-t1*t6^2-2*t3*t5-2*t4*t5+2*t3*t6+2*t4*t6,t2*t4^2+t1*t3*t5+t2*t5^2+t1*t4*t6-2*t3*t4-2*t4^2-2*t5^2+2*t5*t6,t2*t3*t4+t1*t4*t5+t1*t3*t6+t2*t5*t6-2*t3*t4-2*t4^2-2*t5*t6+2*t6^2,t7^2*t8^2-t8^4-2*t7^2*t8+4*t8^3+t2^2-4*t2*t8,t6*t7^2*t8-t6*t8^3-t1*t2*t3-t2^2*t5+t5*t7^2-t6*t7^2-t5*t8^2+3*t6*t8^2+2*t1*t3+2*t1*t4+4*t2*t5-2*t2*t6+2*t5*t8+2*t6*t8,t5*t7^2*t8-t5*t8^3-t1*t2*t4-t2^2*t6-t5*t7^2+t6*t7^2+3*t5*t8^2-t6*t8^2+2*t1*t3+2*t1*t4-2*t2*t5+4*t2*t6+2*t5*t8+2*t6*t8,t4*t7^2*t8-t4*t8^3+t2^2*t3+t1*t2*t5-t3*t7^2-t4*t7^2+t3*t8^2+3*t4*t8^2-4*t2*t3-2*t2*t4-2*t1*t5+2*t1*t6-2*t3*t8+2*t4*t8,t3*t7^2*t8-t3*t8^3+t2^2*t4+t1*t2*t6-t3*t7^2-t4*t7^2+3*t3*t8^2+t4*t8^2-2*t2*t3-4*t2*t4+2*t1*t5-2*t1*t6+2*t3*t8-2*t4*t8;
system("--ticks-per-sec",1000); int t0=rtimer;
option(redSB); ideal sJ=std(J); "RESULT stdJ_ms",rtimer-t0,ncols(sJ); ideal s=std(sJ,maxideal(16));
"RESULT std_ms",rtimer-t0,"sb_size",ncols(s);
ideal B=kbase(s); "RESULT kbase_size",ncols(B);
short=0; write(":w vb-n16-incremental.kbase",B);
quit;
