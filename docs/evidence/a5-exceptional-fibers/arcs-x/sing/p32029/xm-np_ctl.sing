ring R=32029,(w,rho,sig,s1,u),dp;

number half=1/2;
poly m=1+w;
poly T9xp=-half*w^2*u;
poly T9=(-1)*T9xp;
poly T4=(m*rho+sig)*half; poly T5=(m*rho-sig)*half; poly T6=(m*sig+rho)*half; poly T7=(rho-m*sig)*half;
