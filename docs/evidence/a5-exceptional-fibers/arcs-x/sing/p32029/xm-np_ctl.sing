proc clear(poly g) {
  if (g==0) { return(g); }
  int N=deg(g,intvec(0,0,0,0,1)); int k; poly res=0;
  matrix C=coeffs(g,u);
  for (k=1;k<=nrows(C);k++) { res=res+C[k,1]*m^(N-(k-1)); }
  return(res);
}

