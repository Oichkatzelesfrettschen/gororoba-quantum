ring r=32009,(t2,t3,t4,t5,t6,t7),dp;
ideal J=t2^2+t4^2-t5^2-t6^2+t7^2;
option(redSB);
int t0=rtimer;
ideal s=std(J+maxideal(18));
short=0; write(":w ~/a5/exports/isonm-p32009-n18-v11/s.txt.part",s);
ideal B=kbase(s);
short=0; write(":w ~/a5/exports/isonm-p32009-n18-v11/qB.txt.part",B);
"RESULT std", ncols(s), ncols(B), rtimer-t0;
quit;
