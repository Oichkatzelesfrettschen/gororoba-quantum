2-4431*t2*t6^2*t7^2-13799*t2*t7^4+7850*t1*t2^3*t9+1012*t2^2*t4*t5*t9-13799*t4*t5^3*t9+12281*t2^2*t4*t7*t9-8862*t4*t5^2*t7*t9-4431*t2^2*t6*t7*t9-4431*t4*t5*t7^2*t9+8862*t4*t7^3*t9+13799*t6*t7^3*t9+10380*t2^3*t9^2-14811*t2*t5^2*t9^2+10886*t2*t5*t7*t9^2-9368*t2*t7^2*t9^2-11515*t1*t2*t9^3-4431*t4*t5*t9^3-4431*t6*t7*t9^3+8233*t2*t9^4+5443*t1*t2^3-9874*t2^2*t4*t5+13799*t4*t5^3-13799*t2^2*t5*t6+9368*t2^2*t4*t7-13799*t4*t5^2*t7+13293*t2^2*t6*t7-14305*t1*t2*t7^2+4431*t4*t5*t7^2+13799*t5*t6*t7^2-4431*t4*t7^3-13799*t6*t7^3-2024*t2^3*t9-7850*t2*t5^2*t9+3419*t2*t5*t7*t9+4431*t2*t7^2*t9-8233*t1*t2*t9^2+13293*t4*t5*t9^2+13293*t6*t7*t9^2+7467*t2*t9^3-3419*t2^3-14305*t2*t5^2-8862*t2*t5*t7-10886*t1*t2*t9-8862*t4*t5*t9-8862*t6*t7*t9-8862*t2*t9^2-14305*t2*t9,-13799*t1*t2^2*t9^5-13799*t2^2*t9^6+4431*t2^2*t5*t7*t9^3+4937*t1*t2^2*t9^4+4937*t2^2*t9^5+13799*t1^4*t2^2+13799*t1^2*t2^4-13799*t2^2*t5^2*t6^2-13799*t2^2*t6^4-4431*t1^3*t2*t4*t7-4431*t1*t2^3*t4*t7+4431*t1*t2*t4*t6^2*t7+13799*t2^2*t5^2*t7^2+9368*t2^2*t6^2*t7^2-4431*t1*t2*t4*t7^3+4431*t2^2*t7^4-13799*t1^3*t2^2*t9-13799*t1*t2^4*t9+4431*t2^3*t4*t7*t9+4431*t2*t4*t5^2*t7*t9-4431*t2*t4*t7^3*t9+13799*t2^4*t9^2-13293*t2^2*t5*t7*t9^2+4431*t2^2*t7^2*t9^2+8862*t5^2*t7^2*t9^2+12787*t1*t2^2*t9^3+8356*t2^2*t9^4+8862*t1*t9^5+8862*t9^6+4937*t1^3*t2^2+9368*t1*t2^4-13799*t2*t4*t5^3+13799*t1*t2^2*t4*t6+4431*t2*t4*t5*t6^2-13293*t1^2*t2*t4*t7-8862*t2^3*t4*t7-13799*t1*t2^2*t5*t7-4431*t2*t4*t5^2*t7+9368*t2*t5^2*t6*t7+4431*t2*t4*t6^2*t7-4431*t2*t6^3*t7-13799*t2*t4*t5*t7^2-13799*t2*t6*t7^3-9368*t1^2*t2^2*t9-9368*t2^4*t9+13293*t2^2*t5*t7*t9+8862*t5^3*t7*t9-8862*t2^2*t7^2*t9+14305*t5^2*t7^2*t9+8862*t5*t7^3*t9+5949*t1*t2^2*t9^2+13799*t2*t4*t5*t9^2+13799*t2*t6*t7*t9^2-8356*t2^2*t9^3-8862*t5*t7*t9^3-12281*t1*t9^4-12281*t9^5+5443*t1^2*t2^2+4937*t2^4+13799*t2^2*t5^2-13799*t5^4+13799*t2^2*t4*t6-4431*t2^2*t6^2-13799*t5^2*t6^2+14305*t1*t2*t4*t7+13799*t2^2*t5*t7-8862*t5^3*t7-4431*t4*t5*t6*t7-4937*t2^2*t7^2-506*t5^2*t7^2-13799*t6^2*t7^2-8862*t5*t7^3+3419*t1*t2^2*t9+4431*t2*t4*t5*t9+14305*t2*t4*t7*t9+4431*t2*t6*t7*t9-8862*t2^2*t9^2-4431*t5^2*t9^2-5443*t5*t7*t9^2-4431*t7^2*t9^2+15700*t1*t9^3+15700*t9^4-3419*t1*t2^2-8862*t2*t4*t5+8862*t2*t4*t7-8862*t2*t6*t7+3419*t2^2*t9+8862*t5^2*t9+5443*t5*t7*t9+8862*t7^2*t9+2024*t1*t9^2+2024*t9^3+5443*t2^2-4431*t5^2+8862*t5*t7-4431*t7^2-14305*t1*t9-14305*t9^2;
ring E=32029,(w,rho,sig,a,u),dp;
poly m=1+w; poly T9=-w^2*u/2; poly T1=a-T9; poly T2=a*w*(w+2)*u;
map phiE=r,T1,T2,(m*rho+sig)/2,(m*rho-sig)/2,(m*sig+rho)/2,(rho-m*sig)/2,1*T9;
"RESULT generators of J nonzero on Phi modulo u m = 1", size(simplify(reduce(phiE(J),std(ideal(u*m-1))),2)), "of", ncols(phiE(J));
setring r;
execute("ideal Grun="+read("docs/evidence/a5-exceptional-fibers/working/distribute/out/a5-p2-small/xm_p2/d2/gens.txt")+";");
intvec eps; int jj; for (jj=1;jj<=ncols(G);jj++) { if (Grun[jj]==G[jj]) { eps[jj]=1; } else { if (Grun[jj]==-G[jj]) { eps[jj]=-1; } else { ERROR("generator "+string(jj)+" is not +-G"); } } }
"RESULT signs of the run generators against the header", eps;
execute("ring Y=32029,(y(1..15)),dp;");
execute("ideal K="+read("docs/evidence/a5-exceptional-fibers/working/distribute/out/a5-p2-small/xm_p2/d2/relations-upto-d2.rel")+";");
"RESULT K2 generators", size(K);
ring S=32029,(s,W,R,Sg,A),dp;
intvec sw=1,0,0,0,0;
proc arc(int ew, int er, int ea) { poly w=W*s^ew; poly rho=R*s^er; poly sig=Sg*s^er; poly a=A*s^ea; poly u=1; poly pw=1; int i; for (i=1;i<=14;i++) { pw=jet(-pw*w,14,sw); u=u+pw; } poly m=1+w; poly T9=jet(-w^2*u/2,14,sw); poly T1=a-T9; poly T2=jet(a*w*(w+2)*u,14,sw); map phi=r,T1,T2,(m*rho+sig)/2,(m*rho-sig)/2,(m*sig+rho)/2,(rho-m*sig)/2,1*T9; return(jet(phi(G),14-2,sw)); }
proc lowest(ideal Gs) { int j; int k; for (k=0;k<=12;k++) { for (j=1;j<=ncols(Gs);j++) { if (jet(Gs[j],k,sw)!=0) { return(k); } } } return(-1); }
proc limit(ideal Gs, int nu) { ideal F; int j; for (j=1;j<=ncols(Gs);j++) { F[j]=subst(jet(Gs[j],nu,sw)-jet(Gs[j],nu-1,sw),s,1); } return(F); }
ideal Gs=arc(2,1,1); int nu=lowest(Gs); ideal F=limit(Gs,nu);
matrix M=concat(jacob(F),transpose(matrix(F)));
map p1=S,0,2,3,5,7; map p2=S,0,13,4,9,6;
"RESULT weights 2 1 1 nu", nu, "nonzero limit entries", size(simplify(F,2));
"RESULT rank of [dF | F] at two points", rank(p1(M)), rank(p2(M));
int j; ideal Fr; for (j=1;j<=ncols(F);j++) { Fr[j]=eps[j]*F[j]; } map back=Y,Fr;
"RESULT K2 nonzero on the limit", size(simplify(back(K),2));
quit;
