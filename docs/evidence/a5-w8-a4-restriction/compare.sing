// Comparison of the restricted W8 ideal J with a Pfaffian ideal P of the A_4 zero-divisor locus.
// The caller defines the ring r (characteristic 32009, global dp order), the ideals J and P and the integer stage.
// Every result line starts with RESULT. Stage 1: standard bases, dimensions, Hilbert series and containments.
// Stage 2: the radical of P against J. Stage 3: the ideal quotient P : J, its radical and the saturation of P by it.
// Stage 4: the primary decomposition of P. Stage 5: P against the isotropic quadric (y_0, Q), Q = y_1^2 + ... + y_15^2,
// and against its intersection with J.
LIB "primdec.lib";
LIB "elim.lib";
option(redSB);

proc report(string tag, ideal s)
{
  "RESULT " + tag + "_dim", dim(s);
  "RESULT " + tag + "_mult", mult(s);
  "RESULT " + tag + "_hilb1", string(hilb(s, 1));
  "RESULT " + tag + "_hilb2", string(hilb(s, 2));
}

proc same(ideal a, ideal b)
{
  // 1 when the ideals are equal, given as standard bases
  return(size(reduce(a, b)) == 0 and size(reduce(b, a)) == 0);
}

"RESULT stage", stage;
"RESULT generators_J", size(J);
"RESULT generators_P", size(P);
ideal sJ = std(J);
report("J", sJ);
"RESULT J_equals_radical_of_J", size(reduce(radical(J), sJ)) == 0;

if (stage == 1)
{
  "RESULT P_in_J", size(reduce(P, sJ)) == 0;
  ideal sP = std(P);
  report("P", sP);
  int i;
  for (i = 1; i <= size(J); i++)
  {
    "RESULT J_generator_" + string(i) + "_in_P", reduce(J[i], sP) == 0;
  }
  "RESULT J_in_P", size(reduce(J, sP)) == 0;
  "RESULT P_equals_J", same(sP, sJ);
  "RESULT hilbert_series_equal", string(hilb(sP, 1)) == string(hilb(sJ, 1));
}

if (stage == 2)
{
  ideal rP = radical(P);
  ideal sR = std(rP);
  report("radP", sR);
  "RESULT J_in_radP", size(reduce(J, sR)) == 0;
  "RESULT radP_in_J", size(reduce(rP, sJ)) == 0;
  "RESULT radicals_equal", same(sR, sJ);
}

if (stage == 3)
{
  ideal sP = std(P);
  "RESULT P_in_J", size(reduce(P, sJ)) == 0;
  ideal Qt = quotient(sP, J);
  ideal sQ = std(Qt);
  report("P_colon_J", sQ);
  ideal sQr = std(radical(Qt));
  report("rad_P_colon_J", sQr);
  "RESULT P_colon_J_contains_J", size(reduce(J, sQ)) == 0;
  list M = minAssGTZ(Qt);
  int m;
  for (m = 1; m <= size(M); m++)
  {
    ideal sm = std(M[m]);
    "RESULT minimal_prime_of_P_colon_J_" + string(m), "dim=" + string(dim(sm)) + " mult=" + string(mult(sm))
      + " contains_J=" + string(size(reduce(J, sm)) == 0);
    kill sm;
  }
  ideal Sat = std(sat(sP, Qt));
  "RESULT saturation_of_P_by_P_colon_J_equals_J", size(reduce(Sat, sJ)) == 0 and size(reduce(J, Sat)) == 0;
}

if (stage == 5)
{
  ideal sP = std(P);
  poly Qn = 0;
  int k;
  for (k = 1; k <= 15; k++)
  {
    Qn = Qn + var(k + 1)^2;
  }
  ideal G = y0, Qn;
  ideal sG = std(G);
  list MG = minAssGTZ(G);
  "RESULT y0_Q_prime", size(MG) == 1 and size(reduce(G, std(MG[1]))) == 0 and size(reduce(MG[1], sG)) == 0;
  report("y0_Q", sG);
  "RESULT P_in_y0_Q", size(reduce(P, sG)) == 0;
  "RESULT J_in_y0_Q", size(reduce(J, sG)) == 0;
  ideal sI = std(intersect(G, J));
  report("y0_Q_cap_J", sI);
  "RESULT P_in_y0_Q_cap_J", size(reduce(P, sI)) == 0;
  "RESULT y0_Q_cap_J_equals_P", size(reduce(sI, sP)) == 0;
  // rad(G J) = rad(G cap J), and G J is generated by y_0 J_i (in P) and Q J_i: V(P) lies in V(G) u V(J) when a power of
  // each Q J_i lies in P.
  int e, i;
  for (i = 1; i <= 3; i++)
  {
    for (e = 1; e <= 6; e++)
    {
      if (reduce((Qn * J[i])^e, sP) == 0)
      {
        "RESULT Q_times_J_generator_" + string(i) + "_power_in_P", e;
        break;
      }
    }
  }
}

if (stage == 4)
{
  list L = primdecGTZ(P);
  int d = dim(std(P));
  ideal U = 1;
  int k;
  for (k = 1; k <= size(L); k++)
  {
    ideal q = std(L[k][1]);
    ideal pr = std(L[k][2]);
    "RESULT component_" + string(k), "primary_dim=" + string(dim(q)) + " primary_mult=" + string(mult(q))
      + " prime_dim=" + string(dim(pr)) + " prime_mult=" + string(mult(pr))
      + " prime_equals_J=" + string(same(pr, sJ)) + " prime_contains_J=" + string(size(reduce(J, pr)) == 0);
    if (dim(q) == d)
    {
      U = intersect(U, q);
    }
    kill q, pr;
  }
  "RESULT components", size(L);
  ideal sU = std(U);
  report("unmixed", sU);
  "RESULT unmixed_equals_J", same(sU, sJ);
}
quit;
