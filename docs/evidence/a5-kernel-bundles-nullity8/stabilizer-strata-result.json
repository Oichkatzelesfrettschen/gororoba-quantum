  "classification_argument": {
    "phase_projection": "W8 has a nonzero complex bilinear square, E8-bar has nonzero mu, and each open X branch lies outside Iso, so a nonzero quadratic scalar kills the infinitesimal phase projection there. On Iso the Gram and four-form data are circle-fixed, while the third-exterior-power action fixes the associative three-form vector exactly when that vector vanishes.",
    "pointwise_g2": "the pointwise compact G_2 stabilizer is SU(2) for a real two-frame or an associative real three-frame, and is trivial for a nonassociative real three-frame or a real frame of rank at least four",
    "strata": {
      "E8bar": "SU(2) at associative rank three; trivial at rank four",
      "Iso": "U(1) where all four associative three-form values vanish; trivial otherwise",
      "W8": "SU(2) at rank two and associative rank three; trivial otherwise",
      "X+": "SU(2) at associative rank three; trivial at rank four",
      "X-": "SU(2) at associative rank three; trivial at rank four"
    }
  },
