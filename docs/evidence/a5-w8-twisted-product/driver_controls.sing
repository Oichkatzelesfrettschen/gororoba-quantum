// Mutation controls of the twisted-product identity at p = 32009; every result line starts with RESULT.
ring r = 32009, (y0, y1, y2, y3, y4, y5, y6, y7, y8, y9, y10, y11, y12, y13, y14, y15), dp;
< "ideal_J.sing";
ring R = 32009, (x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17, x18, x19, x20, x21, x22, x23, x24, x25, x26, x27, x28, x29, x30, x31), dp;
< "ideal_W8.sing";
< "ideal_W8_sign.sing";
< "ideal_W8_nopure.sing";
number c = 10754;
option(redSB);
ideal sW = std(W);
ideal sWsign = std(Wsign);
ideal sWnopure = std(Wnopure);
map Fz_unmutated = r, x0 + c*x16, x1 + c*x17, x2 + c*x18, x3 + c*x19, x4 + c*x20, x5 + c*x21, x6 + c*x22, x7 + c*x23, x8 + c*x24, x9 + c*x25, x10 + c*x26, x11 + c*x27, x12 + c*x28, x13 + c*x29, x14 + c*x30, x15 + c*x31;
map Fb_unmutated = r, x0 - c*x16, x1 - c*x17, x2 - c*x18, x3 - c*x19, x4 - c*x20, x5 - c*x21, x6 - c*x22, x7 - c*x23, x8 - c*x24, x9 - c*x25, x10 - c*x26, x11 - c*x27, x12 - c*x28, x13 - c*x29, x14 - c*x30, x15 - c*x31;
ideal T_unmutated = Fz_unmutated(J) + Fb_unmutated(J);
ideal sT_unmutated = std(T_unmutated);
"RESULT unmutated_W_in_T", size(reduce(W, sT_unmutated)) == 0;
"RESULT unmutated_T_in_W", size(reduce(T_unmutated, sW)) == 0;
"RESULT unmutated_reduced_bases_identical", string(sT_unmutated) == string(sW);
map Fz_one_sign_flipped = r, x0 + c*x16, x1 + c*x17, x2 + c*x18, x3 + c*x19, x4 + c*x20, x5 + c*x21, x6 + c*x22, x7 + c*x23, x8 + c*x24, x9 + c*x25, x10 + c*x26, x11 + c*x27, x12 + c*x28, x13 + c*x29, x14 + c*x30, x15 + c*x31;
map Fb_one_sign_flipped = r, x0 - c*x16, x1 - c*x17, x2 - c*x18, x3 + c*x19, x4 - c*x20, x5 - c*x21, x6 - c*x22, x7 - c*x23, x8 - c*x24, x9 - c*x25, x10 - c*x26, x11 - c*x27, x12 - c*x28, x13 - c*x29, x14 - c*x30, x15 - c*x31;
ideal T_one_sign_flipped = Fz_one_sign_flipped(J) + Fb_one_sign_flipped(J);
ideal sT_one_sign_flipped = std(T_one_sign_flipped);
"RESULT one_sign_flipped_W_in_T", size(reduce(W, sT_one_sign_flipped)) == 0;
"RESULT one_sign_flipped_T_in_W", size(reduce(T_one_sign_flipped, sW)) == 0;
"RESULT one_sign_flipped_reduced_bases_identical", string(sT_one_sign_flipped) == string(sW);
map Fz_all_signs_flipped_swaps_z_and_zprime = r, x0 - c*x16, x1 - c*x17, x2 - c*x18, x3 - c*x19, x4 - c*x20, x5 - c*x21, x6 - c*x22, x7 - c*x23, x8 - c*x24, x9 - c*x25, x10 - c*x26, x11 - c*x27, x12 - c*x28, x13 - c*x29, x14 - c*x30, x15 - c*x31;
map Fb_all_signs_flipped_swaps_z_and_zprime = r, x0 + c*x16, x1 + c*x17, x2 + c*x18, x3 + c*x19, x4 + c*x20, x5 + c*x21, x6 + c*x22, x7 + c*x23, x8 + c*x24, x9 + c*x25, x10 + c*x26, x11 + c*x27, x12 + c*x28, x13 + c*x29, x14 + c*x30, x15 + c*x31;
ideal T_all_signs_flipped_swaps_z_and_zprime = Fz_all_signs_flipped_swaps_z_and_zprime(J) + Fb_all_signs_flipped_swaps_z_and_zprime(J);
ideal sT_all_signs_flipped_swaps_z_and_zprime = std(T_all_signs_flipped_swaps_z_and_zprime);
"RESULT all_signs_flipped_swaps_z_and_zprime_W_in_T", size(reduce(W, sT_all_signs_flipped_swaps_z_and_zprime)) == 0;
"RESULT all_signs_flipped_swaps_z_and_zprime_T_in_W", size(reduce(T_all_signs_flipped_swaps_z_and_zprime, sW)) == 0;
"RESULT all_signs_flipped_swaps_z_and_zprime_reduced_bases_identical", string(sT_all_signs_flipped_swaps_z_and_zprime) == string(sW);
map Fz_W8_with_U_plus_V = r, x0 + c*x16, x1 + c*x17, x2 + c*x18, x3 + c*x19, x4 + c*x20, x5 + c*x21, x6 + c*x22, x7 + c*x23, x8 + c*x24, x9 + c*x25, x10 + c*x26, x11 + c*x27, x12 + c*x28, x13 + c*x29, x14 + c*x30, x15 + c*x31;
map Fb_W8_with_U_plus_V = r, x0 - c*x16, x1 - c*x17, x2 - c*x18, x3 - c*x19, x4 - c*x20, x5 - c*x21, x6 - c*x22, x7 - c*x23, x8 - c*x24, x9 - c*x25, x10 - c*x26, x11 - c*x27, x12 - c*x28, x13 - c*x29, x14 - c*x30, x15 - c*x31;
ideal T_W8_with_U_plus_V = Fz_W8_with_U_plus_V(J) + Fb_W8_with_U_plus_V(J);
ideal sT_W8_with_U_plus_V = std(T_W8_with_U_plus_V);
"RESULT W8_with_U_plus_V_W_in_T", size(reduce(Wsign, sT_W8_with_U_plus_V)) == 0;
"RESULT W8_with_U_plus_V_T_in_W", size(reduce(T_W8_with_U_plus_V, sWsign)) == 0;
"RESULT W8_with_U_plus_V_reduced_bases_identical", string(sT_W8_with_U_plus_V) == string(sWsign);
map Fz_W8_without_x0_x16 = r, x0 + c*x16, x1 + c*x17, x2 + c*x18, x3 + c*x19, x4 + c*x20, x5 + c*x21, x6 + c*x22, x7 + c*x23, x8 + c*x24, x9 + c*x25, x10 + c*x26, x11 + c*x27, x12 + c*x28, x13 + c*x29, x14 + c*x30, x15 + c*x31;
map Fb_W8_without_x0_x16 = r, x0 - c*x16, x1 - c*x17, x2 - c*x18, x3 - c*x19, x4 - c*x20, x5 - c*x21, x6 - c*x22, x7 - c*x23, x8 - c*x24, x9 - c*x25, x10 - c*x26, x11 - c*x27, x12 - c*x28, x13 - c*x29, x14 - c*x30, x15 - c*x31;
ideal T_W8_without_x0_x16 = Fz_W8_without_x0_x16(J) + Fb_W8_without_x0_x16(J);
ideal sT_W8_without_x0_x16 = std(T_W8_without_x0_x16);
"RESULT W8_without_x0_x16_W_in_T", size(reduce(Wnopure, sT_W8_without_x0_x16)) == 0;
"RESULT W8_without_x0_x16_T_in_W", size(reduce(T_W8_without_x0_x16, sWnopure)) == 0;
"RESULT W8_without_x0_x16_reduced_bases_identical", string(sT_W8_without_x0_x16) == string(sWnopure);
quit;
