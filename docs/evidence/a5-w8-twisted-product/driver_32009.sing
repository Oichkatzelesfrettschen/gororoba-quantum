// W8 = J(z) + J(z') over F_32009; every result line starts with RESULT.
ring r = 32009, (y0, y1, y2, y3, y4, y5, y6, y7, y8, y9, y10, y11, y12, y13, y14, y15), dp;
< "ideal_J.sing";
ring R = 32009, (x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17, x18, x19, x20, x21, x22, x23, x24, x25, x26, x27, x28, x29, x30, x31), dp;
< "ideal_W8.sing";
number c = 10754;
option(redSB);
"RESULT c_squared_is_minus_one", c*c + 1 == 0;
"RESULT generators_W8", size(W);
ideal sW = std(W);
"RESULT W8_dim", dim(sW);
"RESULT W8_mult", mult(sW);
"RESULT W8_hilb1", string(hilb(sW, 1));
"RESULT W8_hilb2", string(hilb(sW, 2));
map Fz_twisted = r, x0 + c*x16, x1 + c*x17, x2 + c*x18, x3 + c*x19, x4 + c*x20, x5 + c*x21, x6 + c*x22, x7 + c*x23, x8 + c*x24, x9 + c*x25, x10 + c*x26, x11 + c*x27, x12 + c*x28, x13 + c*x29, x14 + c*x30, x15 + c*x31;
map Fb_twisted = r, x0 - c*x16, x1 - c*x17, x2 - c*x18, x3 - c*x19, x4 - c*x20, x5 - c*x21, x6 - c*x22, x7 - c*x23, x8 - c*x24, x9 - c*x25, x10 - c*x26, x11 - c*x27, x12 - c*x28, x13 - c*x29, x14 - c*x30, x15 - c*x31;
ideal T_twisted = Fz_twisted(J) + Fb_twisted(J);
ideal sT_twisted = std(T_twisted);
"RESULT twisted_W_in_T", size(reduce(W, sT_twisted)) == 0;
"RESULT twisted_T_in_W", size(reduce(T_twisted, sW)) == 0;
"RESULT twisted_reduced_bases_identical", string(sT_twisted) == string(sW);
"RESULT twisted_dim", dim(sT_twisted);
"RESULT twisted_mult", mult(sT_twisted);
"RESULT twisted_hilb1", string(hilb(sT_twisted, 1));
"RESULT twisted_hilb2", string(hilb(sT_twisted, 2));
ideal S = x16, x17, x18, x19, x20, x21, x22, x23, x24, x25, x26, x27, x28, x29, x30, x31;
map F0 = r, x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15;
ideal JS = F0(J) + S;
ideal sJS = std(JS);
ideal sWS = std(W + S);
ideal sZS = std(Fz_twisted(J) + S);
ideal sBS = std(Fb_twisted(J) + S);
"RESULT slice_W8_plus_S_in_JS", size(reduce(W + S, sJS)) == 0;
"RESULT slice_JS_in_W8_plus_S", size(reduce(JS, sWS)) == 0;
"RESULT slice_reduced_bases_identical", string(sWS) == string(sJS);
"RESULT slice_Jz_equals_JS", string(sZS) == string(sJS);
"RESULT slice_Jzp_equals_JS", string(sBS) == string(sJS);
"RESULT slice_dim", dim(sWS);
"RESULT slice_mult", mult(sWS);
"RESULT slice_hilb1", string(hilb(sWS, 1));
"RESULT slice_hilb2", string(hilb(sWS, 2));
quit;
