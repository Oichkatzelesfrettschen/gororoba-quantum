// W8 over F_32003 (no i): Hilbert data only; every result line starts with RESULT.
ring R = 32003, (x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17, x18, x19, x20, x21, x22, x23, x24, x25, x26, x27, x28, x29, x30, x31), dp;
< "ideal_W8.sing";
option(redSB);
ideal sW = std(W);
"RESULT generators_W8", size(W);
"RESULT W8_dim", dim(sW);
"RESULT W8_mult", mult(sW);
"RESULT W8_hilb1", string(hilb(sW, 1));
"RESULT W8_hilb2", string(hilb(sW, 2));
quit;
