+			if(CUDA_VERSION_MAJOR VERSION_GREATER_EQUAL 13)
+				# CUDA 13 pip wheels install every toolkit library into
+				# nvidia/cu13/lib; cuSOLVER 12 and cuSPARSE 12 keep soname major 12.
+				# Every library the cuQuantum libraries reach is a direct
+				# dependency: the loader maps the module's DT_NEEDED entries
+				# breadth-first through its DT_RPATH, so a dependency's RUNPATH
+				# search finds the soname loaded and LD_LIBRARY_PATH cannot
+				# substitute another copy.
+				set(AER_PIP_CUDA_LIB_DIRS nvidia/cu${CUDA_VERSION_MAJOR}/lib)
+				set(AER_PIP_PRELOAD_SONAMES libcusolver.so.12 libcusparse.so.12
+					libcublas.so.13 libcublasLt.so.13 libnvJitLink.so.13 libcutensor.so.2)
+			else()
+				set(AER_PIP_CUDA_LIB_DIRS nvidia/cublas/lib nvidia/cusolver/lib nvidia/cusparse/lib nvidia/cuda_runtime/lib)
+				set(AER_PIP_PRELOAD_SONAMES libcusolver.so.11 libcusparse.so.${CUDA_VERSION_MAJOR})
+			endif()
+			# CMake escapes $ORIGIN for the active generator in INSTALL_RPATH;
+			# a literal $ORIGIN inside link flags reaches Ninja or Make as a
+			# variable reference and expands to an empty string.
+			set(CMAKE_BUILD_WITH_INSTALL_RPATH ON)
+			foreach(AER_PIP_LIB_DIR ${AER_PIP_CUDA_LIB_DIRS} cutensor/lib cuquantum/lib)
+				list(APPEND CMAKE_INSTALL_RPATH "$ORIGIN/../../${AER_PIP_LIB_DIR}")
+				set(THRUST_DEPENDANT_LIBS "${THRUST_DEPENDANT_LIBS} -L${PYTHON_SITE_PATH}/${AER_PIP_LIB_DIR}")
+			endforeach()
+			foreach(AER_PIP_SONAME ${AER_PIP_PRELOAD_SONAMES})
+				set(THRUST_DEPENDANT_LIBS "${THRUST_DEPENDANT_LIBS} -Wl,--no-as-needed,-l:${AER_PIP_SONAME}")
+			endforeach()
 			set(THRUST_DEPENDANT_LIBS "${THRUST_DEPENDANT_LIBS} -Wl,--no-as-needed,-l:libcustatevec.so.1")
 			set(THRUST_DEPENDANT_LIBS "${THRUST_DEPENDANT_LIBS} -Wl,--no-as-needed,-l:libcutensornet.so.2")
 
